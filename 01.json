// ==================== 數據加載和顯示 ====================
function loadAndDisplay(retryCount = 0) {
    console.log(`📥 開始加載MVU數據... (嘗試 ${retryCount + 1})`);
    
    try {
        const mvuAvailable = typeof Mvu !== 'undefined' ||
                            typeof window.Mvu !== 'undefined' ||
                            (window.parent && typeof window.parent.Mvu !== 'undefined');
        
        if (!mvuAvailable) {
            console.warn(`⚠️ MVU框架未加載，嘗試次數: ${retryCount + 1}`);
            
            if (retryCount < 3) {
                $('#status-top').html(`
                    ${getHamsterLoadingHTML(`等待MVU框架加載中... (${retryCount + 1}/3)`)}
                    <div style="margin-top: 15px;">
                        <button onclick="diagnoseMvuAvailability()" style="padding: 8px 16px; background: rgba(96, 165, 250, 0.2); border: 1px solid #60a5fa; border-radius: 5px; color: #60a5fa; cursor: pointer;">
                            🔍 診斷MVU狀態
                        </button>
                    </div>
                `).removeClass('hidden');
                setTimeout(() => {
                    loadAndDisplay(retryCount + 1);
                }, 2000);
                return;
            } else {
                $('#status-top').html(`
                    <div class="status-message-box" style="color: #fbbf24;">
                        <p>⚠️ MVU框架未加載</p>
                        <p style="font-size: 12px; margin-top: 10px;">請先在聊天框運行相關初始化指令</p>
                        <div style="margin-top: 15px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
                            <button onclick="diagnoseMvuAvailability()" style="padding: 8px 16px; background: rgba(96, 165, 250, 0.2); border: 1px solid #60a5fa; border-radius: 5px; color: #60a5fa; cursor: pointer;">
                                🔍 診斷
                            </button>
                            <button onclick="loadAndDisplay(0)" style="padding: 8px 16px; background: rgba(96, 165, 250, 0.2); border: 1px solid #60a5fa; border-radius: 5px; color: #60a5fa; cursor: pointer;">
                                🔄 重試
                            </button>
                        </div>
                    </div>
                `).removeClass('hidden');
                console.error('❌ MVU框架加載超時');
                diagnoseMvuAvailability();
                return;
            }
        }
        
        if (typeof Mvu === 'undefined' && window.parent && typeof window.parent.Mvu !== 'undefined') {
            window.Mvu = window.parent.Mvu;
            console.log('✅ 已從父窗口引用MVU');
        }
        
        console.log('✅ MVU框架已就緒');
        
        let targetMessageId = 'latest';
        if (typeof getLastMessageId === 'function' && typeof getChatMessages === 'function') {
            let currentId = getLastMessageId();
            
            while (currentId >= 0) {
                const message = getChatMessages(currentId).at(-1);
                if (message && message.role !== 'user') {
                    targetMessageId = currentId;
                    if (currentId !== getLastMessageId()) {
                        console.log(`📝 向上查找到第 ${currentId} 層的AI消息`);
                    }
                    break;
                }
                currentId--;
            }
            
            if (currentId < 0) {
                targetMessageId = 'latest';
                console.warn('⚠️ 沒有找到AI消息，使用最後一層');
            }
        }
        
        const data = Mvu.getMvuData({ type: 'message', message_id: targetMessageId });
        
        if (!data || !data.stat_data) {
            console.warn('⚠️ MVU數據爲空，嘗試自動修復...');
            
            if (retryCount === 0) {
                console.log('🔧 自動觸發變量重新處理...');
                $('#status-top').html(`
                    ${getHamsterLoadingHTML('正在重新處理變量...')}
                    <p style="font-size: 12px; color: #9ca3af; text-align: center; margin-top: 10px;">首次加載時變量可能未處理完成</p>
                `).removeClass('hidden');
                
                reprocessCurrentMessageVariables().then(() => {
                    setTimeout(() => {
                        loadAndDisplay(1);
                    }, 800);
                }).catch(err => {
                    console.error('❌ 自動重新處理變量失敗:', err);
                    setTimeout(() => {
                        loadAndDisplay(2);
                    }, 500);
                });
                
                return;
            }
            
            console.warn('⚠️ 自動修復後仍無法加載數據');
            $('#status-top').html(`
                <div class="status-message-box" style="color: #fbbf24;">
                    <p style="margin-bottom: 10px;">⚠️ 無法加載數據</p>
                    <p style="font-size: 12px; margin-bottom: 15px;">可能需要先發送消息生成數據</p>
                    <div style="margin-top: 15px; display: flex; gap: 10px; justify-content: center;">
                        <button onclick="loadAndDisplay(0)" style="padding: 8px 16px; background: rgba(96, 165, 250, 0.2); border: 1px solid #60a5fa; border-radius: 5px; color: #60a5fa; cursor: pointer;">
                            🔄 重試加載
                        </button>
                        <button onclick="diagnoseMvuAvailability()" style="padding: 8px 16px; background: rgba(96, 165, 250, 0.2); border: 1px solid #60a5fa; border-radius: 5px; color: #60a5fa; cursor: pointer;">
                            🔍 診斷
                        </button>
                    </div>
                </div>
            `).removeClass('hidden');
            
            if ($('#character-content').children().length === 0) {
                $('#character-content').html('');
            }
            
            return;
        }
        
        const statData = data.stat_data;
        console.log('📊 stat_data字段:', Object.keys(statData));
        
        let bondsData = {};
        let dataSource = '';
        
        if (statData['人物羈絆']) {
            bondsData = statData['人物羈絆'];
            dataSource = '人物羈絆';
            console.log('✅ 找到"人物羈絆"字段');
        }
        else if (isCharacterData(statData)) {
            bondsData = { '當前角色': statData };
            dataSource = 'stat_data直接數據';
            console.log('✅ stat_data本身就是角色數據');
        }
        else {
            const possibleCharacters = {};
            for (const key of Object.keys(statData)) {
                if (key !== '$meta' && typeof statData[key] === 'object' && isCharacterData(statData[key])) {
                    possibleCharacters[key] = statData[key];
                }
            }
            
            if (Object.keys(possibleCharacters).length > 0) {
                bondsData = possibleCharacters;
                dataSource = '自動識別角色字段';
                console.log(`✅ 自動識別到 ${Object.keys(possibleCharacters).length} 個角色字段`);
            }
        }
        
        if (!bondsData || Object.keys(bondsData).length === 0) {
            console.warn('⚠️ 未找到角色數據');
            $('#status-top').removeClass('hidden').html(`
                <div class="status-message-box" style="color: #fbbf24;">
                    <p style="margin-bottom: 10px;">⚠️ 未找到角色數據</p>
                    <div style="margin-top: 10px;">
                        <button onclick="loadAndDisplay(0)" style="padding: 8px 16px; background: rgba(96, 165, 250, 0.2); border: 1px solid #60a5fa; border-radius: 5px; color: #60a5fa; cursor: pointer;">
                            🔄 重試加載
                        </button>
                    </div>
                </div>
            `);
            
            if ($('#character-content').children().length === 0) {
                $('#character-content').html('');
            }
            return;
        }
        
        const characters = Object.keys(bondsData).filter(k => k !== '$meta');
        
        if (characters.length === 0) {
            console.log('📝 沒有角色數據');
            $('#status-top').removeClass('hidden').html(`
                <div class="status-message-box" style="color: #fbbf24;">
                    <p style="margin-bottom: 10px;">⚠️ 暫無角色數據</p>
                    <div style="margin-top: 10px;">
                        <button onclick="loadAndDisplay(0)" style="padding: 8px 16px; background: rgba(96, 165, 250, 0.2); border: 1px solid #60a5fa; border-radius: 5px; color: #60a5fa; cursor: pointer;">
                            🔄 重試加載
                        </button>
                    </div>
                </div>
            `);
            
            if ($('#character-content').children().length === 0) {
                $('#character-content').html('');
            }
            return;
        }
        
        console.log(`✅ 找到 ${characters.length} 個角色 (來源: ${dataSource})`);
        
        const savedStates = saveCardStates();
        
        $('#status-top').addClass('hidden');
        
        const cardsHtml = characters.map(charKey => {
            const beauty = bondsData[charKey];
            return generateCharacterCard(charKey, beauty);
        }).join('');
        
        const gridHtml = `<div class="cards-grid">${cardsHtml}</div>`;
        
        $('#character-content').html(gridHtml);
        
        initializeCardStyles();
        setupEventDelegation();
        
        setTimeout(() => {
            const statesToRestore = Object.keys(savedStates).length > 0 ? savedStates : loadCardStates();
            restoreCardStates(statesToRestore);
        }, 100);
        
        setTimeout(() => {
            const $container = window.top ? $(window.top.document).find('#character-status') : $('#character-status');
            const container = $container[0];
            
            if (container && container.dataset.dragInitialized !== 'true') {
                initializeDragFeature();
                container.dataset.dragInitialized = 'true';
                console.log('✅ 拖拽功能已啓用');
            }
        }, 300);
        
        console.log('✅ 數據顯示完成');
        
    } catch (error) {
        console.error('❌ loadAndDisplay 執行出錯:', error);
        console.error('錯誤堆棧:', error.stack);
        
        $('#status-top').html(`
            <div class="status-message-box" style="color: #ef4444;">
                <p style="margin-bottom: 10px;">❌ 加載數據時發生錯誤</p>
                <p style="font-size: 12px; margin-bottom: 10px; color: #9ca3af;">${error.message}</p>
                <button onclick="loadAndDisplay(0)" style="padding: 8px 16px; background: rgba(96, 165, 250, 0.2); border: 1px solid #60a5fa; border-radius: 5px; color: #60a5fa; cursor: pointer;">
                    🔄 重試
                </button>
            </div>
        `).removeClass('hidden');
    }
}

// ==================== 卡片翻轉功能 ====================
function flipCharacterCard(cardId) {
    const card = $(`#${cardId} .character-card-3d`);
    card.toggleClass('flipped');
}

// ==================== 設置事件委託 ====================
function setupEventDelegation() {
    const $container = window.top ? $(window.top.document).find('#character-status') : $('#character-status');
    
    $container.off('click');
    
    $container.on('click', '[data-action]', async function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const $btn = $(this);
        const action = $btn.data('action');
        
        console.log('🔔 按鈕被點擊:', action);
        
        if ($btn.prop('disabled')) {
            console.warn('⚠️ 按鈕已禁用，忽略點擊');
            return;
        }
    
        try {
            switch(action) {
                case 'toggle-style':
                    console.log('🎨 切換樣式...');
                    toggleCardStyle();
                    break;
                    
                case 'refresh':
                    console.log('🔄 開始刷新數據...');
                    $btn.addClass('refreshing').prop('disabled', true);
        
                    try {
                        console.log('🔧 觸發重新處理變量...');
                        await reprocessCurrentMessageVariables();
            
                        console.log('⏳ 等待變量處理完成...');
                        await new Promise(resolve => setTimeout(resolve, 500));
            
                        console.log('🔄 刷新顯示數據...');
                        loadAndDisplay();
            
                        console.log('✅ 刷新完成');
                    } finally {
                        setTimeout(() => {
                            $btn.removeClass('refreshing').prop('disabled', false);
                        }, 500);
                    }
                    break;
                    
                case 'flip-card':
                    const cardId = $btn.data('card-id');
                    if (cardId) {
                        console.log('🔄 翻轉卡片:', cardId);
                        flipCharacterCard(cardId);
                        setTimeout(() => saveCardStates(), 50);
                    } else {
                        console.error('❌ 未找到卡片ID');
                    }
                    break;
                
                case 'toggle-collapse':
                    const collapseCardId = $btn.data('card-id');
                    if (collapseCardId) {
                        console.log('📌 切換收起狀態:', collapseCardId);
                        const $cardWrapper = $(`#${collapseCardId}`);
                        $cardWrapper.toggleClass('collapsed');
                        
                        const isCollapsed = $cardWrapper.hasClass('collapsed');
                        $btn.html(isCollapsed ? ICONS.pinFilled : ICONS.pin);
                        $btn.attr('title', isCollapsed ? '展開' : '收起');
                        
                        saveCardStates();
                    } else {
                        console.error('❌ 未找到卡片ID');
                    }
                    break;
                
                case 'force-desire':
                    console.log('🔥 執行強制發情指令...');
                    $btn.prop('disabled', true);
                    try {
                        await sendForceInstruction('desire');
                    } finally {
                        setTimeout(() => {
                            $btn.prop('disabled', false);
                        }, 2000);
                    }
                    break;
                
                case 'force-crush':
                    console.log('💕 執行強制暗戀指令...');
                    $btn.prop('disabled', true);
                    try {
                        await sendForceInstruction('crush');
                    } finally {
                        setTimeout(() => {
                            $btn.prop('disabled', false);
                        }, 2000);
                    }
                    break;
                    
                default:
                    console.warn('⚠️ 未知的操作:', action);
            }
        } catch (error) {
            console.error('❌ 操作失敗:', error);
            if (typeof toastr !== 'undefined') {
                toastr.error('操作失敗：' + error.message);
            }
        }
    });
    
    console.log('✅ 事件委託已設置');
}

// ==================== 初始化函數 ====================
function initializeCharacterStatus() {
    console.log('🚀 開始啓動人物羈絆卡片狀態欄');
    
    try {
        if (window.top && window.top.document !== document) {
            $(window.top.document).find('#character-status').remove();
            $(window.top.document).find('#character-status-styles').remove();
        }
        $('#character-status').remove();
        $('#character-status-styles').remove();
        
        $('head').append(styles);
        console.log('✅ 樣式已注入');
    
        const container = $('<div>', {
            id: 'character-status',
            class: 'character-container'
        });
        
        const statusTop = $('<div>', {
            id: 'status-top',
            class: 'status-top',
            html: getHamsterLoadingHTML('正在加載數據...')
        });
        
        const globalControls = $('<div>', {
            id: 'global-controls',
            class: 'global-controls',
            html: `
                <button class="global-control-btn global-force-desire-btn" data-action="force-desire" title="強制在場所有女角色發情">
                    <span>強制發情</span>
                </button>
                <button class="global-control-btn global-force-crush-btn" data-action="force-crush" title="強制在場所有女角色暗戀{{user}}">
                    <span>強制暗戀</span>
                </button>
            `
        });
        
        const contentArea = $('<div>', {
            id: 'character-content',
            class: 'character-content'
        });
        
        container.append(statusTop, contentArea, globalControls);
        $('body').prepend(container);
        console.log('✅ 容器已創建');
        
        setTimeout(() => {
            loadAndDisplay();
        }, 2000);
        
        console.log('🎉 人物羈絆卡片狀態欄初始化完成！');
        
    } catch (error) {
        console.error('❌ 初始化狀態欄時出錯:', error);
        console.error('錯誤堆棧:', error.stack);
        
        if (typeof toastr !== 'undefined') {
            toastr.error('狀態欄初始化失敗：' + error.message);
        } else {
            alert('狀態欄初始化失敗：' + error.message + '\n\n詳情請查看控制檯');
        }
    }
}

// ==================== 清理函數 ====================
function cleanupCharacterStatus() {
    console.log('🧹 清理人物羈絆狀態欄...');
    cleanupDragFeature();
    
    if (window.top && window.top.document !== document) {
        $(window.top.document).find('#character-status').remove();
        $(window.top.document).find('#character-status-styles').remove();
    }
    $('#character-status').remove();
    $('#character-status-styles').remove();
    console.log('✅ 狀態欄已清理');
}

// ==================== 事件監聽和腳本啓動 ====================
function handleCharacterMessageReceived() {
    console.log('📨 收到 MESSAGE_RECEIVED 事件，刷新狀態欄數據...');
    setTimeout(() => {
        try {
            const $container = window.top ? $(window.top.document).find('#character-status') : $('#character-status');
            if ($container.length > 0) {
                console.log('💾 自動刷新前保存卡片狀態...');
                saveCardStates();
                loadAndDisplay();
            } else {
                console.warn('⚠️ 狀態欄未初始化，跳過數據更新');
            }
        } catch (error) {
            console.error('❌ 刷新狀態欄時出錯:', error);
        }
    }, 500);
}

// ==================== 全局函數暴露 ====================
if (typeof window !== 'undefined') {
    window.initializeCharacterStatus = initializeCharacterStatus;
    window.cleanupCharacterStatus = cleanupCharacterStatus;
    window.loadAndDisplay = loadAndDisplay;
    window.toggleCardStyle = toggleCardStyle;
    window.resetDragPosition = resetDragPosition;
    window.diagnoseMvuAvailability = diagnoseMvuAvailability;
    console.log('✅ 狀態欄控制函數已暴露到全局');
}

// ==================== 腳本啓動 ====================
$(() => {
    console.log('📄 DOM已就緒，檢測MVU框架...');
    
    waitForMvu(() => {
        console.log('🚀 開始初始化人物羈絆卡片狀態欄');
        initializeCharacterStatus();
        
        if (typeof eventSource !== 'undefined' && eventSource.on) {
            eventSource.on('MESSAGE_RECEIVED', handleCharacterMessageReceived);
            console.log('✅ 已註冊 MESSAGE_RECEIVED 事件監聽 (eventSource)');
        } else if (typeof eventOn === 'function' && typeof tavern_events !== 'undefined' && tavern_events.MESSAGE_RECEIVED) {
            eventOn(tavern_events.MESSAGE_RECEIVED, handleCharacterMessageReceived);
            console.log('✅ 已註冊 MESSAGE_RECEIVED 事件監聽 (tavern_events)');
        } else {
            console.warn('⚠️ 無法註冊 MESSAGE_RECEIVED 事件（事件系統未找到）');
        }
    });
});

$(window).on('unload', () => {
    if (typeof eventSource !== 'undefined' && eventSource.removeListener) {
        eventSource.removeListener('MESSAGE_RECEIVED', handleCharacterMessageReceived);
        console.log('🗑️ 已移除 MESSAGE_RECEIVED 事件監聽');
    } else if (typeof eventRemoveListener === 'function' && typeof tavern_events !== 'undefined' && tavern_events.MESSAGE_RECEIVED) {
        eventRemoveListener(tavern_events.MESSAGE_RECEIVED, handleCharacterMessageReceived);
        console.log('🗑️ 已移除 MESSAGE_RECEIVED 事件監聽');
    }
    
    cleanupCharacterStatus();
});

console.log('📦 人物羈絆卡片狀態欄腳本已加載完成');