}

// ========== 初始化容器 ==========
function initializeCharacterStatus() {
    console.log('開始啓動人物羈絆完整版狀態欄');
    
    try {
        if (window.top && window.top.document !== document) {
            $(window.top.document).find('#character-status').remove();
        }
        $('#character-status').remove();
        
        const container = $('<div>', { id: 'character-status', class: 'character-container' });
        const statusTop = $('<div>', { id: 'status-top', class: 'status-top', html: getHamsterLoadingHTML('正在加載數據...') });
        const contentArea = $('<div>', { id: 'character-content', class: 'character-content' });
        container.append(statusTop, contentArea);
        $('body').prepend(container);
        
        waitForMvu(() => {
            setTimeout(() => {
                loadAndDisplay();
                setTimeout(() => {
                    initializeResizable();
                    //addSizeControls();
                    loadSavedSize();
                    restoreFlipStates();
                    $(window).on('resize', () => checkWidthAndAdjustLayout());
                }, 500);
            }, 500);
        });
        
        if (typeof eventSource !== 'undefined' && eventSource.on) {
            eventSource.on('MESSAGE_RECEIVED', handleCharacterMessageReceived);
        } else if (typeof eventOn === 'function' && typeof tavern_events !== 'undefined') {
            eventOn(tavern_events.MESSAGE_RECEIVED, handleCharacterMessageReceived);
        }
        
        console.log('人物羈絆完整版狀態欄初始化完成');
    } catch (error) {
        console.error('初始化失敗:', error);
    }
}

// ========== 頁面卸載清理 ==========
$(window).on('unload', () => {
    if (typeof eventSource !== 'undefined' && eventSource.removeListener) {
        eventSource.removeListener('MESSAGE_RECEIVED', handleCharacterMessageReceived);
    } else if (typeof eventRemoveListener === 'function' && typeof tavern_events !== 'undefined') {
        eventRemoveListener(tavern_events.MESSAGE_RECEIVED, handleCharacterMessageReceived);
    }
    cleanupCharacterStatus();
});

// ========== 啓動初始化 ==========
$(document).ready(() => {
    console.log('頁面就緒，開始初始化...');
    initializeCharacterStatus();
});

