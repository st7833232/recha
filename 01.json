    const top = clothing.上衣?.[0] || '無';
    const bottom = clothing.下裝?.[0] || '無';
    const underwear = clothing.內衣?.[0] || '無';
    const panties = clothing.內褲?.[0] || '無';
    const stockings = clothing.絲襪?.[0] || '無';
    const shoes = clothing.鞋子?.[0] || '無';
    
    const bodyFeatures = beauty.身體特徵 || {};
    const measurements = bodyFeatures.三圍 || {};
    const bust = measurements.胸圍?.[0] || '-';
    const waist = measurements.腰圍?.[0] || '-';
    const hips = measurements.臀圍?.[0] || '-';
    const cupSize = measurements.罩杯?.[0] || '-';
    const breastShape = bodyFeatures.乳房?.形狀?.[0] || '-';
    const nippleColor = bodyFeatures.乳房?.乳頭顏色?.[0] || '-';
    const privateType = bodyFeatures.私處?.類型?.[0] || '-';
    
    const sexExp = beauty.性經驗 || {};
    const virgin = sexExp.處女?.[0] || '-';
    const analExp = sexExp.肛交經驗?.[0] || '-';
    const oralExp = sexExp.口交經驗?.[0] || '-';
    const sexCount = sexExp.性行爲次數?.[0] || 0;
    const partnerCount = sexExp.性伴侶數量?.[0] || 0;
    const firstPartner = sexExp.初次性行爲對象?.[0] || '-';
    
    const physState = beauty.生理狀態 || {};
    const secretion = physState.體液分泌?.[0] || '-';
    const nippleState = physState.乳頭狀態?.[0] || '-';
    const clitState = physState.陰蒂狀態?.[0] || '-';
    const uterusState = physState.子宮狀態?.[0] || '-';
    const menstrualCycle = physState.月經週期?.[0] || '-';
    const pregnancy = physState.懷孕狀態?.[0] || '-';
    
    const animationDuration = `${(84/heartbeat).toFixed(2)}s`;
    
    // 處理敏感部位
    let sensitiveParts = [];
    if (beauty.敏感部位) {
        const parts = Object.keys(beauty.敏感部位).filter(k => k !== '$meta');
        parts.forEach(part => {
            const reaction = beauty.敏感部位[part]?.反應描述?.[0] || '-';
            sensitiveParts.push({ name: part, reaction });
        });
    }
    
    // ===== 修正：從根目錄獲取催眠暗示 =====
    // ===== 修正：處理根目錄的催眠暗示（過濾掉非暗示欄位） =====
let hypnosisItems = [];

// 檢查根目錄是否有催眠暗示
if (beauty.催眠暗示) {
    const hypnosisData = beauty.催眠暗示;
    console.log(`🔍 找到根目錄催眠暗示數據:`, hypnosisData);
    
    // 處理物件格式的催眠暗示
    if (typeof hypnosisData === 'object' && !Array.isArray(hypnosisData)) {
        Object.entries(hypnosisData).forEach(([key, value]) => {
            // 過濾掉 $meta 和 $__META_EXTENSIBLE__$
            if (key === '$meta' || key === '$__META_EXTENSIBLE__$') {
                return;
            }
            
            // 跳過 "催眠程度" 這種非暗示欄位（值是數字或不是物件/字串）
            if (typeof value === 'number') {
                console.log(`⏭️ 跳過數字欄位: ${key}=${value}`);
                return;
            }
            
            // 處理物件格式的暗示 (您的格式)
            if (typeof value === 'object' && value !== null) {
                // 獲取內容，處理可能為陣列的情況
                let content = value.內容 || value.content || '';
                if (Array.isArray(content) && content.length > 0) {
                    content = content[0];
                }
                
                // 獲取深度，處理可能為陣列的情況
                let depth = value.深度 || value.depth || '中等';
                if (Array.isArray(depth) && depth.length > 0) {
                    depth = depth[0];
                }
                
                if (content) {  // 只添加有內容的項目
