// ========== 主加載函數 ==========
function loadAndDisplay(retryCount = 0) {
    console.log(`開始加載MVU數據... (嘗試 ${retryCount + 1})`);
    try {
        _loadAndDisplayInternal(retryCount);
    } catch (error) {
        console.error('加載出錯:', error);
        $('#status-top').html(`<div class="status-message-box" style="color: #ef4444;"><p>加載數據時發生錯誤</p><button onclick="loadAndDisplay(0)" style="padding: 8px 16px; background: rgba(96,165,250,0.2); border: 1px solid #60a5fa; border-radius: 5px; color: #60a5fa;">重試</button></div>`).removeClass('hidden');
    }
}

function _loadAndDisplayInternal(retryCount = 0) {
    const mvuAvailable = typeof Mvu !== 'undefined' || typeof window.Mvu !== 'undefined' || (window.parent && typeof window.parent.Mvu !== 'undefined');
    
    if (!mvuAvailable) {
        if (retryCount < 3) {
            $('#status-top').html(getHamsterLoadingHTML(`等待MVU框架加載中... (${retryCount + 1}/3)`)).removeClass('hidden');
            setTimeout(() => loadAndDisplay(retryCount + 1), 2000);
        } else {
            $('#status-top').html(`<div class="status-message-box" style="color: #fbbf24;"><p>MVU框架未加載</p><button onclick="loadAndDisplay(0)" style="padding: 8px 16px; background: rgba(96,165,250,0.2); border: 1px solid #60a5fa; border-radius: 5px; color: #60a5fa;">重試</button></div>`).removeClass('hidden');
        }
        return;
    }
    
    if (typeof Mvu === 'undefined' && window.parent && typeof window.parent.Mvu !== 'undefined') {
        window.Mvu = window.parent.Mvu;
    }
    
    let targetMessageId = 'latest';
    if (typeof getLastMessageId === 'function' && typeof getChatMessages === 'function') {
        let currentId = getLastMessageId();
        while (currentId >= 0) {
            const message = getChatMessages(currentId).at(-1);
            if (message && message.role !== 'user') {
                targetMessageId = currentId;
                break;
            }
            currentId--;
        }
    }
    
    const data = Mvu.getMvuData({ type: 'message', message_id: targetMessageId });
    
    if (!data || !data.stat_data) {
        $('#status-top').html(`<div class="empty-notice-container"><div class="empty-notice-content"><span class="empty-notice-text">目前無互動角色</span><button class="empty-notice-close" onclick="document.getElementById('character-status').remove()">✕</button></div></div>`).removeClass('hidden');
        setTimeout(() => initializeDragFeature(), 300);
        return;
    }
    
    const statData = data.stat_data;
    let bondsData = {};
    
    if (statData['人物羈絆']) {
        bondsData = statData['人物羈絆'];
        console.log('找到人物羈絆:', bondsData);
    } else if (isCharacterData(statData)) {
        bondsData = { '當前角色': statData };
    } else {
        for (const key of Object.keys(statData)) {
            if (key !== '$meta' && typeof statData[key] === 'object' && isCharacterData(statData[key])) {
                bondsData[key] = statData[key];
            }
        }
    }
    
    const characters = Object.keys(bondsData).filter(k => k !== '$meta');
    
    if (characters.length === 0) {
        $('#status-top').html(`<div class="empty-notice-container"><div class="empty-notice-content"><span class="empty-notice-text">目前無互動角色</span><button class="empty-notice-close" onclick="document.getElementById('character-status').remove()">✕</button></div></div>`).removeClass('hidden');
        setTimeout(() => initializeDragFeature(), 300);
        return;
    }
    
    window.CHARACTER_DATA = { characters, bondsData };
    renderCurrentPage();
    $('#status-top').addClass('hidden');
    
    setTimeout(() => {
        const $container = window.top ? $(window.top.document).find('#character-status') : $('#character-status');
        const container = $container[0];
        if (container && container.dataset.dragInitialized !== 'true') {
            initializeDragFeature();
            container.dataset.dragInitialized = 'true';
        }
    }, 300);
}

// ==================== 拖拽功能 ====================
let dragData = null;
let dragHandlersAttached = false;

function initializeDragFeature() {
    const $container = window.top ? $(window.top.document).find('#character-status') : $('#character-status');
    const container = $container[0];
    if (!container || dragHandlersAttached) return;
    
    try {
        const saved = localStorage.getItem('character-status-position');
        if (saved) {
            const pos = JSON.parse(saved);
            container.style.left = pos.left + 'px';
            container.style.top = pos.top + 'px';
            container.style.transform = 'none';
        }
    } catch(e) {}
    
    function handleDragStart(clientX, clientY, target) {
        if (dragData) return false;
        
        const $target = $(target);
        if ($target.is('button, input, textarea, select, a') || $target.closest('button, input, textarea, select, a').length > 0) return false;
        
        const targetWindow = window.top && window.top.document === container.ownerDocument ? window.top : window;
        const computedStyle = targetWindow.getComputedStyle(container);
        const currentLeft = parseInt(computedStyle.left) || 0;
        const currentTop = parseInt(computedStyle.top) || 0;
        
        container.style.transform = 'none';
        dragData = { startX: clientX, startY: clientY, initialLeft: currentLeft, initialTop: currentTop };
        container.classList.add('dragging');
        return true;
    }
    
    $container.on('mousedown.drag', function(e) {
        if (handleDragStart(e.clientX, e.clientY, e.target)) {
            e.preventDefault();
            e.stopPropagation();
        }
    });
    
    $container.on('touchstart.drag', function(e) {
        const touch = e.originalEvent.touches[0];
        if (handleDragStart(touch.clientX, touch.clientY, e.target)) {
            e.preventDefault();
            e.stopPropagation();
        }
    });
    
    function handleDragMove(clientX, clientY) {
        if (!dragData) return;
        const deltaX = clientX - dragData.startX;
        const deltaY = clientY - dragData.startY;
        let newLeft = dragData.initialLeft + deltaX;
        let newTop = dragData.initialTop + deltaY;
        const targetWindow = window.top || window;
        const maxX = $(targetWindow).width() - 100;
        const maxY = $(targetWindow).height() - 100;
        newLeft = Math.max(0, Math.min(newLeft, maxX));
        newTop = Math.max(0, Math.min(newTop, maxY));
        const currentContainer = window.top ? window.top.document.getElementById('character-status') : document.getElementById('character-status');
        if (currentContainer) {
            currentContainer.style.left = newLeft + 'px';
            currentContainer.style.top = newTop + 'px';
        }
    }
    
    const targetDocument = window.top ? window.top.document : document;
    const $targetDoc = $(targetDocument);
    
    $targetDoc.on('mousemove.drag-move', function(e) {
        handleDragMove(e.clientX, e.clientY);
        if (dragData) e.preventDefault();
    });
    
    $targetDoc.on('touchmove.drag-move', function(e) {
        const touch = e.originalEvent.touches[0];
        handleDragMove(touch.clientX, touch.clientY);
        if (dragData) e.preventDefault();
    });
    
    function handleDragEnd() {
        if (!dragData) return;
        const currentContainer = window.top ? window.top.document.getElementById('character-status') : document.getElementById('character-status');
        if (currentContainer) currentContainer.classList.remove('dragging');
        if (currentContainer) {
            const targetWindow = window.top && window.top.document === currentContainer.ownerDocument ? window.top : window;
            const computedStyle = targetWindow.getComputedStyle(currentContainer);
            const position = { left: parseInt(computedStyle.left) || 0, top: parseInt(computedStyle.top) || 0 };
            localStorage.setItem('character-status-position', JSON.stringify(position));
        }
        dragData = null;
    }
    
    $targetDoc.on('mouseup.drag-up', handleDragEnd);
    $targetDoc.on('touchend.drag-up touchcancel.drag-up', handleDragEnd);
    dragHandlersAttached = true;
}

function resetDragPosition() {
    const container = window.top ? window.top.document.getElementById('character-status') : document.getElementById('character-status');
    if (container) {
        container.style.left = '50%';
        container.style.top = 'var(--topBarBlockSize, 60px)';
        container.style.transform = 'translateX(-50%)';
    }
    localStorage.removeItem('character-status-position');
}

function cleanupDragFeature() {
    dragData = null;
    dragHandlersAttached = false;
    const container = window.top ? window.top.document.getElementById('character-status') : document.getElementById('character-status');
    if (container) {
        $(container).off('.drag');
        container.classList.remove('dragging');
    }
    $(document).off('.drag-move, .drag-up');
    if (window.top && window.top.document !== document) {
        $(window.top.document).off('mousemove.drag-move mouseup.drag-up touchmove.drag-move touchend.drag-up touchcancel.drag-up');
    }
}

