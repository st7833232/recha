// ========== 渲染當前頁 ==========
function renderCurrentPage() {
    const { characters, bondsData } = window.CHARACTER_DATA;
    const { pageSize, currentPage } = window.CHARACTER_CONFIG;
    const totalPages = Math.ceil(characters.length / pageSize);
    
    if (currentPage >= totalPages) {
        window.CHARACTER_CONFIG.currentPage = Math.max(0, totalPages - 1);
    }
    
    const startIdx = window.CHARACTER_CONFIG.currentPage * pageSize;
    const currentCharacters = characters.slice(startIdx, startIdx + pageSize);
    
    const cardsHtml = currentCharacters.map(charKey => {
        const beauty = bondsData[charKey];
        return generateCharacterCard(charKey, beauty);
    }).join('');
    
    const paginationHtml = totalPages > 1 ? `
        <div class="pagination-controls">
            <button data-action="prev-page" ${window.CHARACTER_CONFIG.currentPage === 0 ? 'disabled' : ''}>${ICONS.prev} 上一頁</button>
            <span class="pagination-info">${window.CHARACTER_CONFIG.currentPage + 1} / ${totalPages}</span>
            <button data-action="next-page" ${window.CHARACTER_CONFIG.currentPage >= totalPages - 1 ? 'disabled' : ''}>下一頁 ${ICONS.next}</button>
        </div>
    ` : '';
    
    $('#character-content').html(`<div class="cards-grid">${cardsHtml}</div>${paginationHtml}`);
    initializeCardStyles();
    setupEventDelegation();
    setupFlipEvents();
    checkWidthAndAdjustLayout();
}

// ========== 設置翻轉事件 ==========
function setupFlipEvents() {
    $('[data-action="flip-card"]').off('click').on('click', function(e) {
        e.stopPropagation();
        const cardId = $(this).data('card-id');
        const $card3d = $(`#card-3d-${cardId}`);
        $card3d.toggleClass('flipped');
        
        const charKey = $(`#${cardId}`).data('char');
        if (charKey) {
            const flipStates = loadFlipStates();
            flipStates[charKey] = $card3d.hasClass('flipped');
            saveFlipStates(flipStates);
        }
    });
}

// ========== 事件委託 ==========
function setupEventDelegation() {
    const $container = window.top ? $(window.top.document).find('#character-status') : $('#character-status');
    $container.off('click');
    
    $container.on('click', '[data-action]', async function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const $btn = $(this);
        const action = $btn.data('action');
        
        if ($btn.prop('disabled')) return;
        
        try {
            switch(action) {
                case 'zoom-in':
                    zoomIn();
                    break;
                case 'zoom-out':
                    zoomOut();
                    break;
                case 'zoom-reset':
                    resetSize();
                    break;
                case 'toggle-style':
                    toggleCardStyle();
                    break;
                case 'refresh':
                    $btn.addClass('refreshing').prop('disabled', true);
                    try {
                        saveCardStates();
                        loadAndDisplay();
                    } finally {
                        setTimeout(() => {
                            $btn.removeClass('refreshing').prop('disabled', false);
                        }, 500);
                    }
                    break;
                case 'toggle-collapse':
                    const collapseCardId = $btn.data('card-id');
                    if (collapseCardId) {
                        const $cardWrapper = $(`#${collapseCardId}`);
                        $cardWrapper.toggleClass('collapsed');
                        const isCollapsed = $cardWrapper.hasClass('collapsed');
                        $btn.html(isCollapsed ? ICONS.pinFilled : ICONS.pin);
                        $btn.attr('title', isCollapsed ? '展開' : '收起');
                        saveCardStates();
                    }
                    break;
                case 'flip-card':
                    // 已在 setupFlipEvents 中處理
                    break;
                case 'sync-to-worldbook':
                    const charKey = $btn.data('char');
                    $btn.addClass('syncing').prop('disabled', true);
                    try {
                        await syncSingleCharacterToWorldbook(charKey);
                    } finally {
                        setTimeout(() => {
                            $btn.removeClass('syncing').prop('disabled', false);
                        }, 1000);
                    }
                    break;
                case 'prev-page':
                    if (window.CHARACTER_CONFIG.currentPage > 0) {
                        window.CHARACTER_CONFIG.currentPage--;
                        renderCurrentPage();
                    }
                    break;
                case 'next-page':
                    const { characters } = window.CHARACTER_DATA;
                    const totalPages = Math.ceil(characters.length / window.CHARACTER_CONFIG.pageSize);
                    if (window.CHARACTER_CONFIG.currentPage < totalPages - 1) {
                        window.CHARACTER_CONFIG.currentPage++;
                        renderCurrentPage();
                    }
                    break;
            }
        } catch (error) {
            console.error('操作失敗:', error);
        }
    });
}

// ========== 翻頁函數 ==========
function prevPage() {
    if (window.CHARACTER_CONFIG.currentPage > 0) {
        window.CHARACTER_CONFIG.currentPage--;
        renderCurrentPage();
    }
}

function nextPage() {
    const { characters } = window.CHARACTER_DATA;
    const totalPages = Math.ceil(characters.length / window.CHARACTER_CONFIG.pageSize);
    if (window.CHARACTER_CONFIG.currentPage < totalPages - 1) {
        window.CHARACTER_CONFIG.currentPage++;
        renderCurrentPage();
    }
}

window.prevPage = prevPage;
window.nextPage = nextPage;

// ========== 同步世界書功能 ==========
async function syncSingleCharacterToWorldbook(charKey) {
    try {
        if (typeof getCharWorldbookNames !== 'function') {
            if (typeof toastr !== 'undefined') toastr.warning('世界書功能不可用');
            return;
        }
        
        const worldbooks = getCharWorldbookNames('current');
        if (!worldbooks.primary && worldbooks.additional.length === 0) {
            if (typeof toastr !== 'undefined') toastr.info('當前角色未綁定世界書');
            return;
        }
        
        const { bondsData } = window.CHARACTER_DATA;
        const beauty = bondsData[charKey];
        const name = safeGet(beauty?.基礎信息?.姓名, charKey);
        const entryName = `${name}當前檔案`;
        const yamlData = buildSimpleCharacterYAML(charKey, beauty);
        
        const entryConfig = {
            name: entryName,
            enabled: true,
            strategy: { type: 'selective', keys: [name], keys_secondary: { logic: 'and_any', keys: [] }, scan_depth: 'same_as_global' },
            position: { type: 'before_character_definition', order: 100 },
            content: yamlData,
            probability: 100,
            recursion: { prevent_incoming: true, prevent_outgoing: true, delay_until: null },
            effect: { sticky: null, cooldown: null, delay: null }
        };
        
        const targetWorldbook = worldbooks.primary || worldbooks.additional[0];
        
        try {
            await deleteWorldbookEntries(targetWorldbook, entry => entry.name === entryName, { render: 'debounced' });
        } catch(e) {}
        
        await createWorldbookEntries(targetWorldbook, [entryConfig], { render: 'debounced' });
        await syncAllCharactersEntry(worldbooks, charKey, beauty);
        
        if (typeof toastr !== 'undefined') toastr.success(`${name} 已同步到世界書`);
    } catch (error) {
        console.error('同步失敗:', error);
        if (typeof toastr !== 'undefined') toastr.error('同步失敗');
    }
}

async function syncAllCharactersEntry(worldbooks, charKey, beauty) {
    try {
        const entryName = "所有角色檔案";
        console.log('📚 開始同步"所有角色檔案"（累積模式）...');
        
        const targetWorldbook = worldbooks.primary || worldbooks.additional[0];
        if (!targetWorldbook) return;
        
        const name = safeGet(beauty?.基礎信息?.姓名, charKey);
        const gender = safeGet(beauty?.基礎信息?.性別, '女');
        const age = safeGet(beauty?.基礎信息?.年齡, '?');
        const identity = safeGet(beauty?.基礎信息?.身份, '?');
        
        // 嘗試讀取現有的"所有角色檔案"
        let existingContent = '';
        let existingEntry = null;
        
        if (typeof getWorldbookEntries === 'function') {
            const allEntries = await getWorldbookEntries(targetWorldbook);
            existingEntry = allEntries.find(entry => entry.name === entryName);
            if (existingEntry) existingContent = existingEntry.content;
        }
        
        let existingCharacters = new Set();
        if (existingContent) {
            const lines = existingContent.split('\n');
            for (const line of lines) {
                if (line.includes('角色名:')) {
                    const charName = line.split('角色名:')[1]?.trim();
                    if (charName) existingCharacters.add(charName);
                }
            }
        }
        
        // 如果已存在，更新資訊
        if (existingCharacters.has(name)) {
            console.log(`ℹ️ 角色 ${name} 已存在，將更新資訊`);
            const roleRegex = new RegExp(`角色名:\\s*${escapeRegex(name)}\\s*\\n[\\s\\S]*?(?=\\n角色名:|$)`, 'g');
            existingContent = existingContent.replace(roleRegex, '');
        }
        
        // 構建完整角色資訊
        let characterEntry = `角色名: ${name}\n`;
        characterEntry += `性別: ${gender}\n`;
        characterEntry += `年齡: ${age}\n`;
        characterEntry += `身份: ${identity}\n`;
        
        // 添加身體特徵
        const height = safeGet(beauty?.基礎信息?.外貌?.身高, '?');
        const bust = safeGet(beauty?.身體特徵?.三圍?.胸圍, '?');
        const waist = safeGet(beauty?.身體特徵?.三圍?.腰圍, '?');
        const hip = safeGet(beauty?.身體特徵?.三圍?.臀圍, '?');
        const cup = safeGet(beauty?.身體特徵?.三圍?.罩杯, '?');
        
        characterEntry += `身高: ${height}\n`;
        characterEntry += `三圍: ${bust}-${waist}-${hip} (${cup}杯)\n`;
        
        // 添加性經驗
        const virgin = safeGet(beauty?.性經驗?.處女, '-');
        const sexCount = safeGet(beauty?.性經驗?.性行爲次數, 0);
        const sexPartners = safeGet(beauty?.性經驗?.性伴侶數量, 0);
        
        characterEntry += `處女: ${virgin}\n`;
        characterEntry += `性行爲次數: ${sexCount}次\n`;
        characterEntry += `性伴侶數量: ${sexPartners}人\n`;
        
        // 添加當前所想
        const thought = safeGet(beauty?.心理狀態?.當前所想, '');
        if (thought) {
            characterEntry += `當前所想: ${thought}\n`;
        }
        
        characterEntry += `\n`;
        
        // 組合內容
        let newContent = existingContent;
        if (existingContent && !existingContent.endsWith('\n\n')) {
            newContent += '\n';
        }
        newContent += characterEntry;
        
        const entryConfig = {
            name: entryName,
            enabled: true,
            strategy: { type: 'constant', keys: [], keys_secondary: { logic: 'and_any', keys: [] }, scan_depth: 'same_as_global' },
            position: { type: 'before_character_definition', order: 100 },
            content: newContent,
            probability: 100,
            recursion: { prevent_incoming: true, prevent_outgoing: true, delay_until: null },
            effect: { sticky: null, cooldown: null, delay: null }
        };
        
        try {
            await deleteWorldbookEntries(targetWorldbook, entry => entry.name === entryName, { render: 'debounced' });
        } catch(e) {}
        
        await createWorldbookEntries(targetWorldbook, [entryConfig], { render: 'debounced' });
        console.log(`✅ "所有角色檔案"已同步，共 ${existingCharacters.size + 1} 個角色`);
    } catch (error) {
        console.error('同步所有角色檔案失敗:', error);
    }
}

// 輔助函數：轉義正則表達式特殊字符
function escapeRegex(str) {
    return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

