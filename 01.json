}

#quick-reply-rocket-button::after {
    content: "🚀" !important;
    position: absolute !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    font-size: 20px !important;
    z-index: 9999 !important;
}
*/

/* 確保在移動端也有正確大小 */
@media (max-width: 600px) {
    #quick-reply-rocket-button {
        width: calc(var(--button-size) * 0.9) !important;
        height: calc(var(--button-size) * 0.9) !important;
        background-size: calc(var(--icon-actual-size) * 0.75) calc(var(--icon-actual-size) * 0.75) !important;
    }
}