// ========== 等待MVU加載 ==========
function waitForMvu(callback, maxAttempts = 20) {
    let attempts = 0;
    
    const checkMvu = () => {
        attempts++;
        
        const mvuExists = typeof Mvu !== 'undefined' ||
                         typeof window.Mvu !== 'undefined' ||
                         (window.parent && typeof window.parent.Mvu !== 'undefined');
        
        if (mvuExists) {
            if (typeof Mvu === 'undefined' && window.parent && typeof window.parent.Mvu !== 'undefined') {
                window.Mvu = window.parent.Mvu;
            }
            callback();
        } else if (attempts < maxAttempts) {
            setTimeout(checkMvu, 1000);
        } else {
            console.error('MVU框架加載超時');
            callback();
        }
    };
    
    checkMvu();
}

// ========== 判斷是否爲角色數據 ==========
function isCharacterData(obj) {
    if (!obj || typeof obj !== 'object') return false;
    const coreFields = ['基礎信息', '性經驗', '心理狀態'];
    let matchCount = 0;
    for (const field of coreFields) {
        if (obj[field] !== undefined) matchCount++;
    }
    return matchCount >= 2;
}

// ========== 安全讀取數據 ==========
function safeGet(data, defaultValue = '-') {
    if (Array.isArray(data) && data.length > 0) {
        const value = data[0];
        return (value === '' || value === null || value === undefined) ? defaultValue : value;
    }
    return (data === undefined || data === null) ? defaultValue : data;
}

// ========== HTML轉義 ==========
function escapeHtml(str) {
    if (!str) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

// ==================== 尺寸控制功能 ====================
let currentScale = 1;
const MIN_SCALE = 0.6;
const MAX_SCALE = 1.5;
const SCALE_STEP = 0.05;

function loadSavedSize() {
    try {
        const savedWidth = localStorage.getItem('character-status-width');
        const savedScale = localStorage.getItem('character-status-scale');
        
        const $container = window.top ? $(window.top.document).find('#character-status') : $('#character-status');
        
        if ($container.length === 0) return;
        
        if (savedWidth) {
            $container.css('width', savedWidth);
        }
        
        if (savedScale) {
            currentScale = parseFloat(savedScale);
            setTimeout(() => applyScale(currentScale), 100);
        }
        
        console.log('✅ 已加載保存的尺寸設置');
    } catch (e) {
        console.warn('⚠️ 加載尺寸設置失敗');
    }
}

function applyScale(scale) {
    currentScale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, scale));
    
    const $container = window.top ? $(window.top.document).find('#character-status') : $('#character-status');
    const $content = $container.find('#character-content');
    
    if ($content.length === 0) return;
    
    $content.css('transform', `scale(${currentScale})`);
    $content.css('transform-origin', 'top center');
    $container.css('height', 'auto');
    
    try {
        localStorage.setItem('character-status-scale', currentScale.toString());
    } catch (e) {}
    
    console.log(`🔍 縮放比例: ${currentScale}`);
}

function zoomIn() { applyScale(currentScale + SCALE_STEP); }
function zoomOut() { applyScale(currentScale - SCALE_STEP); }

function resetSize() {
    const $container = window.top ? $(window.top.document).find('#character-status') : $('#character-status');
    $container.css('width', '');
    localStorage.removeItem('character-status-width');
    applyScale(1);
    resetDragPosition();
    if (typeof toastr !== 'undefined') toastr.success('已重置版面大小');
}

function initializeResizable() {
    const $container = window.top ? $(window.top.document).find('#character-status') : $('#character-status');
    const container = $container[0];
    if (!container) return;
    
    if ($container.find('.resize-handle').length === 0) {
        $container.append('<div class="resize-handle"></div>');
    }
    
    let startX = 0, startWidth = 0, isResizing = false;
    const $handle = $container.find('.resize-handle');
    
    function onResizeStart(e) {
        isResizing = true;
        startX = e.clientX;
        startWidth = $container.width();
        $handle.addClass('active');
        e.preventDefault();
    }
    
    function onResizeMove(e) {
        if (!isResizing) return;
        const deltaX = e.clientX - startX;
        let newWidth = startWidth + deltaX;
        newWidth = Math.min(window.innerWidth * 0.9, Math.max(280, newWidth));
        $container.css('width', `${newWidth}px`);
        try { localStorage.setItem('character-status-width', `${newWidth}px`); } catch(e) {}
        checkWidthAndAdjustLayout();
    }
    
    function onResizeEnd() {
        isResizing = false;
        $handle.removeClass('active');
    }
    
    $handle.on('mousedown', onResizeStart);
    $(document).on('mousemove', onResizeMove);
    $(document).on('mouseup', onResizeEnd);
    
    $handle.on('touchstart', (e) => {
        const touch = e.originalEvent.touches[0];
        onResizeStart(touch);
    });
    $(document).on('touchmove', (e) => {
        if (!isResizing) return;
        const touch = e.originalEvent.touches[0];
        onResizeMove(touch);
    });
    $(document).on('touchend', onResizeEnd);
}

function addSizeControls() {
    const $container = window.top ? $(window.top.document).find('#character-status') : $('#character-status');
    if ($container.find('.size-controls').length > 0) return;
    
    const $sizeControls = $(`
        <div class="size-controls">
            <button class="size-control-btn" data-action="zoom-out" title="縮小">−</button>
            <button class="size-control-btn" data-action="zoom-reset" title="重置大小">↺</button>
            <button class="size-control-btn" data-action="zoom-in" title="放大">+</button>
        </div>
    `);
    
    $container.append($sizeControls);
    $sizeControls.find('[data-action="zoom-out"]').on('click', () => zoomOut());
    $sizeControls.find('[data-action="zoom-in"]').on('click', () => zoomIn());
    $sizeControls.find('[data-action="zoom-reset"]').on('click', () => resetSize());
}

function checkWidthAndAdjustLayout() {
    const $container = window.top ? $(window.top.document).find('#character-status') : $('#character-status');
    if ($container.length === 0) return;
    const containerWidth = $container.width();
    if (containerWidth < 500 && currentCardStyle === 2) {
        $container.addClass('compact-mode');
    } else {
        $container.removeClass('compact-mode');
    }
}

// ========== 樣式切換功能 ==========
let currentCardStyle = 1;

function loadSavedCardStyle() {
    try {
        const saved = localStorage.getItem('character-card-style');
        if (saved) {
            const styleNum = parseInt(saved);
            if (styleNum === 1 || styleNum === 2) {
                currentCardStyle = styleNum;
                return currentCardStyle;
            }
        }
    } catch (e) {}
    return 1;
}

function toggleCardStyle() {
    currentCardStyle = currentCardStyle === 1 ? 2 : 1;
    const $container = window.top ? $(window.top.document).find('#character-status') : $('#character-status');
    $container.attr('data-style', `style${currentCardStyle}`);
    try { localStorage.setItem('character-card-style', currentCardStyle.toString()); } catch(e) {}
}

function initializeCardStyles() {
    const $container = window.top ? $(window.top.document).find('#character-status') : $('#character-status');
    const savedStyle = loadSavedCardStyle();
    $container.attr('data-style', `style${savedStyle}`);
}

// ========== 狀態保存和恢復 ==========
function saveCardStates() {
    const states = {};
    $('.card-container-wrapper').each(function() {
        const $wrapper = $(this);
        const charKey = $wrapper.data('char');
        if (charKey) {
            states[charKey] = { collapsed: $wrapper.hasClass('collapsed') };
        }
    });
    try { localStorage.setItem('character-card-states', JSON.stringify(states)); } catch(e) {}
    return states;
}

function loadCardStates() {
    try {
        const saved = localStorage.getItem('character-card-states');
        return saved ? JSON.parse(saved) : {};
    } catch (e) { return {}; }
}

function saveFlipStates(states) {
    try { localStorage.setItem('character-flip-states', JSON.stringify(states)); } catch(e) {}
}

function loadFlipStates() {
    try {
        const saved = localStorage.getItem('character-flip-states');
        return saved ? JSON.parse(saved) : {};
    } catch (e) { return {}; }
}

function restoreFlipStates() {
    const flipStates = loadFlipStates();
    Object.keys(flipStates).forEach(charKey => {
        const $wrapper = $(`.card-container-wrapper[data-char="${charKey}"]`);
        if ($wrapper.length) {
            const cardId = $wrapper.attr('id');
            const $card3d = $(`#card-3d-${cardId}`);
            if (flipStates[charKey]) $card3d.addClass('flipped');
        }
    });
}

