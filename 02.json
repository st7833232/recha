  # 裝備格式：'裝備名稱': { '狀態類型': '耐久度', '狀態': 100, '重量': 0.1, '描述': '', '負重加成': 1, '加值': { '技能': 20 } }

攜帶物品: # 對象，以物品名稱為鍵，記錄角色攜帶的物品。
  {{get_message_variable::stat_data.攜帶物品}}
  # 格式：'物品名稱': { '數量': 數字, '狀態類型': '耐久度/新鮮度/純淨度', '狀態': 數字, '重量': 數字, '描述': '', '負重加成': 數字, '加值': { '技能': 數字 }, '功能': '' }
  # 說明：
     - 數量：物品數量
     - 狀態類型：耐久度/新鮮度/純淨度
     - 狀態：物品的當前狀態值
     - 負重加成：攜帶物品的容器如背包時包含（無加成=1，簡單背簍=1.2，專業背包=1.5等）
     - 加值：對檢定的加值數據，僅當物品屬於裝備/工具時包含
     - 功能：物品的特殊作用說明
  # 操作：add（新增），move（轉移到營地/同伴/裝備），remove（刪除），replace（修改屬性），delta（增減數量/狀態）
  # 範例：
  # 新增：{"op":"add","path":"/攜帶物品/野莓","value":{"數量":3,"狀態類型":"新鮮度","狀態":100,"重量":0.05,"描述":"酸甜的野生漿果"}}
  # 轉移到營地：{"op":"move","from":"/攜帶物品/木材","path":"/營地/河邊營地/材料/木材"}
  # 裝備：{"op":"move","from":"/攜帶物品/鐵劍","path":"/裝備/右手/鐵劍"}
  # 增加數量：{"op":"delta","path":"/攜帶物品/野莓/數量","value":2}
  # 減少新鮮度：{"op":"delta","path":"/攜帶物品/野莓/狀態","value":-5}

