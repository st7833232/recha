format: |-
  <UpdateVariable>
  <ThinkingProcess>(IN ENGLISH, follow the 6-step COT process in 'analysis' section above)
  STEP 1: Scene Analysis & Female Character Detection
    - 列出場景中出現的女性角色
    - 標註哪些角色離開場景
  
  STEP 2: Character Management
    - 檢查變量中已存在的角色
    - 決定哪些需要更新，哪些需要新增
  
  STEP 3: Variable Review (For EACH character to UPDATE)
    - 檢查分類：服裝、身體特徵、性經驗、生理狀態、其他
    - 逐一檢查每個欄位，標記是否有變化[Y/N]
    - 注意：所有帶 [0] 的欄位都需要檢查陣列第0個元素
  
  STEP 4: Command Selection
    - 根據變化類型選擇正確的 JSON Patch 操作
    - replace: 取代值（字串、數值、陣列元素）
    - delta: 數值增減
    - add: 新增屬性、陣列追加
    - remove: 刪除屬性、陣列元素
    - insert: 陣列指定位置插入
    - move: 陣列元素移動
  
  STEP 5: Analyze Other Variable Systems
    - 女性狀態欄 detailed COT: COMPLETED
    - Other variable groups? [YES/NO]
  
  STEP 6: Final Check
    - [0] suffixes? [YES/NO]
    - No extra quotes? [YES/NO]
    - All Y have commands? [YES/NO]
    - Chinese comments? [YES/NO]
    - 當前所想 ≦40 chars? [YES/NO]
    - Character names as keys? [YES/NO]
    - Pregnancy protection applied? [YES/NO] (if already pregnant)  
  </ThinkingProcess>    
  <jsonpatch>
  [
    //  新角色進場（使用 add，因為女性狀態欄是 extensible 物件） 
    {"op":"add","path":"/女性狀態欄/角色名","value":""},
    //  建立角色後才開始建立完整資訊（使用 add，因為女性狀態欄是 extensible 物件） 
    {"op":"add","path":"/女性狀態欄/角色名","value":{"服裝":{"上衣":[""],"下裝":[""],"內衣":[""],"內褲":[""],"絲襪":[""],"鞋子":[""]},"身體特徵":{"三圍":{"胸圍":[0],"腰圍":[0],"臀圍":[0]},"乳房":{"形狀":[""],"乳頭顏色":[""]}},"性經驗":{"處女":["是"],"性交經驗":["無"],"口交經驗":["無"],"肛交經驗":["無"],"性行為次數":[0],"性伴侶數量":[0],"初次性行為對象":[""]},"生理狀態":{"體液分泌":[""],"乳頭狀態":[""],"陰蒂狀態":[""],"月經週期":[""],"懷孕狀態":[""],"懷孕天數":[0]},"心跳":[0],"心理狀態":{"當前所想":[""]},"性癖好":[],"性愛人設":"","敏感部位":{},"重要經歷":{},"罪惡感":{}}},//新角色進場
    
    //  更新現有角色 
    
    // 更新當前所想
    {"op":"replace","path":"/女性狀態欄/林雅婷/心理狀態/當前所想/0","value":"新想法"},//更新想法
    
    // 性行為次數增加
    {"op":"delta","path":"/女性狀態欄/林雅婷/性經驗/性行為次數/0","value":1},//性行為次數+1
    
    // 處女狀態更改（發生性行為時）
    {"op":"replace","path":"/女性狀態欄/林雅婷/性經驗/處女/0","value":"否"},//處女狀態改為否
    
    // 性交經驗更改（發生性行為時）
    {"op":"replace","path":"/女性狀態欄/林雅婷/性經驗/性交經驗/0","value":"有"},//性交經驗改為有
    
    // 初次性行為對象（首次發生性行為時）
    {"op":"replace","path":"/女性狀態欄/林雅婷/性經驗/初次性行為對象/0","value":"阿彬"},//記錄初次對象
    
    // 新增性癖（追加到陣列末端）
    {"op":"add","path":"/女性狀態欄/林雅婷/性癖好/-","value":"戀足"},//新增性癖
    
    // 新增敏感部位（物件屬性）
    {"op":"add","path":"/女性狀態欄/林雅婷/敏感部位/耳朵","value":{"反應描述":["非常敏感"]}},//新增敏感部位
    
    // 新增重要經歷（物件屬性）
    {"op":"add","path":"/女性狀態欄/林雅婷/重要經歷/第一次約會","value":{"描述":["和男友第一次約會"]}},//新增重要經歷
    
    // 新增罪惡感（物件屬性）
    {"op":"add","path":"/女性狀態欄/林雅婷/罪惡感/偷看日記","value":{"當下感受":["罪惡感很重"]}},//新增罪惡感
    
    // 懷孕狀態更新（遵守 pregnancy_rules）
    {"op":"replace","path":"/女性狀態欄/林雅婷/生理狀態/懷孕狀態/0","value":"懷孕初期"},//懷孕狀態更新
    
    // 懷孕天數增加
    {"op":"delta","path":"/女性狀態欄/林雅婷/生理狀態/懷孕天數/0","value":1},//懷孕天數+1
    
    // 更新性愛人設（使用 replace 更新整段描述）
    {"op":"replace","path":"/女性狀態欄/林雅婷/性愛人設","value":"溫柔順從型，喜歡被主導，敏感部位是耳朵和脖子"},//更新性愛人設
    
    // 更新服裝
    {"op":"replace","path":"/女性狀態欄/林雅婷/服裝/上衣/0","value":"白色襯衫"},
    {"op":"replace","path":"/女性狀態欄/林雅婷/服裝/下裝/0","value":"黑色短裙"},
    {"op":"replace","path":"/女性狀態欄/林雅婷/服裝/內衣/0","value":"蕾絲胸罩"},
    {"op":"replace","path":"/女性狀態欄/林雅婷/服裝/內褲/0","value":"丁字褲"},
    {"op":"replace","path":"/女性狀態欄/林雅婷/服裝/絲襪/0","value":"黑色絲襪"},
    {"op":"replace","path":"/女性狀態欄/林雅婷/服裝/鞋子/0","value":"高跟鞋"},
    
    // 更新身體特徵（三圍）
    {"op":"replace","path":"/女性狀態欄/林雅婷/身體特徵/三圍/胸圍/0","value":34},
    {"op":"replace","path":"/女性狀態欄/林雅婷/身體特徵/三圍/腰圍/0","value":24},
    {"op":"replace","path":"/女性狀態欄/林雅婷/身體特徵/三圍/臀圍/0","value":35},
    
    // 更新身體特徵（乳房）
    {"op":"replace","path":"/女性狀態欄/林雅婷/身體特徵/乳房/形狀/0","value":"水滴形"},
    {"op":"replace","path":"/女性狀態欄/林雅婷/身體特徵/乳房/乳頭顏色/0","value":"粉紅色"},
    
    // 更新生理狀態
    {"op":"replace","path":"/女性狀態欄/林雅婷/生理狀態/體液分泌/0","value":"濕潤"},
    {"op":"replace","path":"/女性狀態欄/林雅婷/生理狀態/乳頭狀態/0","value":"挺立"},
    {"op":"replace","path":"/女性狀態欄/林雅婷/生理狀態/陰蒂狀態/0","value":"充血"},
    {"op":"replace","path":"/女性狀態欄/林雅婷/生理狀態/月經週期/0","value":"第14天"},
    
    // 更新心跳
    {"op":"replace","path":"/女性狀態欄/林雅婷/心跳/0","value":80},
    
    //  陣列元素操作範例（性癖好） 
    // 修改性癖好陣列中的特定元素（第0個）
    {"op":"replace","path":"/女性狀態欄/林雅婷/性癖好/0","value":"足交"},
    
    // 刪除性癖好陣列中的第1個元素
    {"op":"remove","path":"/女性狀態欄/林雅婷/性癖好/1"},
    
    // 在性癖好陣列第0個位置插入新元素
    {"op":"insert","path":"/女性狀態欄/林雅婷/性癖好","where":0,"value":"角色扮演"},
    
    // 移動性癖好陣列元素
    {"op":"move","from":"/女性狀態欄/林雅婷/性癖好/2","path":"/女性狀態欄/林雅婷/性癖好/0"},
    
    //  移除角色或屬性 
    // 刪除整個角色（角色退場時）
    {"op":"remove","path":"/女性狀態欄/林雅婷"},
    
    // 刪除角色的某個屬性
    {"op":"remove","path":"/女性狀態欄/林雅婷/罪惡感/偷看日記"}
  ]
  </jsonpatch>
  </UpdateVariable>

specific_rules:
  # 角色首次進場規則（CRITICAL）：
    - 當女性角色首次出現在場景中時，必須執行 **角色建立步驟**，然後才能執行其他更新
    - 角色建立步驟：使用 `add` 指令，路徑為 `/女性狀態欄/角色名`，值為空
    - 禁止直接對 `/女性狀態欄/角色名/xxx` 路徑進行任何操作，除非該角色已經建立
  #  角色管理規則 
    - 角色進場：女性角色首次進場並建立角色名後，才可使用 add 添加完整數據模板（見 character_addition_template）
    - 角色退場：角色離開場景時使用 remove 刪除該角色
    - 角色鍵命名：使用角色真實姓名作為鍵（如"林雅婷"），不使用編號
    - 擴展對象：女性狀態欄是 extensible 物件，使用 add 直接添加新屬性


**正確的兩步驟流程：**
1. `{"op":"add","path":"/女性狀態欄/紗倉桃","value":""}` //先建立角色
2. `{"op":"add","path":"/女性狀態欄/紗倉桃","value":{完整模板}}` //再建立角色完整資訊