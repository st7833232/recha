<變量及變量更新說明>
```yaml
核心狀態: # 角色最基礎的生存指標。
  生命值上限: {{get_message_variable::stat_data.核心狀態.生命值上限}} 
  # 說明：不改動

  當前生命值: {{get_message_variable::stat_data.核心狀態.當前生命值}} 
  # 範圍：0 - 生命值上限
  # 說明：代表綜合身體機能的抽象數值。降至0則角色死亡。受傷、疾病、飢餓、脫水等會降低此值。

  精神值上限: {{get_message_variable::stat_data.核心狀態.精神值上限}} 
  # 說明：不改動

  當前精神值: {{get_message_variable::stat_data.核心狀態.當前精神值}} 
  # 範圍：0 - 精神值上限
  # 說明：代表綜合精神狀態的抽象數值。降至0則角色崩潰。壓力、創傷、孤獨、恐懼等會降低此值。

生理: # 反映角色身體內部具體生理需求的數值。
  碳水: {{get_message_variable::stat_data.生理.碳水}} 
  # 單位：kcal
  # 說明：通過進食含有碳水的食物補充。在進行劇烈活動，處於寒冷環境或其他會消耗比基礎代謝更多的熱量的時候。先於脂肪和蛋白質消耗。當碳水超過2000的時候，多餘碳水的75%將會轉換爲脂肪。

  脂肪: {{get_message_variable::stat_data.生理.脂肪}} 
  # 單位：kcal
  # 說明：通過進食富含脂肪的食物補充。超過2000的碳水的75%也會轉換成脂肪。

  氮平衡: {{get_message_variable::stat_data.生理.氮平衡}} 
  # 範圍：[-100, 100]
  # 說明：身體每天消耗和合成蛋白質的平衡，食用富含蛋白質的食物時增加。75以上正氮平衡會獲得1.5倍力量經驗增長，更快從疲勞恢復。

  蛋白質: {{get_message_variable::stat_data.生理.蛋白質}} 
  # 說明：每小時會增加或減少氮平衡值的五分之一。低於2200會導致力量下降，免疫下降，傷口難以癒合，更難恢復耐力或其他缺乏蛋白質的副作用，低於越多副作用越大。

  維生素: {{get_message_variable::stat_data.生理.維生素}} 
  # 說明：通過進食水果、蔬菜等補充。低於50會影響免疫力並可能導致疾病。

  水分: {{get_message_variable::stat_data.生理.水分}} 
  # 範圍：[0, 100]
  # 說明：任何進食行為水分都直接恢復100。在進行體力活動、處於高溫環境等出汗狀態加速消耗時，進行額外的扣除。低於50會開始影響耐力並造成生命值損傷。0時死亡。喝水或使用富含水分的食物補充，不可超過100的上限。

  體溫: {{get_message_variable::stat_data.生理.體溫}} 
  # 單位：攝氏度
  # 說明：核心體溫，正常範圍36.5-37.5。受環境溫度、衣物、活動強度影響。過高或過低都會導致負面狀態。

  免疫負荷: {{get_message_variable::stat_data.生理.免疫負荷}} 
  # 範圍：[0-100]
  # 說明：代表免疫系統當前承受的壓力。受傷、感染、疾病會增加此值。高於免疫力越多，越容易生病和感染。

精神: # 反映角色心理和情緒狀態的數值。
  壓力: {{get_message_variable::stat_data.精神.壓力}} 
  # 說明：代表心理壓力水平。遭遇危險、疼痛、睡眠不足會增加。過高會持續降低精神值。

  無聊: {{get_message_variable::stat_data.精神.無聊}} 
  # 說明：代表精神刺激的缺乏程度。過高會降低精神值。娛樂、冒險或食用美味的食物會減少。

  孤獨: {{get_message_variable::stat_data.精神.孤獨}} 
  # 說明：代表社交需求的滿足程度。過高會降低精神值。跟生物（非生物也不是不行）交流或互動可降低。

  睡眠: {{get_message_variable::stat_data.精神.睡眠}} 
  # 說明：進行5小時以下睡眠每小時恢復6，進行5小時以上睡眠恢復至全滿。過低會導致疲勞並影響所有屬性。0時會強制昏迷。

天賦或特性: # 在開局時add，根據描述影響各種判定。
  {{get_message_variable::stat_data.天賦或特性}}
  # 格式：'天賦或特性名': { '描述': '具體描述', '加值': { '加值項目名稱': 數值 } }
  # 說明：描述該天賦或特性的主要內容，加值為對檢定的加值數據
  # 範例：
  # 新增：{"op":"add","path":"/天賦或特性/夜視","value":{"描述":"在黑暗中也能清晰視物","加值":{"夜間觀察":20}}}

屬性: # 角色六大主屬性，影響各種檢定和次生屬性。
  # 說明：當前經驗每次涉及屬性的檢定無論成功失敗都會增加，增加量為簡單難度+25，中等+50，困難+75。升級所需經驗: 等級*10。
  
  力量: # 決定負重上限和近戰傷害。
    等級: {{get_message_variable::stat_data.屬性.力量.等級}}
    當前經驗: {{get_message_variable::stat_data.屬性.力量.當前經驗}}
    升級所需經驗: {{get_message_variable::stat_data.屬性.力量.升級所需經驗}}

  敏捷: # 影響閃避、命中和執行精細操作的速度。
    等級: {{get_message_variable::stat_data.屬性.敏捷.等級}}
    當前經驗: {{get_message_variable::stat_data.屬性.敏捷.當前經驗}}
    升級所需經驗: {{get_message_variable::stat_data.屬性.敏捷.升級所需經驗}}

  耐力: # 決定生命值上限、奔跑持久度和對疲勞、疾病的抵抗力。
    等級: {{get_message_variable::stat_data.屬性.耐力.等級}}
    當前經驗: {{get_message_variable::stat_data.屬性.耐力.當前經驗}}
    升級所需經驗: {{get_message_variable::stat_data.屬性.耐力.升級所需經驗}}

  智力: # 影響學習速度、製作複雜物品和解決問題的能力。
    等級: {{get_message_variable::stat_data.屬性.智力.等級}}
    當前經驗: {{get_message_variable::stat_data.屬性.智力.當前經驗}}
    升級所需經驗: {{get_message_variable::stat_data.屬性.智力.升級所需經驗}}

  感知: # 決定發現隱藏物品、蹤跡和察覺危險的能力。
    等級: {{get_message_variable::stat_data.屬性.感知.等級}}
    當前經驗: {{get_message_variable::stat_data.屬性.感知.當前經驗}}
    升級所需經驗: {{get_message_variable::stat_data.屬性.感知.升級所需經驗}}

  意志: # 決定精神值上限和對緊急情況判斷、情感變化耐受度、壓力及疼痛的承受力。
    等級: {{get_message_variable::stat_data.屬性.意志.等級}}
    當前經驗: {{get_message_variable::stat_data.屬性.意志.當前經驗}}
    升級所需經驗: {{get_message_variable::stat_data.屬性.意志.升級所需經驗}}
    # 說明：在緊急情況下沒有逃避而做出判斷，無論結果如何都會增加經驗。在男女感情做出抉擇、抵抗誘惑，又或是成功獲得同伴滿意的決定、色誘或勸誘同伴、調教同伴、欺騙同伴、成功與同伴進行性交等需要進行判定的行為時，無論成功與否都會增加經驗。

次生屬性: # 由主屬性、裝備、狀態等綜合計算得出的衍生屬性。
  負重上限: {{get_message_variable::stat_data.次生屬性.負重上限}} 
  # 說明：不改變

  免疫力: {{get_message_variable::stat_data.次生屬性.免疫力}} 
  # 說明：不改變。基礎免疫力等於耐力，維生素等的缺乏會降低，綜合計算的抵抗疾病能力。

  最低舒適溫度: {{get_message_variable::stat_data.次生屬性.最低舒適溫度}} 
  # 說明：角色在當前衣物和狀態下不會過冷的最低溫度，越低越抗冷。受到裝備、溼度等元素影響。參考 rimworld。

  最高舒適溫度: {{get_message_variable::stat_data.次生屬性.最高舒適溫度}} 
  # 說明：角色在當前衣物和狀態下不會過熱的最高體感溫度，越高越抗熱。受到裝備、溼度等元素影響。參考 rimworld。

  飽腹感: {{get_message_variable::stat_data.次生屬性.飽腹感}} 
  # 說明：只計算進食後增加。當超過100點時會嘔吐，睡眠期間消耗減半。絕對嚴禁睡醒後直接設定飽腹感歸零。

狀態: # 記錄角色的各種即時狀態和效果。
  當前負重: {{get_message_variable::stat_data.狀態.當前負重}} 
  # 說明：當前所有攜帶物品和裝備的總重量。超過負重上限的50%開始影響行動速度和疲勞，超過越多影響越大，超過負重上限會完全無法移動。

  表皮溼度: {{get_message_variable::stat_data.狀態.表皮溼度}} 
  # 說明：代表皮膚表面的溼潤程度。出汗、淋雨會增加，乾燥環境會降低。影響體感溫度。

  當前狀態: {{get_message_variable::stat_data.狀態.當前狀態}} 
  # 說明：記錄角色當前的所有即時狀態。

  疲勞: {{get_message_variable::stat_data.狀態.疲勞}} 
  # 說明：代表身體的疲憊程度。由體力消耗（高強度體力活動一小時+50點）和睡眠不足累積。在不進行明顯消耗體力的活動（如靜坐、釣魚、休息）時。

  受傷: {{get_message_variable::stat_data.狀態.受傷}} 
  # 說明：記錄身體的受傷情況，例如：'無'、'輕微擦傷'、'右臂骨折'。會影響相應身體機能和產生疼痛。

  流血: {{get_message_variable::stat_data.狀態.流血}} 
  # 說明：流血類型，代表是否存在開放性傷口導致持續失血。會持續降低生命值，需包紮止血。

  感染: {{get_message_variable::stat_data.狀態.感染}} 
  # 說明：代表傷口感染程度。100表示身體徹底被感染內臟衰竭，角色死亡。

  疾病: {{get_message_variable::stat_data.狀態.疾病}} 
  # 說明：疾病名稱，若免疫負荷大於免疫力，在免疫負荷繼續提高的時候獲得。

  清潔: {{get_message_variable::stat_data.狀態.清潔}} 
  # 說明：代表身體和衣物的清潔度。在骯髒環境活動會降低。過低會增加感染風險和社交負面影響。

  疼痛: {{get_message_variable::stat_data.狀態.疼痛}} 
  # 說明：代表身體感受到的疼痛等級。由受傷程度決定。會持續降低精神值並影響行動。

  生效效果: {{get_message_variable::stat_data.狀態.生效效果}} 
  # 說明：角色當前正在生效的狀態效果。會對角色屬性、檢定等產生影響。
  # ⚠️ 禁止AI使用 add、remove、replace 更改！新增、移除已全部由指令碼自動處理。

技能: # 對象，一個可擴展的對象，以技能名稱為鍵，記錄角色掌握的各項技能。
  {{get_message_variable::stat_data.技能}}
  # 格式：'技能名稱': { '等級': 數字, '當前經驗': 數字, '升級所需經驗': 數字 }
  # 說明：
     - 等級：技能等級，新獲得技能時等級為1
     - 當前經驗：使用技能時根據難度獲得 +25 ~ +250
     - 升級所需經驗：1級以上為技能等級 * 100
  # 範例：
  # 新增技能：{"op":"add","path":"/技能/游泳","value":{"等級":1,"當前經驗":0,"升級所需經驗":100}}
  # 增加經驗：{"op":"delta","path":"/技能/游泳/當前經驗","value":50}

