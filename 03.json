// --- 修改后的状态效果渲染函数 ---
function createStatusEffects(container, data) {
    // 使用新的变量路径 '状态.生效效果'
    const source = data?.['状态']?.['生效效果'];
    if (source == null) {
        return;
    }

    // 新的数据结构：对象，键是状态类型，值包含"状态"和"效果"
    const collected = [];
    
    // 遍历状态对象
    if (typeof source === 'object' && !Array.isArray(source)) {
        Object.values(source).forEach((statusObj) => {
            if (statusObj && typeof statusObj === 'object') {
                // 提取状态名称
                const stateName = statusObj['状态'];
                if (stateName) {
                    // 过滤掉"状态正常"
                    if (stateName.trim() === '状态正常') {
                        return;
                    }
                    
                    // 从映射表中获取效果，如果映射表中没有，则使用变量中的效果
                    const effect = statusEffectsMap[stateName] || statusObj['效果'] || '';
                    
                    // 同时保存状态名称和效果
                    collected.push({
                        name: stateName,
                        effect: effect
                    });
                }
            }
        });
    } else {
        // 处理其他可能的数据结构
        const collect = (value) => {
            if (value == null) {
                return;
            }
            if (Array.isArray(value)) {
                value.forEach(collect);
                return;
            }
            if (typeof value === 'object') {
                Object.values(value).forEach(collect);
                return;
            }
            const text = String(value);
            text.split(/[,，、\s]+/)
                .map((item) => item.trim())
                .filter(Boolean)
                .forEach((item) => {
                    // 过滤掉"状态正常"
                    if (item.trim() === '状态正常') {
                        return;
                    }
                    
                    // 从映射表中获取效果
                    const effect = statusEffectsMap[item] || '';
                    
                    collected.push({
                        name: item,
                        effect: effect
                    });
                });
        };
        collect(e(source, false));
    }

    // 如果没有状态需要显示（或者所有状态都被过滤掉了），则隐藏整个状态效果容器
    if (collected.length === 0) {
        // 添加一个空的容器但隐藏起来，或者直接不显示
        const wrapper = $('<div>').addClass('status-effects-container').css('display', 'none');
        container.append(wrapper);
        return;
    }

    const wrapper = $('<div>').addClass('status-effects-container');
    $('<div>').addClass('section__title').text('当前状态').appendTo(wrapper);
    
    const list = $('<div>').addClass('status-effects-list');
    
    collected.forEach((status) => {
        // 创建状态容器
        const statusContainer = $('<div>').addClass('status-effect-container');
        
        // 创建状态名称（可点击）
        const statusName = $('<div>').addClass('status-effect-name')
            .text(status.name)
            .attr('title', '点击查看效果');
        
        // 如果有效果描述，添加点击事件
        if (status.effect) {
            statusName.addClass('has-effect');
            statusName.on('click', function() {
                $(this).toggleClass('expanded');
                $(this).next('.status-effect-detail').slideToggle(200);
            });
            
            // 创建效果详情区域（初始隐藏）
            const effectDetail = $('<div>').addClass('status-effect-detail')
                .hide()
                .text(status.effect);
            
            statusContainer.append(statusName, effectDetail);
        } else {
            // 没有效果描述，只显示状态名称
            statusContainer.append(statusName);
        }
        
        list.append(statusContainer);
    });
    
    wrapper.append(list);
    container.append(wrapper);
}

