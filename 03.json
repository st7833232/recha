/* --- 商店样式 --- */
.shop-points-header {
    background: linear-gradient(135deg, rgba(20, 34, 54, 0.78), rgba(24, 36, 58, 0.92));
    border: 1px solid var(--survival-glass-border);
    border-radius: 16px;
    padding: 14px 20px;
    margin-top: 16px;
    margin-bottom: 18px;
    text-align: center;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
}
.shop-points-header .points-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 30px;
    font-size: 16px;
    font-weight: 600;
}
.shop-points-header .points-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--survival-text);
}
.shop-points-header .points-icon {
    font-size: 20px;
    line-height: 1;
}
.shop-points-header .survival-icon { color: #f39c12; }
.shop-points-header .miracle-icon { color: #9b59b6; }
.shop-points-header .survival-value { color: #f39c12; margin-left: 4px; }
.shop-points-header .miracle-value { color: #9b59b6; margin-left: 4px; }

.shop-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
    margin-bottom: 20px;
}
@media (max-width: 360px) {
    .shop-grid {
        grid-template-columns: 1fr;
    }
}

.shop-item-card {
    position: relative;
    background: linear-gradient(145deg, rgba(17, 28, 45, 0.9), rgba(20, 34, 54, 0.92));
    border: 2px solid var(--survival-glass-border);
    border-radius: 18px;
    padding: 16px 18px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
