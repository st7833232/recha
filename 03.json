    // 商店
    const survivalPoints = Number(e(statData['系统']?.['生存点数'])) || 0;
    const miraclePoints = Number(e(statData['系统']?.['奇迹点数'])) || 0;
    const currentDay = Number(e(statData['系统']?.['经过天数'] ?? 0));
    const currentTime = textify(statData['系统']?.['当前时间'] ?? '00:00');
    const shopData = statData['商店'];
    
    if (shopData) {
        renderShop($root, shopData, survivalPoints, miraclePoints, currentDay, currentTime);
    }

    renderTaskSystem($root, statData); //任务
    
    // 渲染进度与知识模块
if (statData['项目'] || statData['研究'] || statData['知识库']) {
    renderProgressAndKnowledge($root, statData);
}

    // 创建按钮容器
    const buttonBar = $('<div>').addClass('button-container');

    buttonBar.append(
      $('<button>')
        .addClass('inventory-btn')
        .text('查看地图')
        .on('click', () => openImageViewerModal(statData, displayData))
    );

    const currentWeight = Number(e(statData['状态']?.['当前负重'] ?? 0)) || 0;
    const weightLimit = Number(e(statData['次生属性']?.['负重上限'] ?? 50)) || 50;
    buttonBar.append(
      $('<button>')
        .addClass('inventory-btn')
        .text('打开物品栏')
        .on('click', () => i(statData['装备'], statData['携带物品'], currentWeight, weightLimit))
    );

    $root.append(buttonBar);
  } catch (error) {
    console.error('渲染生存游戏 UI 时发生错误:', error);
  }
}

$(() => {
  try {
    p().catch((error) => {
      console.error('初始渲染失败:', error);
    });
    const rerender = () => {
      p().catch((error) => {
        console.error('变量更新后渲染失败:', error);
      });
    };
    try {
      if (typeof eventOn === 'function') {
        eventOn('mag_variable_update_ended', rerender);
      }
    } catch (error) {
      console.error('注册事件监听器失败:', error);
    }
    $(window).on('unload', () => {
      try {
        if (typeof eventRemoveListener === 'function') {
          eventRemoveListener('mag_variable_update_ended', rerender);
        }
      } catch (error) {
        console.error('移除事件监听器失败:', error);
      }
    });
  } catch (error) {
    console.error('初始化生存游戏UI时发生错误:', error);
  }
});
</script></body></html>
