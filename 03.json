</style></head><body><div id="survival-ui" class="survival-ui" tabindex="0"></div><script>


function normalizeValue(value) {
  if (Array.isArray(value)) {
    const flattened = [];
    value.forEach((item) => {
      if (Array.isArray(item)) {
        const inner = normalizeValue(item);
        if (Array.isArray(inner)) {
          flattened.push(...inner);
        } else if (inner !== '' && inner !== undefined && inner !== null) {
          flattened.push(inner);
        }
      } else if (item !== undefined && item !== null && item !== '') {
        flattened.push(item);
      }
    });
    if (flattened.length === 0) {
      return '';
    }
    if (flattened.length === 1) {
      return normalizeValue(flattened[0]);
    }
    return flattened;
  }
  return value;
}

// --- 通用物品渲染函数 ---
function renderItems(container, itemsData, options = {}) {
    const {
        checkQuantity = false, // 改为false，显示所有物品包括数量为0或负数的
        showQuantity = true,
        showWeight = true, 
        showState = true,
        showDescription = true,
        layout = 'grid',
        emptyText = '空'
    } = options;

    try {
        const entries = toEntries(itemsData);
        
        // 按状态类型优先级排序
        const sortedEntries = entries.sort((a, b) => {
            const getPriority = (item) => {
                const stateType = textify(item[1]?.['状态类型'] ?? '', '');
                if (stateType === '新鲜度') return 1;
                if (stateType === '纯净度') return 2;
                if (stateType === '耐久度') return 3;
                return 4; // 其他类型排在最后
            };
            
            return getPriority(a) - getPriority(b);
        });
        
        if (!sortedEntries || sortedEntries.length === 0) {
            const emptyElement = layout === 'grid' 
                ? $('<div>').addClass('inventory-item').text(emptyText)
                : $('<div>').addClass('inventory-list-item').text(emptyText);
            container.append(emptyElement);
            return;
        }

        let hasItem = false;
        const itemsContainer = layout === 'grid' 
            ? $('<div>').addClass('inventory-grid')
            : $('<div>').addClass('inventory-list');

        sortedEntries.forEach(([key, value]) => {
            if (value && typeof value === 'object' && !Array.isArray(value)) {
                const quantity = Number(e(value['数量'] ?? 1));
                
                hasItem = true;
                
                const itemElement = createItemElement(key, value, {
                    showQuantity,
                    showWeight,
                    showState,
                    showDescription,
                    layout
                });
                
                // 如果数量异常，添加警告样式
                if (quantity <= 0) {
                    itemElement.addClass('abnormal-quantity');
                    // 添加提示信息
                    itemElement.attr('title', `警告：物品数量异常 (${quantity})`);
                }
                
                itemsContainer.append(itemElement);
            }
        });

        if (!hasItem) {
            const emptyElement = layout === 'grid' 
                ? $('<div>').addClass('inventory-item').text(emptyText)
                : $('<div>').addClass('inventory-list-item').text(emptyText);
            itemsContainer.append(emptyElement);
        }

        container.append(itemsContainer);
    } catch (error) {
        console.error('渲染物品时出错:', error);
        container.append($('<div>').text('物品数据解析错误'));
    }
}

// --- 创建单个物品元素（优化嵌套物品显示格式）---
function createItemElement(itemName, itemDetails, options = {}) {
    const {
        showQuantity = true,
        showWeight = true,
        showState = true,
        showDescription = true,
        layout = 'grid',
        showLocation = false,
        forceLocation = false
    } = options;

    const isGrid = layout === 'grid';
    const itemClass = isGrid ? 'inventory-item' : 'inventory-list-item';
    const cell = $('<div>').addClass(itemClass);
    
    // 创建物品名称，根据状态类型添加颜色类
    const nameElement = $('<div>').addClass('item-name').text(itemName);
    
    // 获取状态类型并添加相应的颜色类
    const stateType = textify(itemDetails['状态类型'] ?? '', '').toLowerCase();
    const hasGrowthCycle = itemDetails['生长周期'] !== undefined && 
                           itemDetails['生长周期'] !== null && 
                           itemDetails['生长周期'] !== '';

    if (stateType.includes('新鲜度')) {
        nameElement.addClass('state-freshness');
    } else if (stateType.includes('纯净度')) {
        nameElement.addClass('state-purity');
    } else if (stateType.includes('耐久度')) {
        nameElement.addClass('state-durability');
    } else if (stateType.includes('完整度')) {
        nameElement.addClass('state-completeness');
    } else if (stateType.includes('燃料')) {
        nameElement.addClass('state-fuel');
    } else if (stateType.includes('设施')) {
        nameElement.addClass('state-facility');
    } else if (hasGrowthCycle) {
        // 如果没有状态类型但有生长周期，显示绿色
        nameElement.addClass('state-growth');
    }
    // 其他状态类型保持默认颜色
    
    nameElement.appendTo(cell);

    // 创建属性容器
    const props = $('<div>').addClass('item-props');
    
    // 收集其他属性（在状态之后、描述之前显示）
    const otherProperties = [];
    const nestedContainers = []; // 用于存储嵌套物品容器
    
    // 1. 位置信息（如果存在或强制显示）- 按照要求先显示位置
    if (showLocation) {
        const location = textify(itemDetails['位置'] ?? '', '');
        if (location && location.trim() !== '') {
            const locationLine = $('<div>').addClass('item-prop');
            $('<span>').addClass('prop-key').text('位置').appendTo(locationLine);
            $('<span>').addClass('prop-sep').text(': ').appendTo(locationLine);
            
            const displayValue = textify(location, '');
            const hasNewlines = displayValue.includes('\n');
            const valueElement = $('<span>').addClass('prop-val')
                .text(displayValue)
                .attr('title', displayValue);

            if (hasNewlines) {
                valueElement.addClass('has-indent');
            }

            valueElement.appendTo(locationLine);
            props.append(locationLine);
        }
    }
    
    // 2. 数量 - 总是显示，包括0和负数
    if (showQuantity) {
        const quantity = Number(e(itemDetails['数量'] ?? 1));
        const quantityLine = $('<div>').addClass('item-prop');
        $('<span>').addClass('prop-key').text('数量').appendTo(quantityLine);
        $('<span>').addClass('prop-sep').text(': ').appendTo(quantityLine);
        
        const displayValue = textify(quantity, '');
        const hasNewlines = displayValue.includes('\n');
        const valueElement = $('<span>').addClass('prop-val')
            .text(displayValue)
            .attr('title', displayValue);

        if (hasNewlines) {
            valueElement.addClass('has-indent');
        }

        valueElement.appendTo(quantityLine);
        props.append(quantityLine);
    }

    // === 新增：品质显示 ===
    const quality = itemDetails['品质'];
    if (quality !== undefined && quality !== null && quality !== '') {
        const qualityLine = $('<div>').addClass('item-prop');
        $('<span>').addClass('prop-key').text('品质').appendTo(qualityLine);
        $('<span>').addClass('prop-sep').text(': ').appendTo(qualityLine);
        
        const displayValue = textify(quality, '');
        const hasNewlines = displayValue.includes('\n');
        const valueElement = $('<span>').addClass('prop-val')
            .text(displayValue)
            .attr('title', displayValue);

        if (hasNewlines) {
            valueElement.addClass('has-indent');
        }

        valueElement.appendTo(qualityLine);
        props.append(qualityLine);
    }
    // === 新增结束 ===
    
    // 3. 状态类型和状态值 - 修复显示格式
    if (showState) {
        const stateType = textify(itemDetails['状态类型'] ?? '', '');
        const stateValue = itemDetails['状态'];
        
        // 只有当状态类型和状态值都存在时才显示
        if (stateType && stateValue !== undefined && stateValue !== null && stateValue !== '') {
            const stateLine = $('<div>').addClass('item-prop');
            // 直接显示状态类型作为属性名，状态值作为值
            $('<span>').addClass('prop-key').text(stateType).appendTo(stateLine);
            $('<span>').addClass('prop-sep').text(': ').appendTo(stateLine);
            
            const displayValue = textify(stateValue, '');
            const hasNewlines = displayValue.includes('\n');
            const valueElement = $('<span>').addClass('prop-val')
                .text(displayValue)
                .attr('title', displayValue);

            if (hasNewlines) {
                valueElement.addClass('has-indent');
            }

            valueElement.appendTo(stateLine);
            props.append(stateLine);
        }
    }
    
    // === 新增：处理保质期字段 ===
    const spoilageSpeed = itemDetails['保质期'];
    if (spoilageSpeed !== undefined && spoilageSpeed !== null && spoilageSpeed !== '') {
        const spoilageLine = $('<div>').addClass('item-prop');
        $('<span>').addClass('prop-key').text('保质期').appendTo(spoilageLine);
        $('<span>').addClass('prop-sep').text(': ').appendTo(spoilageLine);
        
        // 计算剩余时间
        let displayText = '';
        
        try {
            // 获取保质期等级和当前状态值
            const shelfLifeLevel = Number(e(spoilageSpeed));
            const currentState = Number(e(itemDetails['状态'] ?? 100));
            
            if (!isNaN(shelfLifeLevel) && !isNaN(currentState)) {
                // 基础腐败速率映射
                const baseSpoilageRateMap = {
                    1: 2.4,
                    2: 0.8,
                    3: 0.35,
                    4: 0.15,
                    5: 0.06
                };
                
                // 温度系数映射
                const getTemperatureCoefficient = (temp) => {
                    if (temp < 0) return 0.1;
                    if (temp >= 0 && temp < 10) return 0.3;
                    if (temp >= 10 && temp < 20) return 0.6;
                    if (temp >= 20 && temp < 30) return 1.0;
                    if (temp >= 30 && temp < 40) return 1.5;
                    return 1.8; // >40°C
                };
                
                // 获取体感温度 - 从全局环境数据中获取
                let temperature = null;
                if (window.currentEnvironment && window.currentEnvironment['体感温度'] !== undefined) {
                    temperature = Number(e(window.currentEnvironment['体感温度']));
                }
                
                // 如果有温度数据，计算剩余时间；否则显示等级描述
                if (temperature !== null && !isNaN(temperature)) {
                    // 获取基础腐败速率
                    const baseRate = baseSpoilageRateMap[shelfLifeLevel] || 1.0;
                    
                    // 获取温度系数
                    const tempCoefficient = getTemperatureCoefficient(temperature);
                    
                    // 计算剩余天数：剩余天数 = 当前状态值 ÷ (基础腐败速率 × 温度系数 × 24)
                    const remainingDays = currentState / (baseRate * tempCoefficient * 24);
                    
                    // 格式化显示
                    if (remainingDays < 1) {
                        // 小于1天，显示小时
                        const hours = Math.round(remainingDays * 24);
                        displayText = `${hours}小时`;
                    } else if (remainingDays <= 30) {
                        // 1-30天，显示天数
                        displayText = `${Math.round(remainingDays)}天`;
                    } else {
                        // 大于30天，显示月数（30天为一个月）
                        const months = (remainingDays / 30).toFixed(1);
                        displayText = `${months}个月`;
                    }
                } else {
                    // 没有温度数据，显示保质期等级的文字描述
                    const levelMapping = {
                        '1': '很短',
                        '2': '较短',
                        '3': '一般',
                        '4': '较长',
                        '5': '很长'
                    };
                    
                    const displayLevel = textify(spoilageSpeed, '');
                    displayText = levelMapping[displayLevel] || displayLevel;
                }
            } else {
                // 如果无法解析等级或状态值，显示原始值
                displayText = textify(spoilageSpeed, '');
            }
        } catch (error) {
            console.error('计算保质期时出错:', error);
            displayText = textify(spoilageSpeed, '');
        }
        
        const hasNewlines = displayText.includes('\n');
        const valueElement = $('<span>').addClass('prop-val')
            .text(displayText)
            .attr('title', displayText);

        if (hasNewlines) {
            valueElement.addClass('has-indent');
        }

        valueElement.appendTo(spoilageLine);
        props.append(spoilageLine);
    }
    // === 新增结束 ===
    
    // 4. 重量
    if (showWeight) {
        const weight = Number(e(itemDetails['重量'] ?? 0));
        if (weight > 0) {
            const weightLine = $('<div>').addClass('item-prop');
            $('<span>').addClass('prop-key').text('重量').appendTo(weightLine);
            $('<span>').addClass('prop-sep').text(': ').appendTo(weightLine);
            
            const displayValue = textify(`${weight}kg`, '');
            const hasNewlines = displayValue.includes('\n');
            const valueElement = $('<span>').addClass('prop-val')
                .text(displayValue)
                .attr('title', displayValue);

            if (hasNewlines) {
                valueElement.addClass('has-indent');
            }

            valueElement.appendTo(weightLine);
            props.append(weightLine);
        }
    }
    
    // 5. 其他属性（排除已处理的，不包括描述）
    Object.entries(itemDetails).forEach(([k, v]) => {
        // 跳过已处理的属性和描述
        if (['数量', '品质', '重量', '状态', '状态类型', '描述', '名称', 'name', '$meta', '位置', '保质期'].includes(k)) return;
        
        // 检查是否为嵌套物品容器（对象且不是数组）
        if (v !== undefined && v !== null && v !== '') {
            if (typeof v === 'object' && !Array.isArray(v)) {
                // 这是一个嵌套物品容器
                nestedContainers.push({key: k, value: v});
            } else {
                // 普通属性
                otherProperties.push({key: k, value: v});
            }
        }
    });
    
    // 6. 显示其他属性（在状态之后，嵌套物品之前）
    otherProperties.forEach(({key, value}) => {
        const line = $('<div>').addClass('item-prop');
        $('<span>').addClass('prop-key').text(String(key)).appendTo(line);
        $('<span>').addClass('prop-sep').text(': ').appendTo(line);
        
        const displayValue = textify(value, '');
        const hasNewlines = displayValue.includes('\n');
        const valueElement = $('<span>').addClass('prop-val')
            .text(displayValue)
            .attr('title', displayValue);

        if (hasNewlines) {
            valueElement.addClass('has-indent');
        }

        valueElement.appendTo(line);
        props.append(line);
    });
    
    // 7. 处理嵌套物品容器（在描述之前）
    nestedContainers.forEach(({key, value}) => {
        // 检查容器是否为空
        const isEmpty = Object.keys(value).length === 0;
        
        if (!isEmpty) {
            // 创建带容器名称的分隔线
            const separator = $('<div>').css({
                'display': 'flex',
                'align-items': 'center',
                'margin': '8px 0',
                'color': 'var(--survival-border)',
                'opacity': '0.8'
            });
            
            // 左边线
            $('<div>').css({
                'flex': '1',
                'border-top': '1px dashed var(--survival-border)',
                'margin-right': '8px'
            }).appendTo(separator);
            
            // 容器名称
            $('<div>').css({
                'white-space': 'nowrap',
                'font-size': '13px',
                'font-weight': 'bold',
                'color': 'var(--survival-accent)'
            }).text(key).appendTo(separator);
            
            // 右边线
            $('<div>').css({
                'flex': '1',
                'border-top': '1px dashed var(--survival-border)',
                'margin-left': '8px'
            }).appendTo(separator);
            
            props.append(separator);
            
            // 处理嵌套物品
            Object.entries(value).forEach(([nestedKey, nestedValue]) => {
                // 检查嵌套物品是否为空对象
                if (nestedValue && typeof nestedValue === 'object' && Object.keys(nestedValue).length === 0) {
                    return; // 跳过空对象
                }
                
                const nestedLine = $('<div>').addClass('item-prop');
                
                // 检查嵌套物品是简单值还是对象
                if (nestedValue && typeof nestedValue === 'object') {
                    // 嵌套物品本身也是一个对象
                    const nestedQuantity = nestedValue['数量'];
                    const nestedWeight = nestedValue['重量'];
                    const nestedFunction = nestedValue['功能'];
                    const nestedDescription = nestedValue['描述'];
                    
                    // 检查是否有嵌套容器（除了基本属性外的对象属性）
                    let hasNestedContainers = false;
                    Object.entries(nestedValue).forEach(([nk, nv]) => {
                        if (typeof nv === 'object' && nv !== null && !Array.isArray(nv) && 
                            !['数量', '重量', '功能', '描述', '状态', '状态类型', '名称', 'name', '$meta', '位置', '保质期'].includes(nk)) {
                            hasNestedContainers = true;
                        }
                    });
                    
                    let displayText = nestedKey;
                    let hasValue = false;
                    
                    // 如果物品本身还有嵌套容器，显示...
                    if (hasNestedContainers) {
                        displayText += ': ...';
                        hasValue = true;
                    } else {
                        // 按照优先级显示：数量 > 重量 > 功能 > 描述
                        if (nestedQuantity !== undefined && nestedQuantity !== null && nestedQuantity !== '') {
                            displayText += `: ${textify(nestedQuantity, '')}`;
                            hasValue = true;
                        } else if (nestedWeight !== undefined && nestedWeight !== null && nestedWeight !== '') {
                            // 格式化重量显示
                            const weightValue = Number(e(nestedWeight));
                            if (weightValue > 0) {
                                displayText += `: ${weightValue}kg`;
                                hasValue = true;
                            }
                        } else if (nestedFunction !== undefined && nestedFunction !== null && nestedFunction !== '') {
                            displayText += `: ${textify(nestedFunction, '')}`;
                            hasValue = true;
                        } else if (nestedDescription !== undefined && nestedDescription !== null && nestedDescription !== '') {
                            // 只取描述的前20个字符，避免过长
                            const shortDesc = textify(nestedDescription, '').substring(0, 20);
                            displayText += `: ${shortDesc}${textify(nestedDescription, '').length > 20 ? '...' : ''}`;
                            hasValue = true;
                        }
                    }
                    
                    // 如果没有数量和重量，但其他属性中有状态，则显示状态值
                    if (!hasValue && !hasNestedContainers) {
                        const nestedState = nestedValue['状态'];
                        if (nestedState !== undefined && nestedState !== null && nestedState !== '') {
                            displayText += `: ${textify(nestedState, '')}`;
                            hasValue = true;
                        }
                    }
                    
                    if (hasValue) {
                        $('<span>').addClass('prop-val').text(displayText).appendTo(nestedLine);
                        props.append(nestedLine);
                    }
                    // 如果没有以上任何属性，则跳过显示这个嵌套物品
                } else if (nestedValue !== undefined && nestedValue !== null && nestedValue !== '') {
                    // 嵌套物品是简单值
                    $('<span>').addClass('prop-val').text(`${nestedKey}: ${textify(nestedValue, '')}`).appendTo(nestedLine);
                    props.append(nestedLine);
                }
            });
            
            // 添加结束分隔线
            const endSeparator = $('<div>').css({
                'border-top': '1px dashed var(--survival-border)',
                'margin': '8px 0',
                'opacity': '0.7'
            });
            props.append(endSeparator);
        } else {
            // 容器为空，显示带容器名称的分隔线和"空"
            const separator = $('<div>').css({
                'display': 'flex',
                'align-items': 'center',
                'margin': '8px 0',
                'color': 'var(--survival-border)',
                'opacity': '0.8'
            });
            
            // 左边线
            $('<div>').css({
                'flex': '1',
                'border-top': '1px dashed var(--survival-border)',
                'margin-right': '8px'
            }).appendTo(separator);
            
            // 容器名称
            $('<div>').css({
                'white-space': 'nowrap',
                'font-size': '13px',
                'font-weight': 'bold',
                'color': 'var(--survival-accent)'
            }).text(key).appendTo(separator);
            
            // 右边线
            $('<div>').css({
                'flex': '1',
                'border-top': '1px dashed var(--survival-border)',
                'margin-left': '8px'
            }).appendTo(separator);
            
            props.append(separator);
            
            const emptyContainerLine = $('<div>').addClass('item-prop');
            $('<span>').addClass('prop-val').text('空').appendTo(emptyContainerLine);
            props.append(emptyContainerLine);
            
            const endSeparator = $('<div>').css({
                'border-top': '1px dashed var(--survival-border)',
                'margin': '8px 0',
                'opacity': '0.7'
            });
            props.append(endSeparator);
        }
    });
    
    // 8. 描述（总是在最后）
    if (showDescription) {
        const description = textify(itemDetails['描述'] ?? '', '');
        if (description) {
            const descLine = $('<div>').addClass('item-prop');
            $('<span>').addClass('prop-key').text('描述').appendTo(descLine);
            $('<span>').addClass('prop-sep').text(': ').appendTo(descLine);
            
            const displayValue = textify(description, '');
            const hasNewlines = displayValue.includes('\n');
            const valueElement = $('<span>').addClass('prop-val')
                .text(displayValue)
                .attr('title', displayValue);

            if (hasNewlines) {
                valueElement.addClass('has-indent');
            }

            valueElement.appendTo(descLine);
            props.append(descLine);
        }
    }
    
    if (props.children().length > 0) {
        cell.append(props);
    }
    
    return cell;
}

