function e(value, parse = true) {
  if (value == null) {
    return '';
  }
  
  // 如果是对象，直接返回（让 textify 处理显示）
  if (typeof value === 'object' && !Array.isArray(value)) {
    return parse ? value : value;
  }
  
  const normalized = normalizeValue(value);
  
  if (Array.isArray(normalized)) {
    const processed = normalized
      .map((item) => {
        if (item && typeof item === 'object') {
          // 如果是对象，直接返回
          return parse ? item : item;
        }
        return e(item, parse);
      })
      .filter((item) => item !== '' && item !== undefined && item !== null);
    
    if (processed.length === 0) {
      return parse ? '' : [];
    }
    
    return parse ? processed : processed;
  }
  
  if (typeof normalized === 'string' && normalized.includes('->')) {
    const match = normalized.match(/(.+)->(.+)\((.+)\)/);
    if (match) {
      const label = match[2].trim();
      return parse ? a(label) : label;
    }
  }
  
  return parse ? a(normalized) : normalized;
}

function a(value) {
  if (typeof value === 'number') {
    return value;
  }
  if (typeof value === 'string') {
    const cleaned = value.replace(/,/g, '');
    const parsed = parseFloat(cleaned);
    if (!Number.isNaN(parsed)) {
      return parsed;
    }
  }
  return value;
}

function isMetaOnlyObject(value) {
  return (
    value &&
    typeof value === 'object' &&
    !Array.isArray(value) &&
    '$meta' in value &&
    Object.keys(value).length === 1
  );
}

function textify(value, fallback = '') {
  const raw = e(value, false);
  
  if (Array.isArray(raw)) {
    // 处理数组：递归处理每个元素
    const list = raw.map((item) => {
      if (item && typeof item === 'object' && !Array.isArray(item)) {
        // 如果是对象，则将其键值对转换为字符串
        return objectToString(item);
      }
      return String(item || '').trim();
    }).filter(Boolean);
    
    return list.length > 0 ? list.join('、') : fallback;
  }
  
  if (raw == null) {
    return fallback;
  }
  
  // 如果是对象但不是数组，转换为键值对字符串
  if (typeof raw === 'object') {
    return objectToString(raw);
  }
  
  const str = String(raw).trim();
  return str || fallback;
}

// 新增：将对象转换为可读字符串的函数
function objectToString(obj, indent = 0) {
  if (!obj || typeof obj !== 'object') {
    return String(obj || '');
  }
  
  if (Array.isArray(obj)) {
    // 如果是数组，显示为逗号分隔的列表
    const items = obj.map(item => {
      if (item && typeof item === 'object') {
        // 对于数组中的对象，递归处理但保持在一行内
        return simpleObjectToString(item);
      }
      return String(item || '');
    }).filter(Boolean);
    
    return items.join('、');
  }
  
  // 如果是普通对象，每行显示一个键值对
  const entries = Object.entries(obj);
  
  if (entries.length === 0) {
    return '';
  }
  
  // 对于简单对象（值都不是对象或数组），每行显示一个属性
  if (entries.every(([_, v]) => 
    !v || 
    (typeof v !== 'object' && !Array.isArray(v)) ||
    (Array.isArray(v) && v.every(item => !item || (typeof item !== 'object' && !Array.isArray(item))))
  )) {
    return entries.map(([k, v]) => {
      if (Array.isArray(v)) {
        const items = v.map(item => String(item || '')).filter(Boolean);
        return `  ${k}: ${items.join('、')}`;
      }
      return `  ${k}: ${v || ''}`;
    }).filter(str => str && !str.endsWith(': ')).join('\n');
  }
  
  // 对于复杂对象，递归处理每个属性
  const parts = entries.map(([k, v]) => {
    let valueStr;
    if (v && typeof v === 'object') {
      valueStr = objectToString(v, indent + 1);
      if (valueStr && valueStr.includes('\n')) {
        // 如果值有多行，添加缩进
        const lines = valueStr.split('\n');
        const indentedLines = lines.map((line, i) => 
          i === 0 ? line : '    ' + line
        );
        valueStr = indentedLines.join('\n');
      }
    } else {
      valueStr = String(v || '');
    }
    
    if (valueStr) {
      return `  ${k}: ${valueStr}`;
    }
    return '';
  }).filter(Boolean);
  
  return parts.join('\n');
}

// 添加辅助函数：简化对象转字符串（用于数组中的对象）
function simpleObjectToString(obj) {
  if (!obj || typeof obj !== 'object') {
    return String(obj || '');
  }
  
  if (Array.isArray(obj)) {
    const items = obj.map(item => simpleObjectToString(item));
    return `[${items.join('、')}]`;
  }
  
  const entries = Object.entries(obj);
  if (entries.length === 0) {
    return '';
  }
  
  return entries.map(([k, v]) => {
    if (v && typeof v === 'object') {
      return `${k}:${simpleObjectToString(v)}`;
    }
    return `${k}:${v || ''}`;
  }).filter(Boolean).join(', ');
}

function toEntries(source) {
  if (source == null) {
    return [];
  }
  const raw = e(source, false);
  if (Array.isArray(raw)) {
    const result = [];
    raw.forEach((item, index) => {
      if (item == null) {
        return;
      }
      if (Array.isArray(item)) {
        item.forEach((nested, nestedIndex) => {
          if (nested == null || isMetaOnlyObject(nested)) {
            return;
          }
          result.push([`${index}-${nestedIndex}`, nested]);
        });
        return;
      }
      if (isMetaOnlyObject(item)) {
        return;
      }
      result.push([String(index), item]);
    });
    return result;
  }
  if (typeof raw === 'object') {
    return Object.entries(raw).filter(([key, value]) => {
      if (key === '$meta') {
        return false;
      }
      if (isMetaOnlyObject(value)) {
        return false;
      }
      return value != null;
    });
  }
  return [['0', raw]];
}

function firstMeaningfulObject(source) {
  if (source && typeof source === 'object' && !Array.isArray(source)) {
    const clone = { ...source };
    delete clone.$meta;
    if (Object.keys(clone).length > 0) {
      return clone;
    }
  }
  const entries = toEntries(source);
  for (const [, value] of entries) {
    if (value && typeof value === 'object' && !Array.isArray(value)) {
      const clone = { ...value };
      delete clone.$meta;
      return clone;
    }
  }
  return {};
}

function ensureValueArray(value) {
  return toEntries(value).map(([, item]) => item);
}
