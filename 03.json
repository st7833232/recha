}

.section-title {
  font-weight: 600;
  margin-bottom: 8px;
  color: var(--survival-accent);
  /* 这里可以添加字体大小，例如： */
  font-size: 15px; /* 设置"任务要求"、"进阶目标"等标题的字体大小 */
}

.target-desc {
  margin-bottom: 8px;
  line-height: 1.4;
  color: var(--survival-text);
  white-space: pre-line;
  word-wrap: break-word;
  /* 这里可以添加字体大小，例如： */
