/* 在现有的CSS中添加以下规则 */

/* 移动端信息项样式 */
.info-item {
  white-space: nowrap;
  font-size: 14px;
  background: rgba(0,0,0,0);
  border: none;
  color: #ffffff;
}

/* 移动端警告行样式 */
.warning-row .info-item {
  color: #f39c12 !important;
  line-height: 1.3;
  white-space: normal;
}

/* 移动端脚本状态项 */
.script-status-item {
  color: var(--survival-accent);
  font-weight: bold;
}

@media (max-width: 480px) {
  .top-info .info-row .row-item {
    display: none; /* 隐藏PC端的行项目 */
  }
  
  /* 移动端布局样式 */
  .top-info {
    flex-direction: column;
    align-items: flex-start;
    padding: 8px 12px; /* 从8px 12px改为4px 8px，减少内边距 */
  }
  
  .top-info .info-stack {
    width: 100%;
  }
  
  .top-info .info-row {
    display: flex;
    gap: 12px;
    margin-bottom: 0px;
    flex-wrap: wrap;
  }
  
  .top-info .info-row.top-info-row--large .info-item {
    font-size: 16px;
    font-weight: 700;
  }
  
  /* 恢复移动端位置显示 */
  .top-info .location-display {
    margin-left: 0;
    margin-top: 0; /* 改为0，移除上边距 */
    width: 100%;
    font-size: 16px;
    font-weight: 700;
    white-space: nowrap;
    text-align: left; /* 左对齐 */
    color: var(--survival-text);
  }
}

@media (min-width: 481px) {
  /* PC端保持不变 */
