// 根據月經週期天數（1-28）返回顯示狀態
function getMenstrualPhase(cycleDay) {
    if (cycleDay === '-' || cycleDay === '?' || cycleDay === '正常' || isNaN(cycleDay)) {
        return '-';
    }
    const day = parseInt(cycleDay);
    if (isNaN(day)) return '-';
    
    if (day >= 1 && day <= 5) return '月經期';
    if (day >= 6 && day <= 9) return '安全期';
    if (day >= 10 && day <= 16) return '危險期';
    if (day >= 17 && day <= 28) return '安全期';
    return '-';
}

// 判斷是否為雙性人（根據數據中的標記）
function isHermaphrodite(beauty) {
    // 方式1：有專門的雙性標記
    if (beauty?.身體特徵?.雙性 === true) return true;
    // 方式2：同時存在女性私處類型和男性陰莖長度
    if (beauty?.身體特徵?.私處?.類型 && beauty?.身體特徵?.陰莖?.長度) return true;
    // 方式3：性特徵描述中包含雙性關鍵字
    const sexFeature = beauty?.身體特徵?.性特徵 || beauty?.身體特徵?.備註 || '';
    if (typeof sexFeature === 'string' && (sexFeature.includes('雙性') || sexFeature.includes('扶他') || sexFeature.includes('futa'))) return true;
    return false;
}

