// 輔助函數
function safeGet(data, defaultValue = '-') {
    if (Array.isArray(data) && data.length > 0) {
        const value = data[0];
        return (value === '' || value === null || value === undefined) ? defaultValue : value;
    }
    return (data === undefined || data === null) ? defaultValue : data;
}

function escapeHtml(str) {
    if (!str) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

// 顯示短暫提示
function showToast(message, isError = false) {
    const toast = $('<div>', {
        class: 'loading-toast',
        text: message,
        css: isError ? { color: '#f87171' } : {}
    });
    $('body').append(toast);
    setTimeout(() => toast.remove(), 1500);
}

// 刷新數據（重新從 MVU 讀取）
async function refreshData() {
    try {
        // 保存當前頁碼
        const currentPage = window.CHARACTER_CONFIG?.currentPage || 0;
        const wasFlipped = {}; // 記錄每個卡片的翻轉狀態
        
        // 記錄當前所有卡片的翻轉狀態
        if (window.CHARACTER_DATA?.characters) {
            for (const charKey of window.CHARACTER_DATA.characters) {
                const cardId = `card-${charKey.replace(/[^a-zA-Z0-9]/g, '_')}`;
                const $card3d = $(`#card-3d-${cardId}`);
                if ($card3d.length) {
                    wasFlipped[charKey] = $card3d.hasClass('flipped');
                }
            }
        }
        
        // 重新讀取數據
        const data = Mvu.getMvuData({ type: 'message', message_id: 'latest' });
        
        if (!data || !data.stat_data) {
            showToast('無法讀取角色數據', true);
            return false;
        }
        
        const statData = data.stat_data;
        let bondsData = statData['同伴'] || {};
        const characters = Object.keys(bondsData).filter(k => k !== '$meta');
        
        if (characters.length === 0) {
            showToast('暫無角色數據', true);
            return false;
        }
        
        // 更新全局數據
        window.CHARACTER_DATA = { characters, bondsData };
        
        // 確保頁碼有效
        if (currentPage >= characters.length) {
            window.CHARACTER_CONFIG.currentPage = Math.max(0, characters.length - 1);
        } else {
            window.CHARACTER_CONFIG.currentPage = currentPage;
        }
        
        // 重新渲染
        renderCurrentPage();
        
        // 恢復翻轉狀態
        setTimeout(() => {
            for (const charKey of characters) {
                const cardId = `card-${charKey.replace(/[^a-zA-Z0-9]/g, '_')}`;
                const $card3d = $(`#card-3d-${cardId}`);
                if ($card3d.length && wasFlipped[charKey]) {
                    $card3d.addClass('flipped');
                }
            }
        }, 100);
        
        showToast('✓ 數據已刷新');
        return true;
    } catch (error) {
        console.error('刷新失敗:', error);
        showToast('刷新失敗', true);
        return false;
    }
}
   
