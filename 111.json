                            <div class="feature-item"><span class="feature-label">胸型</span><span class="feature-value">${escapeHtml(breastShape)}</span></div>
                            <div class="feature-item"><span class="feature-label">乳頭顏色</span><span class="feature-value">${escapeHtml(nippleColor)}</span></div>
                            <div class="feature-item"><span class="feature-label">私處類型</span><span class="feature-value">${escapeHtml(privateType)}</span></div>
                            ` : ''}
                            ${(isMale || isHerm) ? `
                            <div class="feature-item"><span class="feature-label">陰莖長度</span><span class="feature-value">${escapeHtml(penisLength)}</span></div>
                            <div class="feature-item"><span class="feature-label">陰莖粗度</span><span class="feature-value">${escapeHtml(penisGirth)}</span></div>
                            <div class="feature-item"><span class="feature-label">陰莖類型</span><span class="feature-value">${escapeHtml(penisType)}</span></div>
                            ` : ''}
                            ${isHerm ? `
                            <div class="feature-item"><span class="feature-label">⚥ 雙性體質</span><span class="feature-value" style="color: #c084fc;">雌雄同體</span></div>
                            ` : ''}
                        </div>
                    </div>
                                           
                    ${thought ? `<div class="section-block-card"><div class="section-header-card">💭 當前所想</div><div class="thought-bubble-card">${escapeHtml(thought)}</div></div>` : ''}

                    ${performancesHtml && performancesHtml !== '<div class="event-item"><span class="event-name">無</span><span class="event-desc"></span></div>' ? `
                    <div class="section-block-card">
                        <div class="section-header-card">🎬 劇情演出</div>
                        <div class="events-grid" style="max-height: 200px; overflow-y: auto; padding-right: 4px;">
                            ${performancesHtml}
                        </div>
                    </div>
                    ` : ''}

                    <button class="sync-btn" data-action="sync" data-char="${charKey}" data-name="${escapeHtml(name)}">📤 同步到世界書</button>
                </div>
            </div>
            
            <!-- 背面 -->
            <div class="card-face card-face-back">
                <div class="card-content-inner">
                    <div class="card-control-buttons">
                        <div class="card-control-left">
                            <button class="flip-btn" data-action="flip" data-card="${cardId}">🔄 正面</button>
                            <button class="refresh-btn" data-action="refresh" title="刷新數據">🔄 刷新</button>
                        </div>
                    </div>
                    
                    <div class="back-section-title">🔞 性經驗</div>
                    <div class="sex-grid">
                        <div class="sex-item"><span class="sex-label">性經驗等級</span><span class="sex-value">${escapeHtml(sexExpLevel)}</span></div>
                        <div class="sex-item"><span class="sex-label">性行為次數</span><span class="sex-value">${sexCount}次</span></div>
                        <div class="sex-item"><span class="sex-label">性伴侶數量</span><span class="sex-value">${sexPartners}人</span></div>
                        <div class="sex-item"><span class="sex-label">口交經驗</span><span class="sex-value">${escapeHtml(oralExp)}</span></div>
                        <div class="sex-item"><span class="sex-label">肛交經驗</span><span class="sex-value">${escapeHtml(analExp)}</span></div>
                        <div class="sex-item"><span class="sex-label">性幻想對象</span><span class="sex-value">${escapeHtml(firstTimePartner)}</span></div>
                    </div>
                    
                    <div class="back-section-title">💕 性癖好</div>
                    <div class="fetishes-grid">
                        ${fetishesHtml}
                    </div>
                    
                    <div class="back-section-title">⚡ 敏感部位</div>
                    <div class="spots-grid">
                        ${spotsHtml}
                    </div>
                    
                    <div class="back-section-title">📖 背德經歷</div>
                    <div class="events-grid">
                        ${eventsHtml}
                    </div>

                    ${fetishesHtmlForFront && fetishesHtmlForFront !== '暫無' ? `
                    <div class="back-section-title">🎭 性愛人設</div>
                    <div class="thought-bubble-card" style="margin-bottom: 0;">
                        ${fetishesHtmlForFront}
                    </div>
                    ` : ''}
                </div>
            </div>
        </div>
    </div>`;
}

// 渲染頁面
function renderCurrentPage() {
    const { characters, bondsData } = window.CHARACTER_DATA;
    const startIdx = window.CHARACTER_CONFIG.currentPage;
    const currentCharacters = characters.slice(startIdx, startIdx + 1);
    
    const cardsHtml = currentCharacters.map(charKey => {
        const beauty = bondsData[charKey];
        return generateCharacterCard(charKey, beauty);
    }).join('');
    
    const totalPages = characters.length;
    const paginationHtml = totalPages > 1 ? `
        <div class="pagination-controls">
            <button data-action="prev" ${window.CHARACTER_CONFIG.currentPage === 0 ? 'disabled' : ''}>◀ 上一頁</button>
            <span>${window.CHARACTER_CONFIG.currentPage + 1} / ${totalPages}</span>
            <button data-action="next" ${window.CHARACTER_CONFIG.currentPage >= totalPages - 1 ? 'disabled' : ''}>下一頁 ▶</button>
        </div>
    ` : '';
    
    $('#character-content').html(`<div class="cards-grid">${cardsHtml}</div>${paginationHtml}`);
    setupFlipEvents();
}

// 翻轉事件
function setupFlipEvents() {
    $('[data-action="flip"]').off('click').on('click', function() {
        const cardId = $(this).data('card');
        const $card3d = $(`#card-3d-${cardId}`);
        const $wrapper = $(`#${cardId}`);
        
        // 获取当前状态
        const isFlipped = $card3d.hasClass('flipped');
        
        if (isFlipped) {
            // 正在翻回正面：先隐藏背面，显示正面
            $card3d.find('.card-face-back').css('display', 'none');
            $card3d.find('.card-face-front').css('display', 'block');
        } else {
            // 正在翻到背面：先隐藏正面，显示背面
            $card3d.find('.card-face-front').css('display', 'none');
            $card3d.find('.card-face-back').css('display', 'block');
        }
        
        // 切换 class
        $card3d.toggleClass('flipped');
        
        // 获取新显示的面并设置高度动画
        setTimeout(() => {
            const $newFace = $card3d.hasClass('flipped') ? 
                $card3d.find('.card-face-back') : 
                $card3d.find('.card-face-front');
            
            const targetHeight = $newFace.outerHeight();
            if (targetHeight && targetHeight > 0) {
                $wrapper.css('height', targetHeight + 'px');
                
                setTimeout(() => {
                    $wrapper.css('height', '');
                }, 350);
            }
        }, 10);
    });
}

// 主函數
function loadAndDisplay() {
    const data = Mvu.getMvuData({ type: 'message', message_id: 'latest' });
    
    if (!data || !data.stat_data) {
        $('#status-top').html('<div>暫無角色數據</div>').removeClass('hidden');
        return;
    }
    
    const statData = data.stat_data;
    let bondsData = statData['同伴'] || {};
    const characters = Object.keys(bondsData).filter(k => k !== '$meta');
    
    if (characters.length === 0) {
        $('#status-top').html('<div>暫無角色數據</div>').removeClass('hidden');
        return;
    }
    
    window.CHARACTER_DATA = { characters, bondsData };
    renderCurrentPage();
    $('#status-top').addClass('hidden');
}

// 設置自動刷新監聽
function setupAutoRefreshListener() {
    // 方式1：使用 eventSource
    if (typeof eventSource !== 'undefined' && eventSource.on) {
        eventSource.on('MESSAGE_RECEIVED', function() {
            console.log('📨 收到新消息，自動刷新狀態欄...');
            setTimeout(() => {
                refreshData();
            }, 500);
        });
        console.log('✅ 已註冊 MESSAGE_RECEIVED 事件監聽 (eventSource)');
    }
    // 方式2：使用 tavern_events
    else if (typeof eventOn === 'function' && typeof tavern_events !== 'undefined' && tavern_events.MESSAGE_RECEIVED) {
        eventOn(tavern_events.MESSAGE_RECEIVED, function() {
            console.log('📨 收到新消息，自動刷新狀態欄...');
            setTimeout(() => {
                refreshData();
            }, 500);
        });
        console.log('✅ 已註冊 MESSAGE_RECEIVED 事件監聽 (tavern_events)');
    }
    // 方式3：使用輪詢模式（備用方案）
    else {
        console.log('⚠️ 事件系統不可用，使用輪詢模式...');
        let lastHash = '';
        setInterval(() => {
            try {
                const data = Mvu.getMvuData({ type: 'message', message_id: 'latest' });
                if (data && data.stat_data) {
                    const currentHash = JSON.stringify(data.stat_data);
                    if (currentHash !== lastHash) {
                        lastHash = currentHash;
                        console.log('🔄 檢測到數據變化，自動刷新...');
                        refreshData();
                    }
                }
            } catch(e) {}
        }, 3000);
    }
}

// 初始化
function initialize() {
    console.log('初始化狀態欄...');
    
    $('#character-status').remove();
    const container = $('<div>', { id: 'character-status', class: 'character-container' });
    const statusTop = $('<div>', { id: 'status-top', class: 'status-top', html: '<div>加載中...</div>' });
    const contentArea = $('<div>', { id: 'character-content', class: 'character-content' });
    container.append(statusTop, contentArea);
    $('body').prepend(container);
    
    let attempts = 0;
    const checkMvu = setInterval(() => {
        attempts++;
        const mvuExists = typeof Mvu !== 'undefined' || (window.parent && window.parent.Mvu);
        
        if (mvuExists) {
            clearInterval(checkMvu);
            if (window.parent && window.parent.Mvu && typeof Mvu === 'undefined') {
                window.Mvu = window.parent.Mvu;
            }
            loadAndDisplay();
            
            // ========== 在這裡註冊自動刷新監聽 ==========
            setupAutoRefreshListener();
            // ==========================================
            
        } else if (attempts > 20) {
            clearInterval(checkMvu);
            $('#status-top').html('<div>MVU框架加載失敗</div>');
        }
    }, 500);
    
    // 事件委托
    $('#character-status').on('click', '[data-action]', async function(e) {
        const action = $(this).data('action');
        
        if (action === 'prev' && window.CHARACTER_CONFIG.currentPage > 0) {
            window.CHARACTER_CONFIG.currentPage--;
            renderCurrentPage();
        } 
        else if (action === 'next') {
            const total = window.CHARACTER_DATA?.characters?.length || 0;
            if (window.CHARACTER_CONFIG.currentPage < total - 1) {
                window.CHARACTER_CONFIG.currentPage++;
                renderCurrentPage();
            }
        }
        else if (action === 'refresh') {
            const $btn = $(this);
            $btn.addClass('refreshing');
            try {
                await refreshData();
            } finally {
                setTimeout(() => {
                    $btn.removeClass('refreshing');
                }, 600);
            }
        }
        else if (action === 'sync') {
            const charKey = $(this).data('char');
            const $btn = $(this);
            const beauty = window.CHARACTER_DATA?.bondsData?.[charKey];
            
            if (!beauty) {
                if (typeof toastr !== 'undefined') toastr.error('找不到角色數據');
                return;
            }
            
            $btn.addClass('syncing').prop('disabled', true);
            try {
                await syncToWorldbook(charKey, beauty);
            } finally {
                setTimeout(() => {
                    $btn.removeClass('syncing').prop('disabled', false);
                }, 1000);
            }
        }
    });
}

$(document).ready(() => initialize());