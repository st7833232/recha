  async function calculateActualGrowthDays(t, cropName, baseGrowthDays) {
    const e = t.stat_data ?? {};
    let totalPercentageBonus = 0;
    
    if (DEBUG_MODE) {
      console.log('[計算系統] 🌱 計算', cropName, '生長加成 (基礎:', baseGrowthDays, '天)');
    }
    
    const currentSeason = a().get(e, '環境.季節');
    const seasonBonus = getSeasonGrowthBonus(currentSeason);
    totalPercentageBonus += seasonBonus;
    
    if (DEBUG_MODE) {
      console.log('[計算系統] 📅 季節加成 (', currentSeason, '):', seasonBonus, '%');
    }
    
    const crops = a().get(e, '作物');
    if (a().isPlainObject(crops)) {
      for (const [otherCropName, otherCropData] of Object.entries(crops)) {
        if (otherCropName.startsWith('$') || !a().isPlainObject(otherCropData) || otherCropName === cropName) continue;
        
        const cropBonus = extractCropBonusFromObject(otherCropData);
        if (cropBonus > 0) {
          totalPercentageBonus += cropBonus;
          if (DEBUG_MODE) {
            console.log('[計算系統] 🌿', otherCropName, '全局作物加成:', cropBonus, '%');
          }
        }
      }
    }
    
    const companions = a().get(e, '同伴');
    const companionBonus = extractCropBonusFromCompanionItems(companions);
    if (companionBonus > 0) {
      totalPercentageBonus += companionBonus;
      if (DEBUG_MODE) {
        console.log('[計算系統] 👥 同伴攜帶物品作物加成:', companionBonus, '%');
      }
    }
    
    if (DEBUG_MODE) {
      console.log('[計算系統] 📊', cropName, '總加成:', totalPercentageBonus, '%');
    }
    
    let actualGrowthDays;
    
    if (totalPercentageBonus <= 0) {
      actualGrowthDays = baseGrowthDays;
      if (DEBUG_MODE) {
        console.log('[計算系統] 📅', cropName, '實際生長天數:', actualGrowthDays, '天 (無加成)');
      }
    } else if (totalPercentageBonus <= 50) {
      const reducedDays = Math.floor(baseGrowthDays * (totalPercentageBonus / 100));
      actualGrowthDays = Math.max(1, baseGrowthDays - reducedDays);
      if (DEBUG_MODE) {
        console.log('[計算系統] 📅', cropName, '實際生長天數:', actualGrowthDays, '天 (減少', reducedDays, '天)');
      }
    } else {
      const growthMultiplier = 1 + (totalPercentageBonus / 100);
      actualGrowthDays = Math.max(1, Math.floor(baseGrowthDays / growthMultiplier));
      const reducedDays = baseGrowthDays - actualGrowthDays;
      if (DEBUG_MODE) {
        console.log('[計算系統] 📅', cropName, '實際生長天數:', actualGrowthDays, '天 (除以', growthMultiplier.toFixed(2), ', 減少', reducedDays, '天)');
      }
    }
    
    return actualGrowthDays;
  }

function calculateGrowthStage(cropData, currentDay, actualGrowthDays) {
  const plantedDay = v(cropData.種植日期, 0);
  const growthCycle = v(cropData.成長週期, 0);
   
  const hasBonus = extractCropBonusFromObject(cropData) > 0;
  const isSpecialCrop = growthCycle < 0 || hasBonus;
  
  const growthDays = currentDay - plantedDay;
  
  if (isSpecialCrop) {
    return '特殊作物';
  }
  
  const growthProgress = Math.min(100, Math.round((growthDays / actualGrowthDays) * 100));
  
  if (growthProgress < 30) {
    return '幼苗期';
  } else if (growthProgress < 60) {
    return '生長期';
  } else if (growthProgress < 100) {
    return '熟成期';
  } else {
    return '可收割';
  }
}

  async function updateCropGrowthStages(t) {
    let updated = false;
    const e = t.stat_data ?? {};
    const currentDay = v(a().get(e, '系統.經過天數'), 0);
    const currentSeason = a().get(e, '環境.季節');
    const crops = a().get(e, '作物');
    
    if (DEBUG_MODE) {
      console.log('[計算系統] 📅 更新作物生長階段 - 當前天數:', currentDay, ', 季節:', currentSeason);
    }
    
    if (!a().isPlainObject(crops)) {
      if (DEBUG_MODE) {
        console.log('[計算系統] ⚠️ 沒有找到作物數據');
      }
      return false;
    }
    
    for (const [cropName, cropData] of Object.entries(crops)) {
      if (cropName.startsWith('$')) continue;
      if (!a().isPlainObject(cropData)) continue;
      
      const growthCycle = v(cropData.成長週期, 0);
      const plantedDay = v(cropData.種植日期, 0);
      
      if (plantedDay <= 0) {
        if (DEBUG_MODE) {
          console.log('[計算系統] 🌱', cropName, ': 未種植');
        }
        continue;
      }
      
      const growthDays = currentDay - plantedDay;
      if (DEBUG_MODE) {
        console.log('[計算系統] 🌱', cropName, ': 種植第', growthDays, '天 (種植日:', plantedDay, ')');
      }
      
      let actualGrowthDays = Math.abs(growthCycle);
      
      if (growthCycle > 0) {
        actualGrowthDays = await calculateActualGrowthDays(t, cropName, growthCycle);
      }
      
      const currentStage = calculateGrowthStage(cropData, currentDay, actualGrowthDays);
      const stagePath = `作物.${cropName}.生長階段`;
      const currentStageInData = a().get(e, stagePath);

      if (growthCycle > 0 && plantedDay > 0) {
        const maturityDay = plantedDay + actualGrowthDays;
        const harvestDatePath = `作物.${cropName}.收成日期`;
        
        const currentHarvestDate = a().get(e, harvestDatePath);
        if (currentHarvestDate !== maturityDay) {
          if (DEBUG_MODE) {
            console.log('[計算系統] 📅', cropName, ': 舊收成日', currentHarvestDate, '-> 新收成日', maturityDay);
          }
          await Mvu.setMvuVariable(t, harvestDatePath, Number(maturityDay), { reason: '修正收成日期' });
          a().set(e, harvestDatePath, maturityDay);
          updated = true;
        }
      }

      if (currentStage !== currentStageInData) {
        if (DEBUG_MODE) {
          console.log('[計算系統] 🔄', cropName, ':', currentStageInData || '無', '->', currentStage);
        }
        await Mvu.setMvuVariable(t, stagePath, String(currentStage), { reason: '作物生長階段更新' });
        a().set(e, stagePath, currentStage);
        updated = true;
        
        if (currentStage === '可收割' && !a().get(e, `作物.${cropName}.已成熟`)) {
          await Mvu.setMvuVariable(t, `作物.${cropName}.已成熟`, true, { reason: '作物成熟標記' });
          a().set(e, `作物.${cropName}.已成熟`, true);
        }
      }
    }
    
    return updated;
  }

