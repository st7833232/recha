  # 進階獎勵: 字符串，完成進階目標的獎勵描述,根據<模擬規則>中的任務獎勵規則生成具體的獎勵。比如'奇蹟點數：10'、'劇情演出-貓娘會在你睡覺的時候主動侍寢'、'口紅x1'、'貓娘智力等級+1'、'貓娘學會新技能"烹飪調理"'。

營地: # 物件，一個可擴展的物件，以營地名稱或標識爲鍵，記錄角色建立的營地信息。新增格式: '營地名稱': { "基本資料":{"位置": "營地位置", "樣式": "樣式描述","舒適度": 0 }, "物品": {"營地內的物品列表"},"食材": {"營地內的食材列表"}, "醫藥": {"營地內的草藥、醫學用品、藥品列表"}, "材料": {"營地內的材料列表"}, "牲畜": {"營地內的牲畜列表"}, "設施": {"營地內的設施列表"}, "奇物": {"營地內的奇物列表"},  "武器/陷阱": {"營地內的武器/陷阱列表"}}
  {"楓葉潭營地":{"物品":{"碳纖維釣竿":{"數量":1,"耐久度":100,"重量":1,"描述":"高品質釣竿，極大提升釣魚成功率。"},"漁夫的工具包":{"數量":1,"耐久度":100,"重量":0.3,"描述":"包含了一卷堅韌的魚線、幾個骨制魚鉤和一些羽毛擬餌。"},"淨水藥片":{"數量":50,"耐久度":100,"重量":0.1,"描述":"每片可淨化1升水。"},"防風打火機":{"數量":1,"耐久度":100,"重量":0.1,"描述":"惡劣天氣下也能點火。","狀態類型":"耐久度"},"大容量保溫瓶":{"數量":1,"耐久度":100,"重量":0.7,"描述":"可以裝1.5升水並長時間保溫。"},"雙筒望遠鏡":{"數量":1,"耐久度":100,"重量":0.6,"描述":"可以觀察遠處的情況。"},"睡袋":{"數量":1,"耐久度":100,"重量":1.5,"描述":"提供保暖和舒適的睡眠環境。"},"太陽能電池":{"數量":1,"耐久度":100,"重量":1,"描述":"可以用來給電子設備充電。"},"木製引流槽":{"數量":8,"描述":"由楓木製成的U型引流槽，用於收集楓糖漿。","狀態類型":"耐久度","狀態":100},"精煉鹽":{"數量":20.1,"重量":0.9,"狀態類型":"純淨度","狀態":80,"描述":"經過初步提純的鹽，可以用於烹飪和食物防腐。"},"家人陶偶組":{"數量":1,"描述":"一組代表著這個家的所有成員（阿彬、珠世、娜莉、艾拉瑞亞、窩窩頭、露娜一家、玉藻）的可愛陶偶，象徵著家人的團結。","狀態類型":"耐久度","狀態":100},"永動研磨器":{"數量":1,"狀態類型":"耐久度","狀態":100,"重量":1.2,"描述":"一個來自鍊金術師工坊的奇妙造物。無需任何動力，只要轉動手柄，它就能將任何投入其中的物品（硬度不超過鑽石）研磨成極其細膩的粉末。據說，用它研磨出的香料，風味會提升三倍。"},"萬物有靈·食譜篇":{"數量":1,"狀態類型":"耐久度","狀態":100,"重量":2.5,"描述":"一本記錄了無數世界、無數種族奇特料理的魔法食譜。它能自動感應使用者擁有的食材，並在書頁上浮現出對應的最佳烹飪方案。按照食譜製作出的料理，不僅美味絕倫，更有機率附加各種神奇的增益效果。","特殊能力":"翻到食譜的最後一頁，消耗100點生存點數，可以指定一種已有的食材，食譜將會創造出一道前所未見的「神之料理」配方。"},"破損的漁網":{"數量":3,"狀態類型":"耐久度","狀態":40,"重量":5,"描述":"幾張破損嚴重的大型漁網，修補後可用於大規模捕撈。"},"熊筋繩":{"數量":0.9,"狀態類型":"耐久度","狀態":100,"重量":9.9,"描述":"一條由熊筋、狼筋和奇特彈性纖維混合編織而成的十米長繩，極度堅韌。"},"簡易油燈":{"數量":1,"狀態類型":"耐久度","狀態":100,"重量":0.5,"描述":"由林檎製作的簡易陶碗油燈，用熊油作為燃料，可以提供穩定的照明。"},"可食性植物百科全書":{"數量":1,"耐久度":100,"重量":1,"描述":"記錄了地球上多種可食用植物，但在異世界似乎用處不大。"},"矮人王的手札":{"數量":1,"狀態類型":"耐久度","狀態":100,"重量":0.8,"描述":"記載著矮人王艾格絕筆的皮質手札。"},"龍鱗通訊器":{"數量":1,"狀態類型":"耐久度","狀態":100,"重量":0.1,"描述":"伊西莉亞的龍鱗，對著它說話，她就能聽見。似乎對閃亮的東西和美食有特殊反應。"},"莉諾爾的研究筆記":{"數量":1,"狀態類型":"耐久度","狀態":100,"重量":0.8,"描述":"一本由柔軟樹皮製成的厚重筆記，裡面密密麻麻地記錄著莉諾爾關於植物、魔法和人體改造的研究心得。"},"醫師袍":{"數量":1,"狀態類型":"耐久度","狀態":100,"重量":0.8,"描述":"由娜莉親手縫製的白色麻布醫師袍，剪裁合身，雖然樸素但非常潔淨。"},"天然酵母（老麵）":{"數量":1,"重量":0.5,"狀態類型":"新鮮度","狀態":100,"描述":"一塊由野果和空氣中的微生物培養而成的活性酵母麵糰，是釀造和發酵的關鍵。"},"向導石":{"數量":1,"狀態類型":"耐久度","狀態":100,"重量":0.5,"描述":"一塊內部仿佛有星光流轉的奇特石頭，伊西莉亞所贈，似乎能指引方向，找到蘊含鹽分的礦物。"},"鹽晶核心碎片":{"數量":1,"狀態類型":"純淨度","狀態":100,"重量