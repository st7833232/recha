  {"防風打火機":{"數量":1,"耐久度":100,"重量":0.1,"描述":"惡劣天氣下也能點火。"},"多功能時空控制器-小黑板":{"數量":1,"耐久度":100,"重量":1.2,"描述":"一個來源成謎的黑色平板，似乎是某種高科技造物。能顯示使用者狀態。","能力1":"可使用對應的點數實施抽卡，生存抽卡隨機獲得材料、奇蹟抽卡功能隨機獲得成品","能力2":"可以在其中使用『設計編輯』的功能","能力3":"可使用100點生存點數執行一次『荒野世界查詢』功能"},"木雕雨燕":{"數量":1,"狀態類型":"耐久度","狀態":100,"重量":0.1,"描述":"一個由阿彬親手雕刻的雨燕木雕，栩栩如生。"},"指針式礦物探測儀":{"數量":1,"狀態類型":"耐久度","狀態":100,"重量":3.5,"描述":"古老的鍊金術與地質學結合的產物。手動搖動搖柄為其充能後將少量目標礦物樣本放入儀器側面的凹槽內，天線將會指向距離最近同類型礦物密度最高的區域。注意：探測範圍有限（約10公里），且極易受到強磁場或魔法能量干擾。"},"多功能工兵鏟":{"數量":1,"狀態類型":"耐久度","狀態":100,"重量":1.8,"描述":"伐木、挖掘和防身的最佳伴侶。","加值":{"挖掘":15,"伐木":15}}}
 # 數量: 物品數量
