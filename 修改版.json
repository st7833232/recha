  主線: {"標題":"生命之源：阿基米德的呼喚","描述":"穩定的水源是文明的基石。在慧音的指導下，建造一套可靠的引水與儲水系統，將徹底解決營地的飲水與灌溉問題，為未來的發展奠定堅實的基礎。","狀態":"進行中","完成情況":{"基礎要求完成":false,"進階目標完成":false},"結算狀態":{"基礎獎勵已發放":false,"進階獎勵已發放":false},"區域限制":"","開始時間":"第52天 20:00","結束時間":"第82天 20:00","任務要求":{"基礎要求1":{"描述":"在設計組的規劃下，確定引水渠的路線與水塔的建造位置。","進度":1,"目標":1,"類型":"布爾","已完成":true},"基礎要求2":{"描述":"成功製造出一台可用的基礎手搖式「阿基米德螺旋泵」。","進度":0,"目標":1,"類型":"布爾","已完成":false}},"進階目標":{"進階要求1":{"描述":"建造一個容量不小於500升的磚石結構儲水塔。","進度":0,"目標":1,"類型":"布爾","已完成":false},"進階要求2":{"描述":"成功利用水車驅動螺旋泵，實現自動提水。","進度":0,"目標":1,"類型":"布爾","已完成":false}},"基礎獎勵":"生存點數x50","進階獎勵":"奇蹟點數x30，營地舒適度+10"} # 當前的主線任務，引導玩家生存，有且只有一個，空缺時立即生成新的任務
  支線: {"標題":"廣廈的願景","描述":"隨著家人的增多，單層木屋和零散的臥室已無法滿足需求。一座堅固、寬敞、能容納所有家人的雙層磚木混合結構建築，將是營地邁向真正“家園”的里程碑。","狀態":"進行中","完成情況":{"基礎要求完成":false,"進階目標完成":false},"結算狀態":{"基礎獎勵已發放":false,"進階獎勵已發放":false},"區域限制":"","開始時間":"第50天 02:18","結束時間":"第80天 02:18","任務要求":{"基礎要求1":{"描述":"燒製500塊紅磚用於新建築。","進度":500,"目標":500,"類型":"數值","已完成":true},"基礎要求2":{"描述":"在林徽因和慧音的共同規劃下，完成新建築的地基與一樓主體結構。","進度":0.1,"目標":1,"類型":"布爾","已完成":false}},"進階目標":{"進階要求1":{"描述":"設計並建造一個包含室內樓梯的二層結構。","進度":0,"目標":1,"類型":"布爾","已完成":false},"進階要求2":{"描述":"為新建築建立基礎的排水系統。","進度":0,"目標":1,"類型":"布爾","已完成":false}},"基礎獎勵":"生存點數x50","進階獎勵":"奇蹟點數x30，營地舒適度+20"} # 當前的支線任務，引導玩家進行各種挑戰，有且只有一個，空缺時立即生成新的任務
  日常: {} # 當前的日常任務，每天可做一次的簡單任務，穩定的生存點數來源，只有一個
  羈絆: {"珠世":{},"露娜":{},"窩窩頭":{},"玉藻":{},"娜莉":{},"伊西莉亞":{},"龍飛":{},"林檎":{},"林徽因":{},"李招招":{},"燼":{},"上白澤慧音":{},"藤原妹紅":{}} # 物件，一個可擴充套件的物件，以同伴(寵物)名為鍵，用於記錄每位同伴(寵物)的羈絆任務，有幾位同伴(寵物)就有幾個。
