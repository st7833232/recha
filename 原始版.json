    infoLog('手動更新所有作物...');
    
    if (!Mvu || !Mvu.getCurrentContext) {
      errorLog('Mvu 未載入或缺少 getCurrentContext 方法');
      return;
    }
    
    try {
      const context = Mvu.getCurrentContext();
      if (!context) {
        errorLog('無法獲取當前上下文');
        return;
      }
      
      if (window._checkCropGrowth) {
        const updated = await window._checkCropGrowth(context);
        if (updated) {
          infoLog('作物已更新');
          if (Mvu.replaceMvuData) {
            await Mvu.replaceMvuData(context, { type: 'message', message_id: 'latest' });
          }
        } else {
          infoLog('無需更新');
        }
      } else {
        errorLog('內部函數 _checkCropGrowth 未載入');
      }
    } catch (error) {
      errorLog('手動更新失敗:', error);
    }
  };

