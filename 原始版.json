  class DualTimeSystem {
    constructor() {
      this.PATHS = {
        currentTime: '系統.當前時間',
        previousTime: '系統.前次時間',
        currentDay: '系統.經過天數',
        previousDay: '系統.前次天數'
      };
      this.initialized = false;
      debugLog('雙時間系統初始化完成');
    }
    
    async initializeTimePaths(context) {
      if (this.initialized) return;
      
      const data = context.stat_data ?? {};
      
      try {
        if (!a().has(data, this.PATHS.previousTime)) {
          const currentTime = a().get(data, this.PATHS.currentTime) || '06:00';
          await this.setMvuVariable(context, this.PATHS.previousTime, currentTime, '初始化前次時間');
          debugLog('前次時間路徑初始化完成');
        }
        
        if (!a().has(data, this.PATHS.previousDay)) {
          const currentDay = v(a().get(data, this.PATHS.currentDay), 0);
          await this.setMvuVariable(context, this.PATHS.previousDay, currentDay, '初始化前次天數');
          debugLog('前次天數路徑初始化完成');
        }
        
        this.initialized = true;
      } catch (error) {
        errorLog('初始化時間路徑失敗:', error);
      }
    }
    
    async setMvuVariable(context, path, value, reason) {
      try {
        const success = await Mvu.setMvuVariable(context, path, value, { reason: reason || '雙時間系統' });
        if (success) {
          a().set(context.stat_data, path, value);
        }
        return success;
      } catch (error) {
        errorLog(`設置變量失敗 ${path}:`, error);
        return false;
      }
    }
    
    async updatePreviousTime(context, currentTime) {
      try {
        const data = context.stat_data ?? {};
        const currentDay = v(a().get(data, this.PATHS.currentDay), 0);
        
        const timeSuccess = await this.setMvuVariable(
          context,
          this.PATHS.previousTime,
          currentTime,
          '更新前次時間記錄'
        );
        
        const daySuccess = await this.setMvuVariable(
          context,
          this.PATHS.previousDay,
          currentDay,
          '更新前次天數記錄'
        );
        
        if (timeSuccess && daySuccess) {
          debugLog(`更新時間記錄: ${currentTime}(天${currentDay})`);
        }
        
        return timeSuccess && daySuccess;
      } catch (error) {
        errorLog('更新前次時間失敗:', error);
        return false;
      }
    }
    
    isLikelyDayPass(previousMinutes, currentMinutes) {
      return previousMinutes > currentMinutes;
    }
    
    isTimeSame(time1, time2) {
      if (!time1 || !time2) return false;
      return this.normalizeTime(time1) === this.normalizeTime(time2);
    }
    
    shouldDayActuallyPass(previousMinutes, currentMinutes) {
      if (previousMinutes > currentMinutes) {
        return true;
      }
      
      const timeDiff = currentMinutes - previousMinutes;
      if (timeDiff >= 1440) {
        return true;
      }
      
      const minutesToMidnight = 1440 - previousMinutes;
      if (timeDiff >= minutesToMidnight) {
        return true;
      }
      
      return false;
    }
    
    normalizeTime(timeString) {
      if (typeof timeString !== 'string') return null;
      
      const trimmed = timeString.trim();
      const match = trimmed.match(/^(\d{1,2}):(\d{1,2})$/);
      if (!match) return null;
      
      const hours = parseInt(match[1], 10);
      const minutes = parseInt(match[2], 10);
      
      if (hours < 0 || hours > 23 || minutes < 0 || minutes > 59) {
        return null;
      }
      
      return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}`;
    }
    
    addOneMinute(timeString) {
      const normalized = this.normalizeTime(timeString);
      if (!normalized) return '00:01';
      
      const [hoursStr, minutesStr] = normalized.split(':');
      let hours = parseInt(hoursStr, 10);
      let minutes = parseInt(minutesStr, 10);
      
      minutes += 1;
      
      if (minutes >= 60) {
        minutes = minutes % 60;
        hours += 1;
      }
      
      if (hours >= 24) {
        hours = hours % 24;
      }
      
      return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}`;
    }
    
    async verifyTime(context) {
      try {
        const data = context.stat_data ?? {};
        await this.initializeTimePaths(context);
        
        const currentTime = a().get(data, this.PATHS.currentTime) || '06:00';
        const previousTime = a().get(data, this.PATHS.previousTime) || currentTime;
        const currentDay = v(a().get(data, this.PATHS.currentDay), 0);
        const previousDay = v(a().get(data, this.PATHS.previousDay), 0);
        
        const currentMinutes = h(currentTime);
        const previousMinutes = h(previousTime);
        
        if (currentMinutes === null || previousMinutes === null) {
          warnLog('時間格式無效，跳過檢查');
          await this.updatePreviousTime(context, currentTime);
          return { shouldFix: false, reason: 'invalid_time' };
        }
        
        debugLog(`時間對比: 前次=${previousTime}(天${previousDay}) → 當前=${currentTime}(天${currentDay})`);
        debugLog(`時間差: ${currentMinutes - previousMinutes}分鐘`);
        
        let result;
        
        if (this.isTimeSame(currentTime, previousTime)) {
          result = await this.handleTimeUnchanged(context, currentTime, currentDay, previousTime);
        } else if (currentMinutes > previousMinutes) {
          result = await this.handleTimeForward(
            context, 
            currentTime, currentDay, currentMinutes,
            previousTime, previousDay, previousMinutes
          );
        } else if (currentMinutes < previousMinutes) {
          result = await this.handleTimeBackward(
            context, 
            currentTime, currentDay, currentMinutes,
            previousTime, previousDay, previousMinutes
          );
        } else {
          result = { shouldFix: false, reason: 'unknown_time_state' };
        }
        
        await this.updatePreviousTime(context, currentTime);
        
        return result;
        
      } catch (error) {
        errorLog('verifyTime錯誤:', error);
        try {
          const data = context.stat_data ?? {};
          const currentTime = a().get(data, this.PATHS.currentTime) || '06:00';
          await this.updatePreviousTime(context, currentTime);
        } catch (e) {}
        return { shouldFix: false, reason: 'error' };
      }
    }
    
    async handleTimeForward(context, currentTime, currentDay, currentMinutes, previousTime, previousDay, previousMinutes) {
      try {
        debugLog(`時間前進: ${previousTime} → ${currentTime}`);
        
        const timeDiff = currentMinutes - previousMinutes;
        const shouldDayPass = this.shouldDayActuallyPass(previousMinutes, currentMinutes);
        const expectedDay = previousDay + (shouldDayPass ? 1 : 0);
        
        debugLog(`跨日分析: 應該跨日=${shouldDayPass ? '是' : '否'}, 期望天數=${expectedDay}`);
        
        if (currentDay === expectedDay) {
          debugLog(`天數正確: ${previousDay} → ${currentDay} (${shouldDayPass ? '已跨日' : '未跨日'})`);
          return { shouldFix: false, reason: 'normal_progress' };
        }
        
        warnLog(`天數錯誤: 當前=${currentDay}, 期望=${expectedDay}`);
        
        const success = await this.setMvuVariable(
          context,
          this.PATHS.currentDay,
          expectedDay,
          `修正天數錯誤（時間前進${timeDiff}分鐘）`
        );
        
        if (success) {
          debugLog(`已修正天數: ${currentDay} → ${expectedDay}`);
          return { shouldFix: true, reason: 'fixed_day_mismatch' };
        } else {
          warnLog(`修正天數失敗`);
          return { shouldFix: false, reason: 'fix_failed' };
        }
        
      } catch (error) {
        errorLog('handleTimeForward錯誤:', error);
        return { shouldFix: false, reason: 'error' };
      }
    }
    
    async handleTimeBackward(context, currentTime, currentDay, currentMinutes, previousTime, previousDay, previousMinutes) {
      try {
        debugLog(`時間回退檢測: ${previousTime} → ${currentTime}`);
        
        const expectedDay = previousDay + 1;
        
        debugLog(`檢測到跨日時間回退: 時間 ${previousTime}→${currentTime}, 天數應從 ${previousDay} → ${expectedDay}`);
        
        if (currentDay === expectedDay) {
          debugLog(`天數已正確更新: ${previousDay}→${currentDay}`);
          return { shouldFix: false, reason: 'normal_day_pass' };
        }
        
        debugLog(`修正跨日天數: ${currentDay} → ${expectedDay}`);
        
        const success = await this.setMvuVariable(
          context,
          this.PATHS.currentDay,
          expectedDay,
          '修正跨日天數'
        );
        
        if (success) {
          return { shouldFix: true, reason: 'fixed_day_pass' };
        } else {
          return { shouldFix: false, reason: 'fix_failed' };
        }
        
      } catch (error) {
        errorLog('handleTimeBackward錯誤:', error);
        return { shouldFix: false, reason: 'error' };
      }
    }
    
    async handleTimeUnchanged(context, currentTime, currentDay, previousTime) {
      try {
        debugLog('時間未變化');
        
        let newTime = currentTime;
        let reason = 'time_unchanged';
        let shouldFix = false;
        
        const normalizedCurrent = this.normalizeTime(currentTime);
        
        if (normalizedCurrent === '00:00') {
          newTime = '00:05';
          debugLog('檢測到00:00時間，自動修正為00:05');
          reason = 'fixed_00:00_to_00:05';
          shouldFix = true;
        } else if (previousTime && this.isTimeSame(currentTime, previousTime)) {
          newTime = this.addOneMinute(currentTime);
          debugLog(`檢測到重複時間：${previousTime} → ${currentTime}，自動+1分鐘：${newTime}`);
          reason = 'fixed_repeated_time';
          shouldFix = true;
        }
        
        if (shouldFix && newTime !== currentTime) {
          const success = await this.setMvuVariable(
