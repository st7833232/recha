// ==================== 配置設定 ====================
const TASK_DEBUG = true; // 設為 true 開啟詳細日誌，false 只顯示重要日誌

// ==================== 日誌系統 ====================
function debugLog(...args) {
    if (TASK_DEBUG) {
        console.log('[任務調試]', ...args);
    }
}

function infoLog(...args) {
    console.log('[任務系統]', ...args);
}

function warnLog(...args) {
    console.warn('[任務警告]', ...args);
}

function errorLog(...args) {
    console.error('[任務錯誤]', ...args);
}

// ==================== 任務保護系統 ====================
infoLog('🚀 任務管理系統初始化中...');

(function(){
    if(window._taskProtectionFinal) {
        infoLog('🛡️ 任務保護系統已啟用，跳過重複初始化');
        return;
    }
    
    function initTaskProtection(){
        if(typeof _ == 'undefined'){
            debugLog('等待 _ 模組加載...');
            setTimeout(initTaskProtection, 100);
            return;
        }
        
        infoLog('✅ 任務保護系統已啟用');
        debugLog('任務保護系統開始初始化...');
        
        const originalSet = _.set;
        const originalAdd = _.add;
        const originalUnset = _.unset;
        const originalRemove = _.remove;
        const originalOmit = _.omit;
        const originalAssign = _.assign;
        const originalGet = _.get;
        
        const debounceMap = new Map();
        const debouncePeriod = 30000;
        
        function shouldBlockOperation(path, errorMessage){
            const now = Date.now();
            const lastCall = debounceMap.get(path);
            
            if(lastCall && now - lastCall < debouncePeriod){
                debugLog(`操作被防抖: ${path}`);
                debounceMap.set(path, now);
                return false;
            }
            
            warnLog(errorMessage);
            debounceMap.set(path, now);
            return true;
        }
        
        function isTaskPath(path){
            return typeof path == 'string' && 
                  (path == '任務' || path.startsWith('任務.'));
        }
        
        function isRequirementPath(path){
            return typeof path == 'string' && 
                  (path.includes('任務要求') || 
                   path.includes('進階目標') ||
                   path.includes('完成情況'));
        }
        
        function isInternalModification(){
            try {
                const stack = new Error().stack;
                return stack.includes('指令碼修改') || stack.includes('自動修正任務狀態');
            } catch(e){
                debugLog('檢測內部修改時發生錯誤:', e.message);
                return false;
            }
        }
        
        function isLegitimateTaskOperation(){
            try {
                const stack = new Error().stack;
                const legitimateMarkers = [
                    'updateTaskCompletion',
                    'updateTaskStatus', 
                    'cleanupTasks',
                    'processAllTasks',
                    'processAll',
                    '自動修正任務狀態',
                    '更新進階目標完成狀態',
                    '更新基礎要求完成狀態',
                    '更新進階要求進度',
                    '任務系統'
                ];
                
                const isLegitimate = legitimateMarkers.some(marker => stack.includes(marker));
                if(isLegitimate){
                    debugLog('✅ 檢測到任務系統內部操作');
                    debugLog('操作標記:', legitimateMarkers.find(marker => stack.includes(marker)));
                }
                return isLegitimate;
            } catch(e){
                debugLog('檢查正當操作時發生錯誤:', e.message);
                return false;
            }
        }
        
        function isCleanupSettledTask(task, path){
            if(!task || typeof task != 'object') return false;
            
            const pathParts = path.split('.');
            if(pathParts.length !== 2) return false;
            
            const status = task.狀態;
            if(!status) return false;
            
            const settlement = task.結算狀態 || {};
            
            // 檢查任務是否已結算可清理
            if(status === '待結算'){
                const baseReward = settlement.基礎獎勵已發放;
                if(!baseReward) return false;
                
                const advReward = settlement.進階獎勵已發放;
                const hasAdvReqs = task.進階目標 && 
                    Object.keys(task.進階目標).filter(k => !k.startsWith('$')).length > 0;
                
                return !hasAdvReqs || advReward;
            }
            
            if(status === '已失敗'){
                return settlement.失敗懲罰已發放 === true;
            }
            
            return status === '已放棄';
        }
        
        function isTaskReadyForCleanup(task){
            if(!task || typeof task != 'object') return false;
            
            const status = task.狀態;
            if(!status) return false;
            
            const settlement = task.結算狀態 || {};
            
            if(status == '待結算'){
                const baseReward = settlement.基礎獎勵已發放;
                if(!baseReward) return false;
                
                const advReward = settlement.進階獎勵已發放;
                const hasAdvReqs = task.進階目標 && 
                    Object.keys(task.進階目標).filter(k => !k.startsWith('$')).length > 0;
                
                return !hasAdvReqs || advReward;
            }
            
            if(status == '已失敗'){
                return !!settlement.失敗懲罰已發放;
            }
            
            return status == '已放棄';
        }
        
        _.set = function(obj, path, value, options){
            debugLog(`_.set 調用: path="${path}", value類型=${typeof value}`);
            
            if(isInternalModification()){
                debugLog('內部修改，跳過保護檢查:', path);
                debounceMap.delete(path);
                return originalSet.call(this, obj, path, value, options);
            }
            
            // 如果是任務系統內部的正當操作，跳過保護
            if(isLegitimateTaskOperation()){
                debugLog(`✅ 允許任務系統內部操作: ${path}`);
                debounceMap.delete(path);
                return originalSet.call(this, obj, path, value, options);
            }
            
            if(isTaskPath(path)){
                const currentValue = originalGet(obj, path);
                const pathParts = path.split('.');
                
                if(pathParts.length === 2){
                    // 處理主任務路徑
                    if(path === '任務.日常'){
                        debugLog('日常任務，跳過保護檢查');
                        debounceMap.delete(path);
                        return originalSet.call(this, obj, path, value, options);
                    }
                    
                    // 檢查是否為清理操作
                    if((value === null || value === undefined || 
                       (typeof value == 'object' && Object.keys(value).length === 0))){
                        
                        // 如果是清理已結算的任務，允許操作
                        if(isCleanupSettledTask(currentValue, path)){
                            debugLog(`✅ 允許清理已結算任務: ${path}`);
                            debounceMap.delete(path);
                            return originalSet.call(this, obj, path, value, options);
                        }
                        
                        if(shouldBlockOperation(path, `[任務保護]禁止清空任務: ${path}`)){
                            return obj;
                        }
                        return originalSet.call(this, obj, path, value, options);
                    }
                    
                    // 檢查是否為新任務覆蓋
                    if(value && typeof value == 'object' && 
                       (value.標題 || value.描述 || value.任務要求)){
                        const hasExistingTask = currentValue && 
                            typeof currentValue == 'object' && 
                            Object.keys(currentValue).length > 0;
                        
                        if(!hasExistingTask){
                            debugLog('無現有任務，允許設置新任務');
                            debounceMap.delete(path);
                            return originalSet.call(this, obj, path, value, options);
                        }
                        
                        if(isTaskReadyForCleanup(currentValue)){
                            debugLog('任務已準備清理，允許覆蓋');
                            debounceMap.delete(path);
                            return originalSet.call(this, obj, path, value, options);
                        }
                        
                        if(shouldBlockOperation(path, 
                            `[任務保護]禁止覆蓋任務: ${path}, 標題: ${value.標題 || '無標題'}`)){
                            return obj;
                        }
                    }
                }
                
                const lastPart = pathParts[pathParts.length - 1];
                
                // 允許修改狀態欄位（由任務系統處理）
                if(lastPart === '狀態' || path.includes('.完成情況')){
                    // 檢查調用堆棧是否來自任務系統
                    try {
                        const stack = new Error().stack;
                        if(stack.includes('updateTaskStatus') || stack.includes('自動修正任務狀態')){
                            debugLog('✅ 任務系統狀態更新，允許操作:', path);
                            debounceMap.delete(path);
                            return originalSet.call(this, obj, path, value, options);
                        }
                    } catch(e){
                        debugLog('檢查狀態修改時發生錯誤:', e.message);
                    }
                    
                    if(shouldBlockOperation(path, `[任務保護]禁止修改任務狀態欄位: ${path}`)){
                        return obj;
                    }
                }
                
                // 允許修改已完成欄位（由任務系統處理）
                if(lastPart === '已完成' && isRequirementPath(path)){
                    // 檢查調用堆棧是否來自任務系統
                    try {
                        const stack = new Error().stack;
                        if(stack.includes('updateTaskCompletion') || stack.includes('checkReq')){
                            debugLog('✅ 任務系統進度更新，允許操作:', path);
                            debounceMap.delete(path);
                            return originalSet.call(this, obj, path, value, options);
                        }
                    } catch(e){
                        debugLog('檢查進度修改時發生錯誤:', e.message);
                    }
                    
                    if(shouldBlockOperation(path, `[任務保護]禁止修改已完成欄位: ${path}`)){
                        return obj;
                    }
                }
                
                // 允許修改結算狀態
                if(path.includes('結算狀態')){
                    debugLog('結算狀態修改，允許操作:', path);
                    debounceMap.delete(path);
                    return originalSet.call(this, obj, path, value, options);
                }
                
                // 允許修改進度和目標
                if((lastPart === '進度' || lastPart === '目標') && isRequirementPath(path)){
                    debugLog('進度/目標修改，允許操作:', path);
                    debounceMap.delete(path);
                    return originalSet.call(this, obj, path, value, options);
                }
                
                // 允許修改任務要求（進階目標等）
                if(isRequirementPath(path) && !lastPart.includes('已完成')){
                    debugLog('任務要求修改，允許操作:', path);
                    debounceMap.delete(path);
                    return originalSet.call(this, obj, path, value, options);
                }
            }
            
            // 非任務路徑，直接執行
            debounceMap.delete(path);
            return originalSet.call(this, obj, path, value, options);
        };
        
        _.add = function(obj, path, value){
            if(!isInternalModification() && isTaskPath(path)){
                const now = Date.now();
                const lastCall = debounceMap.get(path);
                
                if(!lastCall || now - lastCall >= debouncePeriod){
                    warnLog(`[任務保護]禁止add修改任務: ${path}`);
                    debounceMap.set(path, now);
                }
                return obj;
            }
            return originalAdd.call(this, obj, path, value);
        };
        
        _.unset = function(obj, path){
            if(isTaskPath(path)){
                const now = Date.now();
                const lastCall = debounceMap.get(path);
                
                if(!lastCall || now - lastCall >= debouncePeriod){
                    warnLog(`[任務保護]禁止刪除任務: ${path}`);
                    debounceMap.set(path, now);
                }
                return false;
            }
            return originalUnset.call(this, obj, path);
        };
        
        _.remove = function(array, value){
            if(Array.isArray(array) && array.length > 0){
                const containsTaskObj = array.some(item => 
                    item && typeof item == 'object' && 
                    (item.標題 || item.描述 || item.狀態)
                );
                
                if(containsTaskObj){
                    const now = Date.now();
                    const lastCall = debounceMap.get('remove_task_obj');
                    
                    if(!lastCall || now - lastCall >= debouncePeriod){
                        warnLog('[任務保護]禁止移除任務物件');
                        debounceMap.set('remove_task_obj', now);
                    }
                    return [];
                }
            }
            return originalRemove.call(this, array, value);
        };
        
        _.omit = function(obj, paths){
            if(Array.isArray(paths)){
                const filteredPaths = paths.filter(path => !isTaskPath(path));
                if(filteredPaths.length !== paths.length){
                    const now = Date.now();
                    const lastCall = debounceMap.get('omit_task_path');
                    
                    if(!lastCall || now - lastCall >= debouncePeriod){
                        warnLog('[任務保護]禁止省略任務路徑');
                        debounceMap.set('omit_task_path', now);
                    }
                    return originalOmit.call(this, obj, filteredPaths);
                }
            }
            return originalOmit.call(this, obj, paths);
        };
        
        _.assign = function(){
            const target = arguments[0];
            if(target && typeof target == 'object'){
                for(let i = 1; i < arguments.length; i++){
                    const source = arguments[i];
                    if(source && typeof source == 'object'){
                        for(const key in source){
                            if(isTaskPath(key)){
                                const existing = originalGet(target, key);
                                
                                if(key === '任務.日常'){
                                    const filteredSource = Object.assign({}, source);
                                    delete filteredSource[key];
                                    return originalAssign.apply(this, 
                                        [target, filteredSource].concat(
                                            Array.prototype.slice.call(arguments, i + 1)
                                        ));
                                }
                                
                                const hasExistingTask = existing && 
                                    typeof existing == 'object' && 
                                    Object.keys(existing).length > 0;
                                
                                if(hasExistingTask && isTaskReadyForCleanup(existing)){
                                    const filteredSource = Object.assign({}, source);
                                    delete filteredSource[key];
                                    return originalAssign.apply(this, 
                                        [target, filteredSource].concat(
                                            Array.prototype.slice.call(arguments, i + 1)
                                        ));
                                }
                                
                                if(hasExistingTask){
                                    const now = Date.now();
                                    const lastCall = debounceMap.get(key);
                                    
                                    if(!lastCall || now - lastCall >= debouncePeriod){
                                        warnLog(`[任務保護]禁止assign覆蓋任務: ${key}`);
                                        debounceMap.set(key, now);
                                    }
                                    
                                    const filteredSource = Object.assign({}, source);
                                    delete filteredSource[key];
                                    return originalAssign.apply(this, 
                                        [target, filteredSource].concat(
                                            Array.prototype.slice.call(arguments, i + 1)
                                        ));
                                }
                            }
                        }
                    }
                }
            }
            return originalAssign.apply(this, arguments);
        };
        
        setInterval(() => {
            const now = Date.now();
            let cleanedCount = 0;
            for(const [path, timestamp] of debounceMap.entries()){
                if(now - timestamp > 60000){
                    debounceMap.delete(path);
                    cleanedCount++;
                }
            }
            debugLog(`清理了 ${cleanedCount} 個過期防抖記錄`);
        }, 60000);
        
        window._taskProtectionFinal = true;
        infoLog('✅ 任務保護系統初始化完成');
    }
    
    initTaskProtection();
})();

// ==================== 模組定義工具 ====================
var t = {
    n: e => {
        debugLog('載入模組:', e?.name || '未知模組');
        var a = e && e.__esModule 
            ? () => e.default 
            : () => e;
        return t.d(a, { a }), a;
    },
    
    d: (e, a) => {
        for (var n in a) {
            t.o(a, n) && !t.o(e, n) && 
            Object.defineProperty(e, n, {
                enumerable: !0,
                get: a[n]
            });
        }
    },
    
    o: (t, e) => Object.prototype.hasOwnProperty.call(t, e)
};

// ==================== 載入依賴模組 ====================
infoLog('📦 載入依賴模組...');
try {
    const e = _;
    infoLog('✅ _ 模組載入成功');
    var a = t.n(e);
    infoLog('✅ 工具函數初始化完成');
} catch (error) {
    errorLog('❌ 載入 _ 模組失敗:', error.message);
    var a = () => ({
        get: (obj, path, defaultValue) => {
            if (!obj || typeof path !== 'string') return defaultValue;
            return path.split('.').reduce((acc, key) => acc && acc[key], obj) || defaultValue;
        },
        set: (obj, path, value) => {
            if (!obj || typeof path !== 'string') return false;
            const keys = path.split('.');
            const lastKey = keys.pop();
            const target = keys.reduce((acc, key) => {
                if (!acc[key]) acc[key] = {};
                return acc[key];
            }, obj);
            target[lastKey] = value;
            return true;
        },
        isPlainObject: (obj) => obj && typeof obj === 'object' && !Array.isArray(obj) && obj !== null,
        isEmpty: (obj) => !obj || Object.keys(obj).length === 0
    });
    warnLog('⚠️ 使用備用工具函數');
}

// ==================== 全局變數 ====================
let p = !1;
let b = null;
infoLog('✅ 全局變數初始化完成');

// ==================== 核心工具函數 ====================

function mh(t){
    debugLog(`解析時間字串: "${t}"`);
    if('string' != typeof t) return null;
    const e = /^(\d{1,2}):(\d{2})$/.exec(t.trim());
    if(!e) return null;
    const a = Number(e[1]), n = Number(e[2]);
    return Number.isFinite(a) && Number.isFinite(n) ? a < 0 || a > 23 || n < 0 || n > 59 ? null : 60 * a + n : null;
}

function mM(t){
    debugLog(`解析任務結束時間: "${t}"`);
    if('string' != typeof t) return null;
    const e = /第(\d+)天\s+(\d{1,2}):(\d{2})/.exec(t);
    if(!e) return null;
    const a = Number(e[1]), n = Number(e[2]), i = Number(e[3]);
    return Number.isFinite(a) && Number.isFinite(n) && Number.isFinite(i) ? {
        day: a, hour: n, minute: i, totalMinutes: a * 1440 + n * 60 + i
    } : null;
}

function mg(t){
    debugLog('獲取當前遊戲時間');
    const e = a().get(t, '系統.經過天數'), n = a().get(t, '系統.當前時間');
    if(!Number.isFinite(e) || 'string' != typeof n) return null;
    const i = mh(n);
    if(i === null) return null;
    return {
        day: e, hour: Math.floor(i / 60), minute: i % 60, totalMinutes: e * 1440 + i
    };
}

function checkReq(r){
    debugLog('檢查任務要求:', r);
    
    if(!a().isPlainObject(r)) return {...r};
    
    if('number' == typeof r.進度 && 'number' == typeof r.目標){
        if(r.進度 >= r.目標 && !r.已完成){
            debugLog('✅ 進度達標，標記為已完成');
            return {...r, 已完成: !0};
        }
        if(r.進度 < r.目標 && r.已完成){
            debugLog('⚠️ 進度未達標，取消已完成標記');
            return {...r, 已完成: !1};
        }
    }
    
    return {...r};
}

// ==================== 任務處理函數 ====================

async function updateTaskCompletion(t, path){
    infoLog(`📝 更新任務完成狀態: ${path}`);
    const task = a().get(t.stat_data, path);
    if(!a().isPlainObject(task)) return !1;
    
    const taskTitle = task.標題 || '無標題';
    debugLog(`處理任務: "${taskTitle}"`);
    
    let changed = !1;
    
    const baseReqs = a().get(task, '任務要求');
    if(a().isPlainObject(baseReqs)){
        const baseReqKeys = Object.keys(baseReqs).filter(k => !k.startsWith('$'));
        debugLog(`發現 ${baseReqKeys.length} 個基礎要求`);
        
        let allBaseDone = !0;
        
        for(const [key, req] of Object.entries(baseReqs)){
            if(key.startsWith('$')) continue;
            
            const newReq = checkReq(req);
            if(JSON.stringify(newReq) !== JSON.stringify(req)){
                infoLog(`🔄 更新基礎要求: ${key}`);
                await Mvu.setMvuVariable(
                    t,
                    `${path}.任務要求.${key}`,
                    newReq,
                    {reason: '更新要求進度'}
                );
                a().set(t.stat_data, `${path}.任務要求.${key}`, newReq);
                changed = !0;
            }
            
            if(!newReq.已完成) allBaseDone = !1;
        }
        
        const currentBaseDone = a().get(task, '完成情況.基礎要求完成');
        if(allBaseDone !== currentBaseDone){
            infoLog(`🔄 基礎完成狀態變更: ${currentBaseDone} → ${allBaseDone}`);
            await Mvu.setMvuVariable(
                t,
                `${path}.完成情況.基礎要求完成`,
                allBaseDone,
                {reason: '更新基礎要求完成狀態'}
            );
            a().set(t.stat_data, `${path}.完成情況.基礎要求完成`, allBaseDone);
            changed = !0;
        }
    }
    
    const advReqs = a().get(task, '進階目標');
    if(a().isPlainObject(advReqs)){
        const advReqKeys = Object.keys(advReqs).filter(k => !k.startsWith('$'));
        debugLog(`發現 ${advReqKeys.length} 個進階目標`);
        
        let allAdvDone = !0;
        
        for(const [key, req] of Object.entries(advReqs)){
            if(key.startsWith('$')) continue;
            
            const newReq = checkReq(req);
            if(JSON.stringify(newReq) !== JSON.stringify(req)){
                infoLog(`🔄 更新進階目標: ${key}`);
                await Mvu.setMvuVariable(
                    t,
                    `${path}.進階目標.${key}`,
                    newReq,
                    {reason: '更新進階要求進度'}
                );
                a().set(t.stat_data, `${path}.進階目標.${key}`, newReq);
                changed = !0;
            }
            
            if(!newReq.已完成) allAdvDone = !1;
        }
        
        const currentAdvDone = a().get(task, '完成情況.進階目標完成');
        if(allAdvDone !== currentAdvDone){
            infoLog(`🔄 進階完成狀態變更: ${currentAdvDone} → ${allAdvDone}`);
            await Mvu.setMvuVariable(
                t,
                `${path}.完成情況.進階目標完成`,
                allAdvDone,
                {reason: '更新進階目標完成狀態'}
            );
            a().set(t.stat_data, `${path}.完成情況.進階目標完成`, allAdvDone);
            changed = !0;
        }
    }
    
    if(changed) infoLog(`✅ 任務完成狀態已更新: "${taskTitle}"`);
    
    return changed;
}

async function updateTaskStatus(t, path, type){
    infoLog(`🔄 更新任務狀態: ${path} (類型: ${type})`);
    const task = a().get(t.stat_data, path);
    if(!a().isPlainObject(task)) return !1;
    
    const status = a().get(task, '狀態');
    const taskTitle = task.標題 || '無標題';
    debugLog(`處理任務: "${taskTitle}", 當前狀態: ${status}`);
    
    if(['待結算', '已放棄', '已失敗'].includes(status)){
        debugLog(`任務已是終態 (${status})，跳過處理`);
        return !1;
    }
    
    const baseDone = a().get(task, '完成情況.基礎要求完成', !1);
    const advDone = a().get(task, '完成情況.進階目標完成', !1);
    const hasAdvReqs = a().isPlainObject(a().get(task, '進階目標')) && 
        Object.keys(a().get(task, '進階目標')).filter(k => !k.startsWith('$')).length > 0;
    const endTimeStr = a().get(task, '結束時間', '');
    const currentTime = mg(t.stat_data);
    const timeout = a().get(task, '任務超時', !1);
    
    debugLog(`狀態分析: baseDone=${baseDone}, advDone=${advDone}, hasAdvReqs=${hasAdvReqs}, timeout=${timeout}`);
    
    let correctStatus = status;
    
    const endTime = endTimeStr ? mM(endTimeStr) : null;
    const isExpired = endTime && currentTime && currentTime.totalMinutes >= endTime.totalMinutes;
    
    if((type === '緊急' && timeout) || (type !== '緊急' && isExpired)){
        infoLog(`⏰ 任務${type === '緊急' ? '超時' : '過期'}: "${taskTitle}"`);
        
        if(baseDone){
            correctStatus = '待結算';
            infoLog(`✅ 基礎已完成 → 標記為待結算`);
            
            if(hasAdvReqs){
                let settlement = a().get(task, '結算狀態') || {
                    基礎獎勵已發放: !1,
                    進階獎勵已發放: !1,
                    失敗懲罰已發放: !1
                };
                if(settlement.進階獎勵已發放 === !1){
                    infoLog(`💰 設定進階獎勵已發放`);
                    settlement.進階獎勵已發放 = !0;
                    await Mvu.setMvuVariable(
                        t,
                        `${path}.結算狀態`,
                        settlement,
                        {reason: '超時任務設定進階獎勵已發放'}
                    );
                    a().set(t.stat_data, `${path}.結算狀態`, settlement);
                }
            }
        } else {
            if(type === '緊急'){
                correctStatus = '已失敗';
                infoLog(`❌ 緊急任務未完成 → 標記為已失敗`);
                
                const settlement = a().get(task, '結算狀態') || {
                    基礎獎勵已發放: !1,
                    進階獎勵已發放: !1,
                    失敗懲罰已發放: !1
                };
                if(settlement.失敗懲罰已發放 === undefined || settlement.失敗懲罰已發放 === !1){
                    infoLog(`💥 設定失敗懲罰未發放`);
                    settlement.失敗懲罰已發放 = !1;
                    await Mvu.setMvuVariable(
                        t,
                        `${path}.結算狀態`,
                        settlement,
                        {reason: '設定失敗懲罰未發放'}
                    );
                    a().set(t.stat_data, `${path}.結算狀態`, settlement);
                }
            } else {
                correctStatus = '已放棄';
                infoLog(`🚫 非緊急任務未完成 → 標記為已放棄`);
            }
        }
    } else {
        if(!baseDone){
            correctStatus = '進行中';
        } else {
            if(hasAdvReqs && !advDone){
                correctStatus = '進階中';
                infoLog(`📈 有進階目標且未完成 → 標記為進階中`);
            } else {
                correctStatus = '待結算';
                infoLog(`✅ 無進階目標或已完成 → 標記為待結算`);
            }
        }
    }
    
    if(status !== correctStatus){
        infoLog(`🔄 任務狀態更新: "${taskTitle}" ${status} → ${correctStatus}`);
        
        await Mvu.setMvuVariable(
            t,
            `${path}.狀態`,
            correctStatus,
            {reason: '自動修正任務狀態'}
        );
        a().set(t.stat_data, `${path}.狀態`, correctStatus);
        return !0;
    }
    
    return !1;
}

async function processAllTasks(t){
    infoLog('🚀 開始處理所有任務');
    
    let changed = !1;
    let processedCount = 0;
    let statusChangedCount = 0;
    let completionChangedCount = 0;
    
    const types = ['主線', '支線', '日常', '緊急'];
    for(const type of types){
        const path = `任務.${type}`;
        const task = a().get(t.stat_data, path);
        
        if(a().isPlainObject(task) && !a().isEmpty(task)){
            processedCount++;
            debugLog(`處理 ${type} 任務: ${task.標題 || '無標題'}`);
            
            if(await updateTaskCompletion(t, path)){
                changed = !0;
                completionChangedCount++;
            }
            
            if(await updateTaskStatus(t, path, type)){
                changed = !0;
                statusChangedCount++;
            }
        }
    }
    
    const bondTasks = a().get(t.stat_data, '任務.羈絆');
    if(a().isPlainObject(bondTasks)){
        for(const [name, task] of Object.entries(bondTasks)){
            if(name.startsWith('$')) continue;
            
            const path = `任務.羈絆.${name}`;
            if(a().isPlainObject(task) && !a().isEmpty(task)){
                processedCount++;
                debugLog(`處理羈絆任務[${name}]: ${task.標題 || '無標題'}`);
                
                if(await updateTaskCompletion(t, path)){
                    changed = !0;
                    completionChangedCount++;
                }
                
                if(await updateTaskStatus(t, path, '羈絆')){
                    changed = !0;
                    statusChangedCount++;
                }
            }
        }
    }
    
    if(processedCount > 0){
        infoLog(`📊 任務處理統計: 共 ${processedCount} 個任務`);
        if(completionChangedCount > 0) infoLog(`  進度變更: ${completionChangedCount} 個`);
        if(statusChangedCount > 0) infoLog(`  狀態變更: ${statusChangedCount} 個`);
    } else {
        infoLog('📊 無任務需要處理');
    }
    
    return changed;
}

async function checkRegionRestrictions(t){
    infoLog('📍 開始檢查區域限制');
    
    let changed = !1;
    const currentLocation = a().get(t.stat_data, '環境.當前位置');
    
    if('string' != typeof currentLocation || currentLocation.trim() === ''){
        debugLog('當前位置無效，跳過檢查');
        return changed;
    }
    
    const currentDay = a().get(t.stat_data, '系統.經過天數');
    const previousDay = b && b.previousDay;
    
    debugLog(`當前天數: ${currentDay}, 上次天數: ${previousDay || '無記錄'}`);
    
    if(!Number.isFinite(currentDay) || !Number.isFinite(previousDay) || currentDay <= previousDay){
        debugLog('未跨日或天數異常，跳過區域檢查');
        return changed;
    }
    
    infoLog(`🌅 檢測到跨日 (${previousDay} → ${currentDay})，檢查區域限制，當前位置: ${currentLocation}`);
    
    const types = ['主線', '支線', '日常'];
    let abandonedCount = 0;
    
    for(const type of types){
        const path = `任務.${type}`;
        const task = a().get(t.stat_data, path);
        
        if(a().isPlainObject(task) && !a().isEmpty(task)){
            const region = a().get(task, '區域限制', '');
            const status = a().get(task, '狀態');
            const taskTitle = task.標題 || '無標題';
            
            debugLog(`檢查 ${type} 任務: "${taskTitle}", 區域: ${region}, 狀態: ${status}`);
            
            if(region && region !== '' && region !== currentLocation && 
               (status === '進行中' || status === '進階中')){
                infoLog(`📍 區域限制: "${taskTitle}" 因區域不匹配被放棄 (${region} ≠ ${currentLocation})`);
                abandonedCount++;
                
                await Mvu.setMvuVariable(
                    t,
                    `${path}.狀態`,
                    '已放棄',
                    {reason: '區域限制不匹配跨日'}
                );
                a().set(t.stat_data, `${path}.狀態`, '已放棄');
                
                await Mvu.setMvuVariable(
                    t,
                    path,
                    {},
                    {reason: '區域限制放棄後清空'}
                );
                a().set(t.stat_data, path, {});
                changed = !0;
            }
        }
    }
    
    if(abandonedCount > 0){
        infoLog(`📍 區域檢查完成: ${abandonedCount} 個任務因區域限制被放棄`);
    }
    
    return changed;
}

async function cleanupTasks(t){
    infoLog('🧹 開始清理任務');
    
    let changed = !1;
    let cleanedCount = 0;
    
    const types = ['主線', '支線', '日常', '緊急'];
    for(const type of types){
        const path = `任務.${type}`;
        const task = a().get(t.stat_data, path);
        
        if(a().isPlainObject(task) && !a().isEmpty(task)){
            const status = a().get(task, '狀態');
            const baseReward = a().get(task, '結算狀態.基礎獎勵已發放', !1);
            const advReward = a().get(task, '結算狀態.進階獎勵已發放', !1);
            const failurePenalty = a().get(task, '結算狀態.失敗懲罰已發放', !1);
            const hasAdvReqs = a().isPlainObject(a().get(task, '進階目標')) && 
                Object.keys(a().get(task, '進階目標')).filter(k => !k.startsWith('$')).length > 0;
            const taskTitle = task.標題 || '無標題';
            
            debugLog(`檢查 ${type} 任務: "${taskTitle}", 狀態: ${status}`);
            
            // 使用更明確的清理條件
            const shouldClean = 
                (status === '待結算' && baseReward && (!hasAdvReqs || advReward)) ||
                (status === '已放棄') ||
                (status === '已失敗' && failurePenalty === true);
            
            if(shouldClean){
                infoLog(`🧹 清理任務: "${taskTitle}" (狀態: ${status})`);
                cleanedCount++;
                
                try {
                    // 在清理前確保任務保護系統知道這是正當操作
                    const cleanupReason = status === '待結算' ? '任務待結算且獎勵已發放' :
                                        status === '已放棄' ? '清理已放棄任務' :
                                        '失敗懲罰已發放，清理任務';
                    
                    await Mvu.setMvuVariable(
                        t,
                        path,
                        {},
                        {reason: cleanupReason}
                    );
                    a().set(t.stat_data, path, {});
                    changed = !0;
                    
                } catch (error) {
                    errorLog(`❌ 清理任務失敗: "${taskTitle}"`, error.message);
                }
            }
        }
    }
    
    const bondTasks = a().get(t.stat_data, '任務.羈絆');
    if(a().isPlainObject(bondTasks)){
        for(const [name, task] of Object.entries(bondTasks)){
            if(name.startsWith('$')) continue;
            
            const path = `任務.羈絆.${name}`;
            if(a().isPlainObject(task) && !a().isEmpty(task)){
                const status = a().get(task, '狀態');
                const baseReward = a().get(task, '結算狀態.基礎獎勵已發放', !1);
                const advReward = a().get(task, '結算狀態.進階獎勵已發放', !1);
                const hasAdvReqs = a().isPlainObject(a().get(task, '進階目標')) && 
                    Object.keys(a().get(task, '進階目標')).filter(k => !k.startsWith('$')).length > 0;
                const taskTitle = task.標題 || '無標題';
                
                debugLog(`檢查羈絆任務[${name}]: "${taskTitle}", 狀態: ${status}`);
                
                const shouldClean = 
                    (status === '待結算' && baseReward && (!hasAdvReqs || advReward)) ||
                    (status === '已放棄');
                
                if(shouldClean){
                    infoLog(`✅ 清理已完成羈絆任務: "${taskTitle}" (待結算且獎勵已發放)`);
                    cleanedCount++;
                    
                    await Mvu.setMvuVariable(
                        t,
                        path,
                        {},
                        {reason: '羈絆任務待結算且獎勵已發放'}
                    );
                    a().set(t.stat_data, path, {});
                    changed = !0;
                } else if(status === '已放棄'){
                    infoLog(`🚫 清理已放棄羈絆任務: "${taskTitle}"`);
                    cleanedCount++;
                    
                    await Mvu.setMvuVariable(
                        t,
                        path,
                        {},
                        {reason: '清理已放棄羈絆任務'}
                    );
                    a().set(t.stat_data, path, {});
                    changed = !0;
                }
            }
        }
    }
    
    if(cleanedCount > 0){
        infoLog(`🧹 任務清理完成: 共清理 ${cleanedCount} 個任務`);
    } else {
        infoLog('🧹 無任務需要清理');
    }
    
    return changed;
}

// ==================== 清理數量為0字段的函數 ====================

function findZeroQuantityInSpecificPaths(t){
    infoLog('🔍 檢查特定路徑下數量為0的字段');
    
    const pathsToCheck = [
        '攜帶物品',
        '同伴.攜帶物品', 
        '寵物.攜帶物品',
        '營地'
    ];
    
    const toDelete = [];
    
    pathsToCheck.forEach(basePath => {
        const data = a().get(t.stat_data, basePath);
        
        if(!data){
            debugLog(`路徑 ${basePath} 無數據`);
            return;
        }
        
        recursivelyCheckForZeroQuantity(data, basePath, toDelete);
    });
    
    if(toDelete.length > 0){
        infoLog(`🔍 發現 ${toDelete.length} 個數量為0的字段`);
        if(TASK_DEBUG){
            toDelete.forEach((item, index) => {
                debugLog(`  ${index + 1}. ${item.path} = ${item.value}`);
            });
        }
    } else {
        infoLog('🔍 未發現數量為0的字段');
    }
    
    return toDelete;
}

function checkObjectForZeroQuantity(obj, currentPath, toDelete){
    if(!a().isPlainObject(obj) && !Array.isArray(obj)) return;
    
    if(a().isPlainObject(obj)){
        for(const [key, value] of Object.entries(obj)){
            if(key.startsWith('$')) continue;
            
            const itemPath = `${currentPath}.${key}`;
            
            if((key === '數量' || key.includes('數量')) && 
               (value === 0 || value === '0' || value === null || value === undefined)){
                toDelete.push({
                    path: itemPath,
                    parentPath: currentPath,
                    key: key,
                    value: value,
                    fullObject: obj
                });
            }
            
            if(a().isPlainObject(value) || Array.isArray(value)){
                checkObjectForZeroQuantity(value, itemPath, toDelete);
            }
        }
    } else if(Array.isArray(obj)){
        obj.forEach((item, index) => {
            if(a().isPlainObject(item)){
                checkObjectForZeroQuantity(item, `${currentPath}[${index}]`, toDelete);
            }
        });
    }
}

function recursivelyCheckForZeroQuantity(campData, basePath, toDelete){
    if(!campData) return;
    
    checkObjectForZeroQuantity(campData, basePath, toDelete);
    
    function deepCheck(obj, path){
        if(!a().isPlainObject(obj)) return;
        
        for(const [key, value] of Object.entries(obj)){
            if(key.startsWith('$')) continue;
            
            const newPath = `${path}.${key}`;
            
            if(a().isPlainObject(value)){
                deepCheck(value, newPath);
            } else if(Array.isArray(value)){
                value.forEach((item, index) => {
                    if(a().isPlainObject(item)){
                        deepCheck(item, `${newPath}[${index}]`);
                    }
                });
            }
        }
    }
    
    deepCheck(campData, basePath);
}

async function cleanupZeroQuantitiesInSpecificPaths(t){
    infoLog('🧹 開始清理特定路徑下數量為0的字段');
    
    let changed = !1;
    let deletedCount = 0;
    let errorCount = 0;
    
    const zeroQuantityPaths = findZeroQuantityInSpecificPaths(t);
    
    if(zeroQuantityPaths.length > 0){
        infoLog(`🔧 開始清理 ${zeroQuantityPaths.length} 個數量為0的字段`);
        
        for(const item of zeroQuantityPaths){
            try {
                const { path, parentPath, key, fullObject } = item;
                
                infoLog(`🔨 處理: ${path}`);
                
                if(a().isPlainObject(fullObject)){
                    const otherKeys = Object.keys(fullObject).filter(k => 
                        !k.startsWith('$') && k !== key
                    );
                    
                    if(otherKeys.length === 0){
                        infoLog(`🗑️ 刪除空物件: ${parentPath}`);
                        await Mvu.setMvuVariable(
                            t,
                            parentPath,
                            {},
                            { reason: '刪除空物件（僅含數量0）' }
                        );
                        a().set(t.stat_data, parentPath, {});
                    } else {
                        infoLog(`🗑️ 刪除字段: ${path}`);
                        await Mvu.setMvuVariable(
                            t,
                            path,
                            null,
                            { reason: '清理數量為0的字段' }
                        );
                        delete fullObject[key];
                    }
                } else {
                    infoLog(`🗑️ 刪除字段: ${path}`);
                    await Mvu.setMvuVariable(
                        t,
                        path,
                        null,
                        { reason: '清理數量為0的字段' }
                    );
                    a().set(t.stat_data, path, null);
                }
                
                deletedCount++;
                changed = !0;
                
            } catch (error) {
                errorLog(`❌ 清理 ${item.path} 時發生錯誤:`, error.message);
                errorCount++;
            }
        }
        
        if(deletedCount > 0){
            infoLog(`✅ 特定路徑數量清理完成: 成功刪除 ${deletedCount} 個字段/物件`);
            if(errorCount > 0){
                warnLog(`⚠️ 清理過程中有 ${errorCount} 個錯誤`);
            }
        }
    } else {
        infoLog('✅ 未發現需要清理的數量為0字段');
    }
    
    return changed;
}

// ==================== 主處理函數 ====================

async function processAll(t){
    infoLog('🚀 ===== 開始執行任務處理流程 =====');
    
    let hasChanges = !1;
    let changeDetails = [];
    
    if(await processAllTasks(t)){
        hasChanges = !0;
        changeDetails.push('任務處理');
    }
    
    if(await checkRegionRestrictions(t)){
        hasChanges = !0;
        changeDetails.push('區域限制檢查');
    }
    
    if(await cleanupTasks(t)){
        hasChanges = !0;
        changeDetails.push('任務清理');
    }
    
    if(await cleanupZeroQuantitiesInSpecificPaths(t)){
        hasChanges = !0;
        changeDetails.push('數量字段清理');
    }
    
    if(hasChanges){
        infoLog(`📊 任務處理完成，變更項目: ${changeDetails.join(', ')}`);
    } else {
        infoLog('✅ 任務處理完成，無數據變更');
    }
    
    infoLog('🚀 ===== 任務處理流程結束 =====');
    return hasChanges;
}

// ==================== 主初始化函數 ====================

$(async() => {
    infoLog('🚀 ===== 系統初始化開始 =====');
    
    try {
        infoLog('⏳ 等待 Mvu 系統初始化...');
        await waitGlobalInitialized('Mvu');
        infoLog('✅ Mvu 系統已就緒');
        
        eventOn(Mvu.events.VARIABLE_UPDATE_STARTED, t => {
            debugLog('📝 VARIABLE_UPDATE_STARTED 事件觸發');
            
            if(p){
                debugLog('⚠️ 系統正在處理中，跳過快照');
                b = null;
            } else {
                try {
                    const data = t.stat_data ?? {};
                    b = {
                        previousMissionRoot: a().get(data, '任務'),
                        previousMission: a().get(data, '任務.緊急'),
                        previousDay: a().get(data, '系統.經過天數'),
                        previousTime: a().get(data, '系統.當前時間')
                    };
                    
                    infoLog(`📸 建立快照: 天數=${b.previousDay}`);
                } catch (error) {
                    errorLog('❌ 建立快照時發生錯誤:', error.message);
                    b = null;
                }
            }
        });
        
        eventOn(Mvu.events.VARIABLE_UPDATE_ENDED, async t => {
            infoLog('📝 數據更新事件觸發');
            
            if(p){
                infoLog('⚠️ 系統正在處理中，跳過本次事件');
                return;
            }
            
            try {
                infoLog('🔧 開始處理數據更新');
                let hasChanges = !1;
                
                const tasksRoot = a().get(t.stat_data, '任務');
                if(!a().isPlainObject(tasksRoot)){
                    infoLog('📂 創建任務根目錄');
                    const emptyRoot = {};
                    await Mvu.setMvuVariable(
                        t,
                        '任務',
                        emptyRoot,
                        {reason: '自動維護任務路徑'}
                    );
                    a().set(t.stat_data, '任務', emptyRoot);
                    hasChanges = !0;
                }
                
                const taskTypes = ['主線', '支線', '緊急', '日常', '羈絆'];
                let createdPaths = 0;
                
                for(const type of taskTypes){
                    const path = `任務.${type}`;
                    let typeData = a().get(t.stat_data, path);
                    
                    if(!a().isPlainObject(typeData)){
                        infoLog(`📂 創建任務類型路徑: ${path}`);
                        typeData = {};
                        await Mvu.setMvuVariable(
                            t,
                            path,
                            typeData,
                            {reason: '自動維護任務路徑'}
                        );
                        a().set(t.stat_data, path, typeData);
                        hasChanges = !0;
                        createdPaths++;
                    }
                    
                    if(type === '羈絆'){
                        const companions = a().get(t.stat_data, '同伴');
                        if(a().isPlainObject(companions)){
                            for(const [name, companion] of Object.entries(companions)){
                                if(name.startsWith('$')) continue;
                                
                                const bondPath = `任務.羈絆.${name}`;
                                let bondTask = a().get(t.stat_data, bondPath);
                                
                                if(!a().isPlainObject(bondTask)){
                                    infoLog(`👥 為同伴 ${name} 創建羈絆任務路徑`);
                                    bondTask = {};
                                    await Mvu.setMvuVariable(
                                        t,
                                        bondPath,
                                        bondTask,
                                        {reason: '自動維護任務路徑'}
                                    );
                                    a().set(t.stat_data, bondPath, bondTask);
                                    hasChanges = !0;
                                }
                            }
                        }
                    }
                }
                
                if(createdPaths > 0){
                    infoLog(`📂 創建了 ${createdPaths} 個任務路徑`);
                }
                
                const emergencyTask = a().get(t.stat_data, '任務.緊急');
                if(a().isPlainObject(emergencyTask) && !a().isEmpty(emergencyTask)){
                    const endTimeStr = emergencyTask.結束時間;
                    
                    if('string' == typeof endTimeStr && endTimeStr.trim() !== ''){
                        const endTime = mM(endTimeStr);
                        
                        if(endTime){
                            const currentTime = mg(t.stat_data);
                            
                            if(currentTime && currentTime.totalMinutes >= endTime.totalMinutes){
                                const currentTimeout = a().get(emergencyTask, '任務超時');
                                
                                if(!0 !== currentTimeout){
                                    infoLog('⏰ 緊急任務已超時，設置超時標記');
                                    await Mvu.setMvuVariable(
                                        t,
                                        '任務.緊急.任務超時',
                                        !0,
                                        {reason: '緊急任務超時'}
                                    );
                                    a().set(t.stat_data, '任務.緊急.任務超時', !0);
                                    hasChanges = !0;
                                }
                            }
                        }
                    }
                }
                
                if(await processAll(t)){
                    hasChanges = !0;
                }
                
                if(hasChanges){
                    infoLog('🔄 有數據變更，觸發資料更新');
                    p = !0;
                    
                    await Mvu.replaceMvuData(t, {
                        type: 'message',
                        message_id: 'latest'
                    });
    
                    p = !1;
                    b = null;
                    infoLog('✅ 資料更新完成');
                } else {
                    infoLog('✅ 無數據變更，跳過資料更新');
                }
                
            } catch (error) {
                errorLog('❌ 處理過程中發生錯誤:', error.message);
                p = !1;
            }
        });
        
        infoLog('✅ 系統初始化完成，事件監聽器已註冊');
        infoLog('🚀 ===== 系統初始化完成 =====');
        
    } catch (error) {
        errorLog('❌ 初始化失敗:', error.message);
    }
})();

// ==================== 系統就緒標記 ====================
infoLog('🎉 任務管理系統加載完成');