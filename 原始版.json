    (await window._checkCropGrowth(t)) && (changed = !0),
    
    // 7. 畜牧系統 (腳本1號)
    (await window._checkLivestockGrowth(t)) && (changed = !0),
    
    // 8. 狀態效果系統 (腳本2號)
    (await processStatusEffects(t)) && (changed = !0),
    
    // 9. 任務系統 (腳本2號)
    (await processAll(t)) && (changed = !0);
    
    // 10. 移除當前狀態屬性
    const status=a().get(t.stat_data,'狀態');
    if(a().isPlainObject(status)&&'當前狀態'in status){
      try{
        const newStatus=a().omit(status,['當前狀態']);
        await Mvu.setMvuVariable(t,'狀態',newStatus,{reason:'刪除狀態.當前狀態屬性'});
        a().set(t.stat_data,'狀態',newStatus);
        changed=!0;
      }catch(e){
        errorLog('刪除狀態.當前狀態失敗:',e);
      }
    }
    
    return changed;
  }

  // ==================== 新增測試和工具函數 ====================
  window.testDaySystem = function() {
    console.log('[計算系統] === 雙時間系統測試 ===');
    
    if (window._timeSystem) {
      console.log('[計算系統] ✅ 雙時間系統已初始化');
      
      const testTimes = ['00:00', '12:34', '23:59', '8:05', '0:0'];
      testTimes.forEach(time => {
        const normalized = window._timeSystem.normalizeTime(time);
        console.log(`[計算系統]   ${time} -> ${normalized}`);
      });
      
      const sameTests = [
        { time1: '08:00', time2: '8:00', expected: true },
        { time1: '12:30', time2: '12:30', expected: true },
        { time1: '23:59', time2: '00:01', expected: false }
      ];
      sameTests.forEach(test => {
        const result = window._timeSystem.isTimeSame(test.time1, test.time2);
        console.log(`[計算系統]   ${test.time1} == ${test.time2} ? ${result} ${result === test.expected ? '✅' : '❌'}`);
      });
      
      const dayPassTests = [
        { previous: '23:30', current: '00:05', expected: true },
        { previous: '22:00', current: '23:00', expected: false },
        { previous: '01:00', current: '00:30', expected: false }
      ];
      dayPassTests.forEach(test => {
        const prevMin = h(test.previous);
        const currMin = h(test.current);
        const result = window._timeSystem.isLikelyDayPass(prevMin, currMin);
        console.log(`[計算系統]   ${test.previous} → ${test.current} : ${result} ${result === test.expected ? '✅' : '❌'}`);
      });
      
      const addMinuteTests = [
        { input: '10:30', expected: '10:31' },
        { input: '23:59', expected: '00:00' },
        { input: '00:00', expected: '00:01' },
        { input: '12:59', expected: '13:00' }
      ];
      addMinuteTests.forEach(test => {
        const result = window._timeSystem.addOneMinute(test.input);
        console.log(`[計算系統]   ${test.input} +1分鐘 = ${result} ${result === test.expected ? '✅' : '❌'}`);
      });
      
    } else {
      console.error('[計算系統] ❌ 雙時間系統未初始化');
    }
  };

  window.resetTimeSystem = function() {
    if (window._timeSystem) {
      window._timeSystem.reset();
      debugLog('雙時間系統已重置');
    } else {
      errorLog('雙時間系統未初始化');
    }
  };

  window.fixCurrentTime = async function() {
    if (!Mvu || !Mvu.getCurrentContext) {
      errorLog('Mvu 未載入或缺少 getCurrentContext 方法');
      return;
    }
    
    try {
      const context = Mvu.getCurrentContext();
      if (!context) {
        errorLog('無法獲取當前上下文');
        return;
      }
      
      infoLog('手動檢查並修正時間系統...');
      
      if (window._timeSystem) {
        const result = await window._timeSystem.verifyTime(context);
        infoLog(`檢查完成: ${result.reason}`);
        
        if (result.shouldFix && Mvu.replaceMvuData) {
          await Mvu.replaceMvuData(context, { type: 'message', message_id: 'latest' });
        }
      } else {
        errorLog('時間系統未初始化');
      }
    } catch (error) {
      errorLog('手動修正失敗:', error);
    }
  };

  window.showTimeStatus = function() {
    console.log('[計算系統] === 雙時間系統狀態 ===');
    
    if (window._timeSystem) {
      console.log(`[計算系統] 🎯 系統初始化: ${window._timeSystem.initialized ? '✅' : '❌'}`);
    } else {
      console.log('[計算系統] ❌ 雙時間系統未初始化');
    }
    
    if (Mvu && Mvu.getCurrentContext) {
      try {
        const context = Mvu.getCurrentContext();
        if (context && context.stat_data) {
          const data = context.stat_data;
          
          const currentTime = a().get(data, '系統.當前時間');
          const previousTime = a().get(data, '系統.前次時間');
          const currentDay = a().get(data, '系統.經過天數');
          const previousDay = a().get(data, '系統.前次天數');
          
          console.log(`[計算系統] 📊 當前遊戲時間: ${currentTime || '未找到'}`);
          console.log(`[計算系統] 📊 前次遊戲時間: ${previousTime || '未找到'}`);
          console.log(`[計算系統] 📊 當前遊戲天數: ${currentDay || '未找到'}`);
          console.log(`[計算系統] 📊 前次遊戲天數: ${previousDay || '未找到'}`);
          
          if (currentTime && previousTime) {
            const currMin = h(currentTime);
            const prevMin = h(previousTime);
            console.log(`[計算系統] ⏱️ 時間差: ${prevMin !== null && currMin !== null ? Math.abs(currMin - prevMin) : '無法計算'}分鐘`);
          }
        }
      } catch (error) {
        console.log('[計算系統] ⚠️ 無法獲取當前遊戲狀態');
      }
    }
  };

  // ==================== 事件監聽器 ====================
  if (!window._wildernessEventListenersAdded) {
    $(async () => {
      try {
        await waitGlobalInitialized('Mvu');
      } catch (t) {
        return void errorLog('[荒野求生腳本] Mvu 初始化失敗', t);
      }
      
      if (Mvu && Mvu.events) {
        if (!window._wildernessEventListenersAdded) {
          infoLog('綁定荒野求生整合腳本事件監聽器');
          
          eventOn(Mvu.events.VARIABLE_UPDATE_STARTED, async (t) => {
            if (p) b = null;
            else {
              try {
                const e = t.stat_data ?? {};
                b = {
                  timestamp: Date.now(),
                  previousMissionRoot: a().get(e, '任務'),
                  previousMission: a().get(e, '任務.緊急'),
                  previousDay: a().get(e, '系統.經過天數'),
                  previousTime: a().get(e, '系統.當前時間'),
                  previousHpMax: a().get(e, '核心狀態.生命值上限'),
                  previousHpCurrent: a().get(e, '核心狀態.當前生命值'),
                  previousSpMax: a().get(e, '核心狀態.精神值上限'),
                  previousSpCurrent: a().get(e, '核心狀態.當前精神值')
                };
                
                if (window._timeSystem) {
                  await window._timeSystem.initializeTimePaths(t);
                }
              } catch (error) {
                errorLog('[荒野求生腳本] 初始化時間路徑失敗', error);
                b = null;
              }
            }
          });
          
          eventOn(Mvu.events.VARIABLE_UPDATE_ENDED, async (t) => {
            if (p) return (p = !1), void (b = null);
            
            try {
              let e = !1;
              
              // 檢查任務路徑完整性
              const n = a().get(t.stat_data, '任務');
              if (!a().isPlainObject(n)) {
                const n = {};
                await Mvu.setMvuVariable(t, '任務', n, { reason: '自動維護任務路徑' });
                a().set(t.stat_data, '任務', n);
                e = !0;
              }
              
              const i = ['主線', '支線', '緊急', '日常', '羈絆'];
              for (const r of i) {
                const o = `任務.${r}`;
                let c = a().get(t.stat_data, o);
                if (!a().isPlainObject(c)) {
                  c = {};
                  await Mvu.setMvuVariable(t, o, c, { reason: '自動維護任務路徑' });
                  a().set(t.stat_data, o, c);
                  e = !0;
                }
                
                if ('羈絆' === r) {
                  const n = a().get(t.stat_data, '同伴');
                  if (a().isPlainObject(n)) {
                    for (const [i, r] of Object.entries(n)) {
                      if (i.startsWith('$')) continue;
                      const o = `任務.羈絆.${i}`;
                      let c = a().get(t.stat_data, o);
                      if (!a().isPlainObject(c)) {
                        const n = {};
                        await Mvu.setMvuVariable(t, o, n, { reason: '自動維護任務路徑' });
                        a().set(t.stat_data, o, n);
                        e = !0;
                      }
                    }
                  }
                }
              }
              
              // 統一處理所有系統
              await unifiedProcessAll(t) && (e = !0);
              
              // 如果需要，刷新數據
              e && ((p = !0), await Mvu.replaceMvuData(t, { type: 'message', message_id: 'latest' }));
              
            } catch (error) {
              errorLog('[荒野求生腳本] 處理更新時出錯', error);
            } finally {
              b = null;
            }
          });
          
          window._wildernessEventListenersAdded = true;
          infoLog('荒野求生整合腳本事件監聽器綁定完成');
          infoLog('✅ 雙時間防作弊系統已啟用');
          infoLog('✅ 畜牧繁殖系統已啟用');
          infoLog('✅ 作物生長系統已啟用');
          infoLog('✅ 任務保護系統已啟用');
          infoLog('✅ 狀態效果系統已啟用');
          
        } else {
          warnLog('荒野求生腳本事件監聽器已綁定，跳過重複綁定');
        }
      }
    });
  }
  
  infoLog('荒野求生整合腳本載入完成');
  infoLog('調試模式:', DEBUG_MODE ? '✅ 開啟' : '❌ 關閉');
  infoLog('畜牧系統: ✅ 已整合（含繁殖、分娩、數量管理）');
  infoLog('作物系統: ✅ 已載入');
  infoLog('雙時間系統: ✅ 已啟用（使用時間回退跨日邏輯）');
  infoLog('任務系統: ✅ 已整合（含保護和自動處理）');
  infoLog('狀態效果: ✅ 已載入');
}