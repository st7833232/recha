  // ==================== 創建全局時間系統實例 ====================
  window._timeSystem = new DualTimeSystem();
  
  // ==================== 時間處理函數 ====================
function h(t) {
  if ('string' != typeof t) return null;
  const e = /^(\d{1,2}):(\d{2})$/.exec(t.trim());
  if (!e) return null;
  const a = Number(e[1]),
    n = Number(e[2]);
  return Number.isFinite(a) && Number.isFinite(n) ? a < 0 || a > 23 || n < 0 || n > 59 ? null : 60 * a + n : null;
}

function mM(t) {
  if ('string' != typeof t) return null;
  const e = /第(\d+)天\s+(\d{1,2}):(\d{2})/.exec(t);
  if (!e) return null;
  const a = Number(e[1]),
    n = Number(e[2]),
    i = Number(e[3]);
  return Number.isFinite(a) && Number.isFinite(n) && Number.isFinite(i) ? {
    day: a,
    hour: n,
    minute: i,
    totalMinutes: a * 1440 + n * 60 + i
  } : null;
}

function mg(t) {
  const e = a().get(t, '系統.經過天數'),
    n = a().get(t, '系統.當前時間');
  if (!Number.isFinite(e) || 'string' != typeof n) return null;
  const i = h(n);
  return null === i ? null : {
    day: e,
    hour: Math.floor(i / 60),
    minute: i % 60,
    totalMinutes: e * 1440 + i
  };
}

function v(t, e = 0) {
  if ('number' == typeof t && Number.isFinite(t)) return t;
  const a = Number(t);
  return Number.isFinite(a) ? a : e;
}

  function M(t, e) {
    for (const n of e)
      if (a().has(t, n)) return n;
    return e.length > 0 ? e[0] : null;
  }

  function g(t, e, a) {
    if ('number' != typeof a || !Number.isFinite(a)) return null;
    if (a <= 0) return 0;
    let n = 'number' == typeof t ? t : Number(t);
    Number.isFinite(n) || (n = 0);
    const i = 'number' == typeof e ? e : Number(e);
    if (!Number.isFinite(i) || i <= 0) {
      const t = Math.round(Math.min(a, Math.max(0, n)));
      return Number.isFinite(t) ? t : 0;
    }
    const r = (n / i) * a;
    if (!Number.isFinite(r)) return 0;
    const u = Math.round(r);
    return Math.max(0, Math.min(a, u));
  }

  // ==================== 時間相同檢測與修正函數 ====================
  function normalizeTime(timeString) {
    if (typeof timeString !== 'string') return null;
    
    const trimmed = timeString.trim();
    const match = trimmed.match(/^(\d{1,2}):(\d{1,2})$/);
    if (!match) return null;
    
    const hours = parseInt(match[1], 10);
    const minutes = parseInt(match[2], 10);
    
    if (hours < 0 || hours > 23 || minutes < 0 || minutes > 59) {
      return null;
    }
    
    return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}`;
  }

  function isTimeSame(time1, time2) {
    if (!time1 || !time2) return false;
    
    const norm1 = normalizeTime(time1);
    const norm2 = normalizeTime(time2);
    
    if (!norm1 || !norm2) return false;
    return norm1 === norm2;
  }

  function addOneMinute(timeString) {
    const normalized = normalizeTime(timeString);
    if (!normalized) return '00:01';
    
    const [hoursStr, minutesStr] = normalized.split(':');
    let hours = parseInt(hoursStr, 10);
    let minutes = parseInt(minutesStr, 10);
    
    minutes += 1;
    
    if (minutes >= 60) {
      minutes = minutes % 60;
      hours += 1;
    }
    
    if (hours >= 24) {
      hours = hours % 24;
    }
    
    return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}`;
  }

  function fixRepeatedTime(currentTime, previousTime) {
    const normalizedCurrent = normalizeTime(currentTime);
    if (normalizedCurrent === '00:00') {
      debugLog('檢測到00:00時間，自動修正為00:05');
      return '00:05';
    }
    
    if (previousTime && isTimeSame(currentTime, previousTime)) {
      const newTime = addOneMinute(currentTime);
      debugLog(`檢測到重複時間：${previousTime} → ${currentTime}，自動+1分鐘：${newTime}`);
      return newTime;
    }
    
    return currentTime;
  }

  // ==================== 分鐘數轉時間格式 ====================
  function formatMinutesToTime(minutes) {
    if (minutes === null || minutes === undefined) return '未知';
    const hours = Math.floor(minutes / 60);
    const mins = minutes % 60;
    return `${hours.toString().padStart(2, '0')}:${mins.toString().padStart(2, '0')}`;
  }

  // ==================== 通用函數 ====================
async function d(t, e, i) {
  const r = a().get(t.stat_data, e);
  
  let valueToSet = i;
  if (typeof r === 'number' || e.includes('日期') || e.includes('天數') || e.includes('週期')) {
    valueToSet = Number(i);
  } else if (typeof r === 'string' || e.includes('階段') || e.includes('狀態')) {
    valueToSet = String(i);
  } else if (typeof r === 'boolean' || e.includes('已') || e.includes('是否')) {
    valueToSet = Boolean(i);
  }
  
  if (Number.isFinite(r) && Number.isFinite(valueToSet) && r === valueToSet) return !1;
  
  try {
    const u = await Mvu.setMvuVariable(t, e, valueToSet, { reason: n });
    return u && a().set(t.stat_data, e, valueToSet), u;
  } catch (error) {
    errorLog(`設置變量失敗 ${e}:`, error);
    return false;
  }
}

  async function x(t, e) {
    const i = a().get(t.stat_data, e);
    if (!a().isPlainObject(i)) return !1;
    let r = !1;
    for (const [u, s] of Object.entries(i)) {
      if (u.startsWith('$')) continue;
      if (!a().isPlainObject(s)) continue;
      const i = `${e}.${u}.等級`,
        o = `${e}.${u}.${m}`,
        c = `${e}.${u}.${l}`;
      let f = v(a().get(s, '等級'), 0),
        p = v(a().get(s, m), 0);
      const b = e.includes('屬性') ? 10 : 100,
        h = t => Math.max(1, Math.floor(t) * b);
      let M = !1,
        g = 0;
      for (;;) {
        const t = h(f);
        if (!(p >= t)) break;
        if ((p -= t), f += 1, (M = !0), (g += 1), g > 1e3) break;
      }
      const d = h(f);
M && (await Mvu.setMvuVariable(t, i, Number(f), { reason: n })) && (a().set(t.stat_data, i, f), (r = !0)),
p !== v(a().get(s, m), 0) &&
  (await Mvu.setMvuVariable(t, o, Number(p), { reason: n })) &&
  (a().set(t.stat_data, o, p), (r = !0)),
d !== v(a().get(s, l), NaN) &&
  (await Mvu.setMvuVariable(t, c, Number(d), { reason: n })) &&
  (a().set(t.stat_data, c, d), (r = !0));
    }
    return r;
  }

  // ==================== 季節系統 ====================
  const SEASON_GROWTH_BONUS = {
    '春季': 15,
    '夏季': 20,
    '秋季': 0,
    '冬季': -50
  };

  function getSeasonGrowthBonus(season) {
    if (!season) return 0;
    return SEASON_GROWTH_BONUS[season] || 0;
  }

  function extractCropBonusFromObject(obj) {
    if (!obj || typeof obj !== 'object') return 0;
    
    let totalBonus = 0;
    
    if (obj['作物加成'] !== undefined) {
      const bonus = Number(obj['作物加成']);
      if (!isNaN(bonus) && bonus > 0) {
        totalBonus += bonus;
        if (DEBUG_MODE) {
          debugLog('提取到作物加成:', bonus, '%');
        }
      }
    }
    
    return totalBonus;
  }

  function extractCropBonusFromCarriedItems(items) {
    if (!a().isPlainObject(items)) return 0;
    
    let totalBonus = 0;
    
    for (const [itemName, itemData] of Object.entries(items)) {
      if (itemName.startsWith('$') || !a().isPlainObject(itemData)) continue;
      totalBonus += extractCropBonusFromObject(itemData);
    }
    
    return totalBonus;
  }

  function extractCropBonusFromCompanionItems(companions) {
    if (!a().isPlainObject(companions)) return 0;
    
    let totalBonus = 0;
    
    for (const [companionName, companionData] of Object.entries(companions)) {
      if (companionName.startsWith('$') || !a().isPlainObject(companionData)) continue;
      
      const companionItems = a().get(companionData, '攜帶物品');
      if (a().isPlainObject(companionItems)) {
        totalBonus += extractCropBonusFromCarriedItems(companionItems);
      }
    }
    
    return totalBonus;
  }

  async function calculateActualGrowthDays(t, cropName, baseGrowthDays) {
    const e = t.stat_data ?? {};
    let totalPercentageBonus = 0;
    
    if (DEBUG_MODE) {
      debugLog('計算', cropName, '生長加成 (基礎:', baseGrowthDays, '天)');
    }
    
    const currentSeason = a().get(e, '環境.季節');
    const seasonBonus = getSeasonGrowthBonus(currentSeason);
    totalPercentageBonus += seasonBonus;
    
    if (DEBUG_MODE) {
      debugLog('季節加成 (', currentSeason, '):', seasonBonus, '%');
    }
    
    const crops = a().get(e, '作物');
    if (a().isPlainObject(crops)) {
      for (const [otherCropName, otherCropData] of Object.entries(crops)) {
        if (otherCropName.startsWith('$') || !a().isPlainObject(otherCropData) || otherCropName === cropName) continue;
        
        const cropBonus = extractCropBonusFromObject(otherCropData);
        if (cropBonus > 0) {
          totalPercentageBonus += cropBonus;
          if (DEBUG_MODE) {
            debugLog(otherCropName, '全局作物加成:', cropBonus, '%');
          }
        }
      }
    }
    
    const companions = a().get(e, '同伴');
    const companionBonus = extractCropBonusFromCompanionItems(companions);
    if (companionBonus > 0) {
      totalPercentageBonus += companionBonus;
      if (DEBUG_MODE) {
        debugLog('同伴攜帶物品作物加成:', companionBonus, '%');
      }
    }
    
    if (DEBUG_MODE) {
      debugLog(cropName, '總加成:', totalPercentageBonus, '%');
    }
    
    let actualGrowthDays;
    
    if (totalPercentageBonus <= 0) {
      actualGrowthDays = baseGrowthDays;
      if (DEBUG_MODE) {
        debugLog(cropName, '實際生長天數:', actualGrowthDays, '天 (無加成)');
      }
    } else if (totalPercentageBonus <= 50) {
      const reducedDays = Math.floor(baseGrowthDays * (totalPercentageBonus / 100));
      actualGrowthDays = Math.max(1, baseGrowthDays - reducedDays);
      if (DEBUG_MODE) {
        debugLog(cropName, '實際生長天數:', actualGrowthDays, '天 (減少', reducedDays, '天)');
      }
    } else {
      const growthMultiplier = 1 + (totalPercentageBonus / 100);
      actualGrowthDays = Math.max(1, Math.floor(baseGrowthDays / growthMultiplier));
      const reducedDays = baseGrowthDays - actualGrowthDays;
      if (DEBUG_MODE) {
        debugLog(cropName, '實際生長天數:', actualGrowthDays, '天 (除以', growthMultiplier.toFixed(2), ', 減少', reducedDays, '天)');
      }
    }
    
    return actualGrowthDays;
  }

function calculateGrowthStage(cropData, currentDay, actualGrowthDays) {
  const plantedDay = v(cropData.種植日期, 0);
  const growthCycle = v(cropData.成長週期, 0);
   
  const hasBonus = extractCropBonusFromObject(cropData) > 0;
  const isSpecialCrop = growthCycle < 0 || hasBonus;
  
  const growthDays = currentDay - plantedDay;
  
  if (isSpecialCrop) {
    return '特殊作物';
  }
  
  const growthProgress = Math.min(100, Math.round((growthDays / actualGrowthDays) * 100));
  
  if (growthProgress < 30) {
    return '幼苗期';
  } else if (growthProgress < 60) {
    return '生長期';
  } else if (growthProgress < 100) {
    return '熟成期';
  } else {
    return '可收割';
  }
}

  async function updateCropGrowthStages(t) {
    let updated = false;
    const e = t.stat_data ?? {};
    const currentDay = v(a().get(e, '系統.經過天數'), 0);
    const currentSeason = a().get(e, '環境.季節');
    const crops = a().get(e, '作物');
    
    if (DEBUG_MODE) {
      debugLog('更新作物生長階段 - 當前天數:', currentDay, ', 季節:', currentSeason);
    }
    
    if (!a().isPlainObject(crops)) {
      if (DEBUG_MODE) {
        debugLog('沒有找到作物數據');
      }
      return false;
    }
    
    for (const [cropName, cropData] of Object.entries(crops)) {
      if (cropName.startsWith('$')) continue;
      if (!a().isPlainObject(cropData)) continue;
      
      const growthCycle = v(cropData.成長週期, 0);
      const plantedDay = v(cropData.種植日期, 0);
      
      if (plantedDay <= 0) {
        if (DEBUG_MODE) {
          debugLog(cropName, ': 未種植');
        }
        continue;
      }
      
      const growthDays = currentDay - plantedDay;
      if (DEBUG_MODE) {
        debugLog(cropName, ': 種植第', growthDays, '天 (種植日:', plantedDay, ')');
      }
      
      let actualGrowthDays = Math.abs(growthCycle);
      
      if (growthCycle > 0) {
        actualGrowthDays = await calculateActualGrowthDays(t, cropName, growthCycle);
      }
      
      const currentStage = calculateGrowthStage(cropData, currentDay, actualGrowthDays);
      const stagePath = `作物.${cropName}.生長階段`;
      const currentStageInData = a().get(e, stagePath);

      if (growthCycle > 0 && plantedDay > 0) {
        const maturityDay = plantedDay + actualGrowthDays;
        const harvestDatePath = `作物.${cropName}.收成日期`;
        
        const currentHarvestDate = a().get(e, harvestDatePath);
        if (currentHarvestDate !== maturityDay) {
          if (DEBUG_MODE) {
            debugLog(cropName, ': 舊收成日', currentHarvestDate, '-> 新收成日', maturityDay);
          }
          await Mvu.setMvuVariable(t, harvestDatePath, Number(maturityDay), { reason: '修正收成日期' });
          a().set(e, harvestDatePath, maturityDay);
          updated = true;
        }
      }

      if (currentStage !== currentStageInData) {
        if (DEBUG_MODE) {
          debugLog(cropName, ':', currentStageInData || '無', '->', currentStage);
        }
        await Mvu.setMvuVariable(t, stagePath, String(currentStage), { reason: '作物生長階段更新' });
        a().set(e, stagePath, currentStage);
        updated = true;
        
        if (currentStage === '可收割' && !a().get(e, `作物.${cropName}.已成熟`)) {
          await Mvu.setMvuVariable(t, `作物.${cropName}.已成熟`, true, { reason: '作物成熟標記' });
          a().set(e, `作物.${cropName}.已成熟`, true);
        }
      }
    }
    
    return updated;
  }

  window._checkCropGrowth = async function(t) {
    let updated = false;
    updated = (await updateCropGrowthStages(t)) || updated;
    return updated;
  };

  // ==================== 畜牧系統配置 ====================
  const LIVESTOCK_CONFIG = {
    // 生長階段對應年齡（月）
    GROWTH_STAGES: {
        '幼年期': { minAge: 0, maxAge: 3, canBreed: false },     // 0-3個月
        '成長期': { minAge: 3, maxAge: 12, canBreed: false },    // 3-12個月  
        '成年期': { minAge: 12, maxAge: 72, canBreed: true },    // 1-6年
        '老年期': { minAge: 72, maxAge: 999, canBreed: false }   // 6年以後
    },
    
    // 畜牧類型基準壽命（月）
    LIFESPAN: {
        '野雞': 60,      // 5年
        '野山羊': 120,   // 10年
        '馬鹿': 180,     // 15年
        '野兔': 84       // 7年
    },
    
    // 季節生產效率調節
    SEASON_PRODUCTION_BONUS: {
        '春季': 10,   // +10% 生產效率
        '夏季': 5,    // +5% 生產效率
        '秋季': 0,    // 無影響
        '冬季': -20   // -20% 生產效率
    },
    
    // 繁殖配置
    BREEDING_CONFIG: {
        // 基本繁殖機率（每月檢查時）
        BASE_BREEDING_CHANCE: 0.25, // 25%機率觸發繁殖
        
        // 最小繁殖年齡（月）
        MIN_BREEDING_AGE: 12,
        
        // 繁殖冷卻時間（天）
        BREEDING_COOLDOWN: {
            '野雞': 30,
            '野山羊': 45,
            '馬鹿': 60,
            '野兔': 20
        },
        
        // 性別比例（新出生幼崽）
        GENDER_RATIO: {
            male: 0.48,  // 48%雄性
            female: 0.52  // 52%雌性
        }
    }
  };

  // ==================== 畜牧工具函數 ====================
  // 骰子公式解析器（如 "1d4" = 1-4）
  function rollDice(diceFormula) {
    if (!diceFormula || typeof diceFormula !== 'string') return 0;
    
    const match = diceFormula.match(/^(\d+)d(\d+)$/);
    if (!match) {
      // 嘗試解析為數字
      const num = parseInt(diceFormula);
      return isNaN(num) ? 0 : num;
    }
    
    const count = parseInt(match[1]);
    const sides = parseInt(match[2]);
    
    if (isNaN(count) || isNaN(sides) || count <= 0 || sides <= 0) return 0;
    
    let total = 0;
    for (let i = 0; i < count; i++) {
      total += Math.floor(Math.random() * sides) + 1;
    }
    
    return total;
  }

  // 隨機性別生成
  function generateRandomGender() {
    return Math.random() < LIVESTOCK_CONFIG.BREEDING_CONFIG.GENDER_RATIO.male ? '雄性' : '雌性';
  }

  // 畜牧生長階段計算
  function calculateLivestockGrowthStage(animalData) {
    if (!animalData || animalData.年齡 === undefined || animalData.年齡 === null) {
        return '未知';
    }
    
    const ageInMonths = Number(animalData.年齡);
    if (isNaN(ageInMonths)) return '未知';
    
    const stages = LIVESTOCK_CONFIG.GROWTH_STAGES;
    
    for (const [stage, config] of Object.entries(stages)) {
        if (ageInMonths >= config.minAge && ageInMonths < config.maxAge) {
            return stage;
        }
    }
    
    return '老年期';
  }

  // 計算實際生產週期
  async function calculateActualProductionCycle(t, animalName, baseCycle) {
    const e = t.stat_data ?? {};
    let totalBonus = 0;
    
    // 1. 季節影響
    const currentSeason = a().get(e, '環境.季節');
    const seasonBonus = LIVESTOCK_CONFIG.SEASON_PRODUCTION_BONUS[currentSeason] || 0;
    totalBonus += seasonBonus;
    
    if (DEBUG_MODE) {
        debugLog(animalName, '季節加成 (', currentSeason, '):', seasonBonus, '%');
    }
    
    // 2. 設施加成檢查
    const facilities = a().get(e, '營地.設施');
    if (a().isPlainObject(facilities)) {
        for (const [facilityName, facility] of Object.entries(facilities)) {
            if (facilityName.startsWith('$')) continue;
            
            if (facility.畜牧加成) {
                const bonus = Number(facility.畜牧加成);
                if (!isNaN(bonus) && bonus > 0) {
                    totalBonus += bonus;
                    if (DEBUG_MODE) {
                        debugLog(facilityName, '設施加成:', bonus, '%');
                    }
                }
            }
        }
    }
    
    if (DEBUG_MODE) {
        debugLog(animalName, '總加成:', totalBonus, '%');
    }
    
    // 計算實際生產週期
    if (totalBonus <= 0) {
        return baseCycle;
    }
    
    // 縮短生產週期（最多縮短50%）
    const maxReduction = 0.5;
    const reduction = Math.min(totalBonus / 100, maxReduction);
    const actualCycle = Math.max(1, Math.floor(baseCycle * (1 - reduction)));
    
    if (DEBUG_MODE) {
        debugLog(animalName, '實際生產週期:', actualCycle, '天 (減少', reduction*100, '%)');
    }
    
    return actualCycle;
  }

  // ==================== 畜牧繁殖系統 ====================
  // 檢查並處理繁殖
  async function checkAndProcessBreeding(t, currentDay, specificAnimal = null) {
    let updated = false;
    const e = t.stat_data ?? {};
    const livestockData = a().get(e, '畜牧');
    
    if (!a().isPlainObject(livestockData)) {
        return { success: false, message: '沒有畜牧數據', updated: false };
    }
    
    const animalsToProcess = specificAnimal ? 
        [[specificAnimal, livestockData[specificAnimal]]] : 
        Object.entries(livestockData);
    
    let bredAnimals = [];
    
    for (const [animalName, animalData] of animalsToProcess) {
        if (animalName.startsWith('$') || !a().isPlainObject(animalData)) continue;
        
        // 檢查繁殖條件
        const canBreed = await checkBreedingConditions(animalName, animalData, currentDay);
        
        if (canBreed.canBreed) {
            if (DEBUG_MODE) {
                debugLog('觸發繁殖:', animalName, canBreed.reason);
            }
            
            // 設置懷孕狀態
            const success = await setAnimalPregnant(t, animalName, animalData, currentDay);
            
            if (success) {
                updated = true;
                bredAnimals.push(animalName);
                
                if (DEBUG_MODE) {
                    debugLog(animalName, '成功懷孕，預計分娩日:', 
                        currentDay + (animalData.繁殖?.懷孕週期 || 0));
                }
            }
        } else if (DEBUG_MODE && specificAnimal) {
            debugLog(animalName, '無法繁殖:', canBreed.reason);
        }
    }
    
    return { 
        success: bredAnimals.length > 0, 
        message: bredAnimals.length > 0 ? 
            `成功觸發 ${bredAnimals.join(', ')} 的繁殖` : 
            '無動物符合繁殖條件',
        bredAnimals: bredAnimals,
        updated: updated
    };
  }

  // 檢查繁殖條件
  async function checkBreedingConditions(animalName, animalData, currentDay) {
    // 1. 檢查是否存在繁殖配置
    if (!animalData.繁殖 || !animalData.繁殖.可繁殖) {
        return { canBreed: false, reason: '無繁殖配置或不可繁殖' };
    }
    
    // 2. 檢查生長階段
    const growthStage = calculateLivestockGrowthStage(animalData);
    const stageConfig = LIVESTOCK_CONFIG.GROWTH_STAGES[growthStage];
    if (!stageConfig || !stageConfig.canBreed) {
        return { canBreed: false, reason: `生長階段 ${growthStage} 無法繁殖` };
    }
    
    // 3. 檢查飼養數量
    const males = v(animalData.飼養數量?.雄性, 0);
    const females = v(animalData.飼養數量?.雌性, 0);
    if (males <= 0 || females <= 0) {
        return { canBreed: false, reason: '缺少雄性或雌性個體' };
    }
    
    // 4. 檢查是否已懷孕
    if (animalData.繁殖.懷孕中) {
        return { canBreed: false, reason: '已懷孕' };
    }
    
    // 5. 檢查繁殖冷卻
    const lastBreedingDay = v(animalData.繁殖.上次繁殖日, 0);
    const cooldown = LIVESTOCK_CONFIG.BREEDING_CONFIG.BREEDING_COOLDOWN[animalName] || 30;
    
    if (lastBreedingDay > 0 && (currentDay - lastBreedingDay) < cooldown) {
        const daysLeft = cooldown - (currentDay - lastBreedingDay);
        return { canBreed: false, reason: `繁殖冷卻中 (${daysLeft}天後)` };
    }
    
    // 6. 隨機機率檢查
    const breedingChance = LIVESTOCK_CONFIG.BREEDING_CONFIG.BASE_BREEDING_CHANCE;
    if (Math.random() > breedingChance) {
        return { canBreed: false, reason: '隨機機率未觸發' };
    }
    
    return { canBreed: true, reason: '符合所有繁殖條件' };
  }

  // 設置動物懷孕
  async function setAnimalPregnant(t, animalName, animalData, currentDay) {
    try {
        // 更新繁殖狀態
        await d(t, `畜牧.${animalName}.繁殖.懷孕中`, true, { 
            reason: `畜牧 ${animalName} 開始懷孕` 
        });
        
        await d(t, `畜牧.${animalName}.繁殖.上次繁殖日`, currentDay, { 
            reason: '更新繁殖日期' 
        });
        
        // 更新本地數據
        const e = t.stat_data ?? {};
        a().set(e, `畜牧.${animalName}.繁殖.懷孕中`, true);
        a().set(e, `畜牧.${animalName}.繁殖.上次繁殖日`, currentDay);
        
        return true;
    } catch (error) {
        errorLog(`設置 ${animalName} 懷孕失敗:`, error);
        return false;
    }
  }

  // ==================== 畜牧分娩系統 ====================
  // 檢查並處理分娩
  async function checkAndProcessBirth(t, currentDay, specificAnimal = null) {
    let updated = false;
    const e = t.stat_data ?? {};
    const livestockData = a().get(e, '畜牧');
    
    if (!a().isPlainObject(livestockData)) {
        return { success: false, message: '沒有畜牧數據', updated: false };
    }
    
    const animalsToProcess = specificAnimal ? 
        [[specificAnimal, livestockData[specificAnimal]]] : 
        Object.entries(livestockData);
    
    let birthedAnimals = [];
    
    for (const [animalName, animalData] of animalsToProcess) {
        if (animalName.startsWith('$') || !a().isPlainObject(animalData)) continue;
        
        // 檢查分娩條件
        const canGiveBirth = await checkBirthConditions(animalName, animalData, currentDay);
        
        if (canGiveBirth.canGiveBirth) {
            if (DEBUG_MODE) {
                debugLog('觸發分娩:', animalName, canGiveBirth.reason);
            }
            
            // 執行分娩
            const birthResult = await processAnimalBirth(t, animalName, animalData, currentDay);
            
            if (birthResult.success) {
                updated = true;
                birthedAnimals.push({
                    name: animalName,
                    offspring: birthResult.offspring
                });
                
                if (DEBUG_MODE) {
                    debugLog(animalName, '成功分娩，新增:', 
                        `雄${birthResult.offspring.males} 雌${birthResult.offspring.females}`);
                }
            }
        } else if (DEBUG_MODE && specificAnimal) {
            debugLog(animalName, '無法分娩:', canGiveBirth.reason);
        }
    }
    
    return { 
        success: birthedAnimals.length > 0, 
        message: birthedAnimals.length > 0 ? 
            `成功處理 ${birthedAnimals.map(a => a.name).join(', ')} 的分娩` : 
            '無動物需要分娩',
        birthedAnimals: birthedAnimals,
        updated: updated
    };
  }

  // 檢查分娩條件
  async function checkBirthConditions(animalName, animalData, currentDay) {
    // 1. 檢查是否懷孕
    if (!animalData.繁殖?.懷孕中) {
        return { canGiveBirth: false, reason: '未懷孕' };
    }
    
    // 2. 檢查懷孕週期
    const lastBreedingDay = v(animalData.繁殖.上次繁殖日, 0);
    const pregnancyCycle = v(animalData.繁殖.懷孕週期, 0);
    
    if (lastBreedingDay <= 0 || pregnancyCycle <= 0) {
        return { canGiveBirth: false, reason: '繁殖數據不完整' };
    }
    
    // 3. 檢查是否到期
    const dueDay = lastBreedingDay + pregnancyCycle;
    if (currentDay < dueDay) {
        const daysLeft = dueDay - currentDay;
        return { canGiveBirth: false, reason: `還需 ${daysLeft} 天` };
    }
    
    return { canGiveBirth: true, reason: '懷孕到期，需要分娩' };
  }

  // 處理動物分娩
  async function processAnimalBirth(t, animalName, animalData, currentDay) {
    try {
        // 計算幼崽數量
        const litterSizeFormula = animalData.繁殖?.每胎數量 || '1d2';
        const totalOffspring = rollDice(litterSizeFormula);
        
        if (totalOffspring <= 0) {
            warnLog(animalName, '分娩產出為0或負數，使用默認值1');
            totalOffspring = 1;
        }
        
        // 分配性別
        let males = 0;
        let females = 0;
        
        for (let i = 0; i < totalOffspring; i++) {
            if (generateRandomGender() === '雄性') {
                males++;
            } else {
                females++;
            }
        }
        
        // 獲取當前飼養數量
        const currentMales = v(animalData.飼養數量?.雄性, 0);
        const currentFemales = v(animalData.飼養數量?.雌性, 0);
        
        // 計算新數量
        const newMales = currentMales + males;
        const newFemales = currentFemales + females;
        
        // 更新飼養數量
        await d(t, `畜牧.${animalName}.飼養數量.雄性`, newMales, { 
            reason: `畜牧 ${animalName} 分娩新增雄性後代` 
        });
        
        await d(t, `畜牧.${animalName}.飼養數量.雌性`, newFemales, { 
            reason: `畜牧 ${animalName} 分娩新增雌性後代` 
        });
        
        // 重置懷孕狀態
        await d(t, `畜牧.${animalName}.繁殖.懷孕中`, false, { 
            reason: '分娩完成' 
        });
        
        // 更新本地數據
        const e = t.stat_data ?? {};
        a().set(e, `畜牧.${animalName}.飼養數量.雄性`, newMales);
        a().set(e, `畜牧.${animalName}.飼養數量.雌性`, newFemales);
        a().set(e, `畜牧.${animalName}.繁殖.懷孕中`, false);
        
        // 記錄分娩歷史
        const birthHistory = animalData.繁殖?.分娩歷史 || [];
        birthHistory.push({
            日期: currentDay,
            數量: totalOffspring,
            雄性: males,
            雌性: females
        });
        
        // 保留最近10次記錄
        if (birthHistory.length > 10) {
            birthHistory.shift();
        }
        
        await d(t, `畜牧.${animalName}.繁殖.分娩歷史`, birthHistory, { 
            reason: '更新分娩歷史' 
        });
        a().set(e, `畜牧.${animalName}.繁殖.分娩歷史`, birthHistory);
        
        return {
            success: true,
            offspring: {
                total: totalOffspring,
                males: males,
                females: females
            },
            newCount: {
                males: newMales,
                females: newFemales
            }
        };
        
    } catch (error) {
        errorLog(`處理 ${animalName} 分娩失敗:`, error);
        return { success: false, error: error.message };
    }
  }

  // ==================== 畜牧狀態更新系統 ====================
  // 更新畜牧狀態
  async function updateLivestockStates(t) {
    let updated = false;
    const e = t.stat_data ?? {};
    const currentDay = v(a().get(e, '系統.經過天數'), 0);
    const livestockData = a().get(e, '畜牧');
    
    if (!a().isPlainObject(livestockData)) {
        if (DEBUG_MODE) {
            debugLog('沒有找到畜牧數據');
        }
        return false;
    }
    
    if (DEBUG_MODE) {
        debugLog('更新畜牧狀態 - 當前天數:', currentDay);
    }
    
    for (const [animalName, animalData] of Object.entries(livestockData)) {
        if (animalName.startsWith('$')) continue;
        if (!a().isPlainObject(animalData)) continue;
        
        let animalUpdated = false;
        
        // 1. 更新生長階段
        const currentStage = calculateLivestockGrowthStage(animalData);
        const stagePath = `畜牧.${animalName}.生長階段`;
        const currentStageInData = a().get(e, stagePath);
        
        if (currentStage !== currentStageInData) {
            if (DEBUG_MODE) {
                debugLog(animalName, ':', currentStageInData || '無', '->', currentStage);
            }
            await d(t, stagePath, String(currentStage), { reason: '畜牧生長階段更新' });
            a().set(e, stagePath, currentStage);
            animalUpdated = true;
        }
        
        // 2. 更新年齡（每30遊戲天增加1個月）
        const startDay = v(animalData.飼養開始日, 0);
        if (startDay > 0) {
            const daysPassed = Math.max(0, currentDay - startDay);
            const ageInMonths = Math.floor(daysPassed / 30);
            
            if (ageInMonths !== v(animalData.年齡, 0)) {
                if (DEBUG_MODE) {
                    debugLog(animalName, '年齡更新:', animalData.年齡, '->', ageInMonths, '個月');
                }
                await d(t, `畜牧.${animalName}.年齡`, ageInMonths, { reason: '畜牧年齡更新' });
                a().set(e, `畜牧.${animalName}.年齡`, ageInMonths);
                animalUpdated = true;
            }
        }
        
        // 3. 處理產出物週期更新
        if (animalData.產出物 && animalData.產出物.週期) {
            const baseCycle = v(animalData.產出物.週期, 0);
            if (baseCycle > 0) {
                const actualCycle = await calculateActualProductionCycle(t, animalName, baseCycle);
                
                // 更新下次產出日
                let nextProductionDay = v(animalData.產出物.下次產出日, 0);
                const startDay = v(animalData.飼養開始日, 0);
                
                if (nextProductionDay <= 0 && startDay > 0) {
                    // 初始化下次產出日
                    nextProductionDay = startDay + actualCycle;
                    animalUpdated = true;
                } else if (currentDay >= nextProductionDay) {
                    // 已過產出日，計算下一個
                    const cyclesPassed = Math.floor((currentDay - nextProductionDay) / actualCycle) + 1;
                    nextProductionDay += cyclesPassed * actualCycle;
                    
                    if (DEBUG_MODE) {
                        debugLog(animalName, '需要產出，下次產出日更新:', nextProductionDay);
                    }
                    animalUpdated = true;
                }
                
                // 更新下次產出日
                const nextProdPath = `畜牧.${animalName}.產出物.下次產出日`;
                if (nextProductionDay !== v(animalData.產出物.下次產出日, 0)) {
                    await d(t, nextProdPath, nextProductionDay, { reason: '畜牧產出日更新' });
                    a().set(e, nextProdPath, nextProductionDay);
                    animalUpdated = true;
                }
                
                // 更新實際週期（如果不同）
                if (actualCycle !== baseCycle) {
                    const cyclePath = `畜牧.${animalName}.產出物.週期`;
                    await d(t, cyclePath, actualCycle, { reason: '畜牧實際生產週期更新' });
                    a().set(e, cyclePath, actualCycle);
                    animalUpdated = true;
                }
            }
        }
        
        // 4. 處理繁殖檢查（每月檢查一次）
        const ageInMonths = v(animalData.年齡, 0);
        if (ageInMonths > 0 && ageInMonths % 1 === 0) { // 每月檢查一次
            const breedingResult = await checkAndProcessBreeding(t, currentDay, animalName);
            if (breedingResult.updated) {
                animalUpdated = true;
            }
        }
        
        // 5. 處理分娩檢查
        const birthResult = await checkAndProcessBirth(t, currentDay, animalName);
        if (birthResult.updated) {
            animalUpdated = true;
        }
        
        if (animalUpdated) {
            updated = true;
        }
    }
    
    return updated;
  }

  // ==================== 畜牧系統主入口 ====================
  window._checkLivestockGrowth = async function(t) {
    let updated = false;
    
    try {
        updated = (await updateLivestockStates(t)) || updated;
    } catch (error) {
        errorLog('畜牧更新失敗:', error);
    }
    
    return updated;
  };

  // ==================== 任務系統函數 (來自腳本2號，但使用1號的時間邏輯) ====================
  function checkReq(r){
    if(!a().isPlainObject(r))return r;
    if('number'==typeof r.進度&&'number'==typeof r.目標){
      if(r.進度>=r.目標&&!r.已完成)return r.已完成=!0,r;
      if(r.進度<r.目標&&r.已完成)return r.已完成=!1,r
    }
    return r
  }

  async function updateTaskCompletion(t,path){
    const task=a().get(t.stat_data,path);
    if(!a().isPlainObject(task))return!1;
    let changed=!1;
    const baseReqs=a().get(task,'任務要求');
    if(a().isPlainObject(baseReqs)){
      let allBaseDone=!0;
      for(const[key,req]of Object.entries(baseReqs)){
        if(key.startsWith('$'))continue;
        const newReq=checkReq(req);
        if(newReq!==req){
          await Mvu.setMvuVariable(t,`${path}.任務要求.${key}`,newReq,{reason:'更新要求進度'}),
          a().set(t.stat_data,`${path}.任務要求.${key}`,newReq),changed=!0
        }
        !newReq.已完成&&(allBaseDone=!1)
      }
      const currentBaseDone=a().get(task,'完成情況.基礎要求完成');
      allBaseDone!==currentBaseDone&&(
        await Mvu.setMvuVariable(t,`${path}.完成情況.基礎要求完成`,allBaseDone,{reason:'更新基礎要求完成狀態'}),
        a().set(t.stat_data,`${path}.完成情況.基礎要求完成`,allBaseDone),changed=!0
      )
    }
    const advReqs=a().get(task,'進階目標');
    if(a().isPlainObject(advReqs)){
      let allAdvDone=!0;
      for(const[key,req]of Object.entries(advReqs)){
        if(key.startsWith('$'))continue;
        const newReq=checkReq(req);
        if(newReq!==req){
          await Mvu.setMvuVariable(t,`${path}.進階目標.${key}`,newReq,{reason:'更新進階要求進度'}),
          a().set(t.stat_data,`${path}.進階目標.${key}`,newReq),changed=!0
        }
        !newReq.已完成&&(allAdvDone=!1)
      }
      const currentAdvDone=a().get(task,'完成情況.進階目標完成');
