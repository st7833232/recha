// ==================== 系統配置 ====================
const DEBUG_MODE = false; // 設為 true 開啟詳細日誌，false 關閉詳細日誌

// ==================== 日誌系統 ====================
function debugLog(...args) {
    if (DEBUG_MODE) {
        console.log('[計算系統] 🔍', ...args);
    }
}

function infoLog(...args) {
    console.log('[計算系統] 📢', ...args);
}

function warnLog(...args) {
    console.warn('[計算系統] ⚠️', ...args);
}

function errorLog(...args) {
    console.error('[計算系統] ❌', ...args);
}

